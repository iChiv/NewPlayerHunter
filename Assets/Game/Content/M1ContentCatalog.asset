        english: 
      deck:
        chineseSimplified: "\u5F53\u4E00\u540D\u7403\u5458\u7684\u5E74\u9F84\u6210\u4E3A\u8C1C\u9898\uFF0C\u731C\u731C\u770B\u8C01\u5728\u4ED8\u5B66\u8D39\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u8DB3\u7403\u53F2\u4E0A\u7684\u5E74\u9F84\u8C1C\u9898\u5927\u81F4\u5206\u4E09\u7C7B\u3002\u7B2C\u4E00\u7C7B\u662F\u767B\u8BB0\u4E8B\u6545\uFF1A\u51FA\u751F\u5730\u5728\u54EA\uFF0C\u6863\u6848\u5C31\u5728\u54EA\uFF0C\u7EB8\u9762\u5E74\u9F84\u4E0E\u9AA8\u9ABC\u5E74\u9F84\u5404\u8BF4\u5404\u8BDD\u3002\u7B2C\u4E8C\u7C7B\u662F\u8425\u9500\u7B56\u7565\uFF1A\u5E74\u8F7B\u4E94\u5C81\uFF0C\u62A5\u4EF7\u7FFB\u4E00\u756A\uFF0C\u201C\u5E7D\u7075\u201D\u578B\u524D\u950B\u7684\u7ECF\u7EAA\u4EBA\u6700\u61C2\u8FD9\u4E2A\u6C47\u7387\u3002\u7B2C\u4E09\u7C7B\u662F\u81EA\u6211\u4FDD\u62A4\uFF1A\u8001\u5C06\u628A\u5E74\u9F84\u85CF\u8FDB\u8FF7\u96FE\uFF0C\u56E0\u4E3A\u5E02\u573A\u5BF9\u4E09\u5341\u4E94\u5C81\u4E4B\u540E\u7684\u6BCF\u4E00\u5C81\u90FD\u683C\u5916\u6B8B\u5FCD\u3002\u4E09\u79CD\u8C1C\u9898\u5BF9\u5E94\u4E09\u79CD\u6838\u67E5\uFF1A\u67E5\u6863\u6848\u3001\u67E5\u65E9\u5E74\u6BD4\u8D5B\u8BB0\u5F55\u3001\u67E5\u4F53\u6D4B\u4E0E\u9AA8\u5BC6\u5EA6\u62A5\u544A\u3002\u672C\u520A\u63D0\u9192\uFF1A\u201C\u4ECE\u4E0D\u8C08\u8FC7\u53BB\u201D\u672C\u8EAB\u4E0D\u662F\u7F6A\u8BC1\uFF0C\u4F46\u7EDD\u5BF9\u662F\u5C3D\u8C03\u6E05\u5355\u7684\u7B2C\u4E00\u884C\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4E0E\u5E7D\u7075\u76F8\u5BF9\u7684\uFF0C\u662F\u628A\u4E00\u5207\u5199\u5728\u8138\u4E0A\u7684\u538B\u8FEB\u72C2\u3002\u91CC\u5FB7\u4EEC\u7684\u903B\u8F91\u662F\u900F\u660E\u7684\uFF1A\u573A\u574718\u516C\u91CC\uFF0C\u538B\u8FEB\u6B21\u6570\u3001\u56DE\u8FFD\u8DDD\u79BB\uFF0C\u5168\u90E8\u53EF\u67E5\u53EF\u91CF\u3002\u8FD9\u7C7B\u7403\u5458\u7684\u98CE\u9669\u4E0D\u5728\u4FE1\u606F\uFF0C\u5728\u7ED3\u6784\u2014\u2014\u9AD8\u5F3A\u5EA6\u538B\u8FEB\u662F\u6D88\u8017\u54C1\uFF0C19\u5C81\u79BB\u5F00\u53C823\u5C81\u56DE\u6765\u7684\u4EBA\uFF0C\u8EAB\u4F53\u7684\u6298\u65E7\u66F2\u7EBF\u8981\u5355\u72EC\u753B\u3002\u672C\u5468\u70ED\u641C\u961F\u60F3\u8981\u201C\u4E0A\u65B0\u95FB\u7684\u4EBA\u201D\uFF0C\u672C\u520A\u53CD\u800C\u5EFA\u8BAE\u4ED6\u4EEC\u770B\u770B\u538B\u8FEB\u72C2\uFF1A18\u516C\u91CC\u8FD9\u4E2A\u6570\u5B57\uFF0C\u6BD4\u4EFB\u4F55\u70ED\u641C\u90FD\u66F4\u63A5\u8FD1\u8DB3\u7403\u672C\u8EAB\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u8C1C\u9898\u7559\u7ED9\u6863\u6848\u5BA4\uFF0C\u8DD1\u52A8\u7559\u7ED9\u8BA1\u6B65\u5668\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u5C3D\u8C03\u6E05\u5355"
        english: 
      sidebarBody:
        chineseSimplified: "\u6CE8\u518C\u6587\u4EF6\uFF1A\u5408\u89C4\uFF0C\u5DF2\u67E5\u3002\u65E9\u5E74\u8BB0\u5F55\uFF1A\u7F3A\u5931\u3002\u8EAB\u4F53\u62A5\u544A\uFF1A\u9700\u6388\u6743\u3002\u7ED3\u8BBA\uFF1A\u53EF\u7B7E\uFF0C\u4F46\u8BF7\u4E3A\u201C\u8C1C\u201D\u7559\u4E00\u4E2A\u6761\u6B3E\u3002"
