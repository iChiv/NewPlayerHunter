      headline:
        chineseSimplified: "\u5E93\u73C0\uFF1A\u80BA\u662F\u6EE1\u7684\uFF0C\u6280\u672F\u662F\u8D4A\u7684"
        english: 
      deck:
        chineseSimplified: "\u9A6C\u62C9\u677E\u7B2C56\u540D\u8D27\u771F\u4EF7\u5B9E\uFF0C\u95EE\u9898\u662F\u8DB3\u7403\u4E0D\u662F42\u516C\u91CC\u76F4\u9053\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u8DD1\u52A8\u80FD\u529B\u6709\u516C\u5F00\u7EAA\u5F55\u80CC\u4E66\uFF1A\u4F26\u6566\u9A6C\u62C9\u677E\u7B2C56\u540D\uFF0C\u4E0D\u662F\u201C\u636E\u8BF4\u5F88\u80FD\u8DD1\u201D\u3002\u653E\u5230\u7403\u573A\u4E0A\uFF0C\u8868\u73B0\u4E3A\u8986\u76D6\u9762\u79EF\u5927\u3001\u5F80\u8FD4\u4E0D\u77E5\u75B2\u5026\u3001\u6BD4\u8D5B\u672B\u6BB5\u5F3A\u5EA6\u4E0D\u964D\u300217\u5C81\u524D\u7684\u9752\u8BAD\u5E95\u5B50\u8FD8\u5728\uFF0C\u65E0\u7403\u8DD1\u52A8\u7684\u610F\u8BC6\u6BD4\u540C\u9F84\u4EBA\u6210\u719F\u3002\u804C\u4E1A\u6001\u5EA6\u4E0D\u7528\u6000\u7591\u2014\u2014\u88AB\u653E\u5F03\u540E\u81EA\u5DF1\u8DD1\u56DE\u6765\u7684\u4EBA\uFF0C\u81EA\u5F8B\u662F\u9ED8\u8BA4\u914D\u7F6E\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u6280\u672F\u73AF\u8282\u5168\u9762\u504F\u79D1\uFF1A\u4F20\u63A7\u7CBE\u5EA6\u4E00\u822C\uFF0C\u9AD8\u538B\u4E0B\u7684\u7B2C\u4E00\u811A\u89E6\u7403\u5BB9\u6613\u9732\u602F\uFF0C\u8FDB\u653B\u4E09\u533A\u51E0\u4E4E\u6CA1\u6709\u4EA7\u51FA\u3002\u88AB\u653E\u5F03\u540E\u7684\u6570\u5E74\u7A7A\u7A97\u610F\u5473\u7740\u6218\u672F\u7406\u89E3\u505C\u5728\u534A\u804C\u4E1A\u6C34\u5E73\uFF0C\u9700\u8981\u4ECE\u5934\u8865\u8BFE\u3002\u4ED6\u7684\u5B9A\u4F4D\u53EA\u80FD\u662F\u4F53\u7CFB\u91CC\u7684\u201C\u8DD1\u4EF6\u201D\uFF0C\u6307\u671B\u4ED6\u7EC4\u7EC7\u6216\u7EC8\u7ED3\u90FD\u662F\u8BEF\u8BCA\u3002\u5408\u540C\u53CB\u597D\uFF0C\u8010\u5FC3\u8981\u81EA\u5E26\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u9A6C\u62C9\u677E\u4E0D\u8003\u4F20\u63A7\uFF0C\u4F46\u804C\u4E1A\u8DB3\u7403\u8003\u3002"
