        english: 
      bodyLeft:
        chineseSimplified: "\u5F55\u50CF\u7B2C\u4E8C\u904D\u7684\u6B63\u786E\u770B\u6CD5\u662F\u76EF\u7740\u6CA1\u7403\u7684\u4EBA\uFF1A\u8FDB\u7403\u524D\u4E8C\u5341\u79D2\uFF0C\u8C01\u5728\u7275\u5236\uFF0C\u8C01\u5728\u62C9\u5F00\u5BBD\u5EA6\uFF0C\u8C01\u7684\u8DD1\u52A8\u8BA9\u4F20\u7403\u7EBF\u8DEF\u5B58\u5728\u3002\u96C6\u9526\u4E0D\u4F1A\u7ED9\u4F60\u8FD9\u4E9B\uFF0C\u56E0\u4E3A\u955C\u5934\u5BBD\u5EA6\u662F\u526A\u8F91\u5E08\u51B3\u5B9A\u7684\uFF0C\u7403\u573A\u5BBD\u5EA6\u4E0D\u662F\u3002\u6709\u4E9B\u771F\u76F8\u5728\u955C\u5934\u5916\uFF0C\u5C31\u50CF\u6709\u4E9B\u7403\u8863\u53F7\u7801\u5728\u4E09\u660E\u6CBB\u540E\u9762\u2014\u2014\u4F60\u4E0D\u80FD\u56E0\u4E3A\u770B\u4E0D\u89C1\uFF0C\u5C31\u5F53\u5B83\u4E0D\u5B58\u5728\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8FD9\u4E5F\u662F\u73B0\u573A\u770B\u7403\u4ECD\u7136\u4E0D\u53EF\u66FF\u4EE3\u7684\u539F\u56E0\uFF1A\u8F6C\u64AD\u673A\u4F4D\u6709\u76F2\u533A\uFF0C\u7403\u63A2\u7684\u5EA7\u4F4D\u53EF\u4EE5\u6362\u3002\u7B14\u8BB0\u6A21\u677F\u5F88\u7B80\u5355\u2014\u2014\u6BCF\u6B21\u65E0\u7403\u7275\u5236\u8BB0\u4E00\u7B14\uFF0C\u6BCF\u534A\u573A\u4F30\u7B97\u4E00\u6B21\u201C\u4E3A\u961F\u53CB\u817E\u51FA\u7684\u5E73\u65B9\u7C73\u201D\u3002\u6570\u5B57\u662F\u4F30\u7684\uFF0C\u8D8B\u52BF\u662F\u771F\u7684\uFF0C\u800C\u8D8B\u52BF\u6B63\u662F\u62A5\u4EF7\u7684\u4F9D\u636E\u3002\u5982\u679C\u9884\u7B97\u53EA\u591F\u4E70\u4E00\u5F20\u7968\uFF0C\u8BF7\u4E70\u80FD\u770B\u89C1\u53E6\u4E00\u4FA7\u770B\u53F0\u7684\u5EA7\u4F4D\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u7403\u5728\u5DE6\u8FB9\uFF0C\u6BD4\u8D5B\u5E38\u5E38\u5728\u53F3\u8FB9\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u4E8C\u5237\u6E05\u5355"
        english: 
      sidebarBody:
        chineseSimplified: "\u8FDB\u7403\u524D\u4E8C\u5341\u79D2\u7684\u65E0\u7403\u4EBA\uFF1B\u4E22\u7403\u65F6\u79BB\u7403\u6700\u8FDC\u7684\u4EBA\uFF1B\u5E86\u795D\u65F6\u5BF9\u65B9\u8C01\u5728\u7CFB\u978B\u5E26\u3002"
        english: 
