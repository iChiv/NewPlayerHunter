        chineseSimplified: "\u54C8\u91CC\u65AF\uFF1A\u677F\u51F3\u4E0A\u7684\u6307\u6325\u5B98"
        english: 
      deck:
        chineseSimplified: "\u51A0\u519B\u5956\u724C\u662F\u771F\u7684\uFF0C\u66FF\u8865\u4E5F\u662F\u771F\u7684\uFF0C\u8FD9\u4E24\u4EF6\u4E8B\u5E76\u4E0D\u77DB\u76FE\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u6307\u6325\u9632\u7EBF\u7684\u80FD\u529B\u662F\u95E8\u5C06\u91CC\u7684\u7B2C\u4E00\u68AF\u961F\uFF1A\u55D3\u95E8\u3001\u624B\u52BF\u3001\u7AD9\u4F4D\u8C03\u5EA6\uFF0C\u6574\u6761\u540E\u9632\u7EBF\u5728\u4ED6\u7684\u53E3\u4EE4\u91CC\u79FB\u52A8\u3002\u51A0\u519B\u8D5B\u5B63\u867D\u672A\u6253\u6EE1\uFF0C\u66F4\u8863\u5BA4\u4E0E\u8BAD\u7EC3\u573A\u7684\u8D21\u732E\u6709\u53E3\u7686\u7891\u3002\u6251\u6551\u57FA\u672C\u529F\u624E\u5B9E\uFF0C\u51C6\u5907\u6D3B\u52A8\u804C\u4E1A\u5230\u523B\u677F\u3002\u4F5C\u4E3A\u201C\u968F\u65F6\u80FD\u8FDB\u9996\u53D1\u201D\u7684\u7B2C\u4E8C\u95E8\u5C06\uFF0C\u4ED6\u7684\u5C65\u5386\u51E0\u4E4E\u662F\u4E3A\u8FD9\u4E2A\u5C97\u4F4D\u91CF\u8EAB\u5199\u7684\u2014\u2014\u54EA\u5BB6\u7403\u961F\u8D34\u51FA\u8FD9\u7C7B\u9700\u6C42\uFF0C\u7167\u7740\u4ED6\u6284\u5C31\u884C\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u7591\u95EE\u96C6\u4E2D\u5728\u201C\u8282\u594F\u201D\u4E8C\u5B57\uFF1A\u957F\u671F\u66FF\u8865\u610F\u5473\u7740\u6BD4\u8D5B\u611F\u89C9\u9700\u8981\u9884\u70ED\uFF0C\u7A81\u7136\u8FDB\u9996\u53D1\u7684\u524D\u4E24\u573A\uFF0C\u901A\u5E38\u662F\u4ED6\u6700\u8106\u5F31\u7684\u65F6\u5019\u3002\u5E74\u9F84\u589E\u957F\u540E\uFF0C\u53CD\u5E94\u7684\u4E0B\u5761\u4E0D\u53EF\u907F\u514D\uFF0C\u53EA\u662F\u88AB\u7ECF\u9A8C\u63A9\u76D6\u5F97\u5F88\u597D\u3002\u4E60\u60EF\u4E86\u5F3A\u961F\u9632\u7EBF\u7684\u4ED6\uFF0C\u82E5\u53BB\u4E00\u652F\u88AB\u538B\u7740\u6253\u7684\u7403\u961F\uFF0C\u6307\u6325\u4F53\u7CFB\u8981\u91CD\u5EFA\u3002\u5408\u540C\u53CB\u597D\uFF0C\u4F46\u8BF7\u628A\u201C\u51FA\u573A\u6FC0\u52B1\u201D\u5199\u7EC6\u4E00\u70B9\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u6307\u6325\u4E86\u6574\u6761\u9632\u7EBF\uFF0C\u9664\u4E86\u81EA\u5DF1\u7684\u51FA\u573A\u65F6\u95F4\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u9002\u914D\u8BF4\u660E"
        english: 
      sidebarBody:
        chineseSimplified: "\u9002\u5408\uFF1A\u6709\u4E3B\u529B\u95E8\u5C06\u3001\u8981\u7ADE\u4E89\u4E0E\u4FDD\u9669\u7684\u7403\u961F\u3002\u4E0D\u9002\u5408\uFF1A\u9700\u8981\u4ED6\u7ACB\u523B\u573A\u573A\u9996\u53D1\u7684\u7403\u961F\u3002\u9884\u70ED\u4E24\u573A\uFF0C\u7136\u540E\u653E\u5FC3\u3002"
