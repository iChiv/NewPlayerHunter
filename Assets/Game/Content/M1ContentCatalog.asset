      deck:
        chineseSimplified: "\u4E00\u4F4D\u5168\u7F51\u77E5\u540D\u7684\u7F51\u7EA2\u60F3\u5706\u804C\u4E1A\u68A6\uFF0C\u4E00\u4F4D\u4E1A\u4F59\u8054\u8D5B\u7684\u597D\u597D\u5148\u751F\u60F3\u8BD5\u8BD5\u6C34\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u7F57\u4F2F\u7279\xB7\u6D77\u8036\u65AF\u7684\u7B80\u5386\u9644\u4EF6\u662F\u8D26\u53F7\u540E\u53F0\u622A\u56FE\uFF1A\u56DB\u767E\u4E07\u7C89\u4E1D\u3002\u4ED6\u7684\u89C6\u9891\u91CC\u7403\u6280\u534E\u4E3D\uFF0C\u8BC4\u8BBA\u533A\u4E00\u81F4\u8BA4\u4E3A\u4ED6\u8BE5\u8E22\u804C\u4E1A\u3002\u4ED6\u672C\u4EBA\u4E5F\u8FD9\u4E48\u89C9\u5F97\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u53E6\u4E00\u4F4D\u5B89\u5FB7\u70C8\xB7\u83AB\u96F7\u62C9\u5C31\u6734\u7D20\u591A\u4E86\uFF1A\u672C\u5730\u4E1A\u4F59\u961F\u8FB9\u950B\uFF0C\u52A9\u653B\u591A\uFF0C\u4EBA\u7F18\u597D\uFF0C\u81EA\u5DF1\u627E\u4E0A\u95E8\u6765\u95EE\u201C\u6709\u6CA1\u6709\u673A\u4F1A\u201D\u3002\u800C\u706F\u5854\u5DE5\u5382\u8FD8\u5728\u627E\u4E00\u4E2A\u201C\u957F\u4F20\u6765\u4E86\u5148\u522B\u6454\u201D\u7684\u4E2D\u950B\u2014\u2014\u6D41\u91CF\u548C\u70ED\u60C5\uFF0C\u90FD\u5E2E\u4E0D\u4E0A\u8FD9\u4E2A\u5FD9\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u6D41\u91CF\u80FD\u5151\u6362\u53D1\u5E03\u4F1A\uFF0C\u5151\u6362\u4E0D\u4E86\u51FA\u573A\u65F6\u95F4\u3002"
        english: 
