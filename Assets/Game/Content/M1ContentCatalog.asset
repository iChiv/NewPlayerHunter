      deck:
        chineseSimplified: "\u901F\u5EA6\u9876\u7EA7\uFF0C\u72B6\u6001\u7384\u5B66\uFF0C\u4E5D\u652F\u7403\u961F\u5404\u6709\u5404\u7684\u7248\u672C\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u7EAF\u901F\u5EA6\u662F\u4ED6\u7684\u786C\u901A\u8D27\uFF1A\u542F\u52A8\u90A3\u4E00\u4E0B\u5728\u4EFB\u4F55\u7EA7\u522B\u90FD\u591F\u7528\uFF0C\u53CD\u51FB\u573A\u666F\u91CC\u4ED6\u4E00\u4E2A\u4EBA\u5C31\u662F\u7EB5\u6DF1\u3002\u72B6\u6001\u5728\u7EBF\u65F6\u7684\u4ED6\u662F\u96C6\u9526\u5236\u9020\u673A\uFF0C\u201C\u4E00\u4E2A\u4EBA\u8D62\u4E0B\u6BD4\u8D5B\u201D\u7684\u573A\u6B21\u786E\u5B9E\u5B58\u5728\uFF0C\u4E14\u6709\u753B\u9762\u3002\u4E5D\u652F\u7403\u961F\u7684\u7ECF\u5386\u6362\u4E2A\u89D2\u5EA6\u770B\u4E5F\u662F\u4FE1\u606F\u2014\u2014\u6BCF\u652F\u7403\u961F\u90FD\u613F\u610F\u8D4C\u4ED6\u4E00\u6B21\uFF0C\u8BF4\u660E\u5929\u8D4B\u7684\u53EF\u89C1\u5EA6\u6781\u9AD8\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4F46\u4E5D\u652F\u7403\u961F\u4E5F\u90FD\u6CA1\u6709\u7559\u4F4F\u4ED6\uFF0C\u8FD9\u662F\u7B80\u5386\u4E0A\u6700\u5927\u7684\u4E00\u53E5\u6F5C\u53F0\u8BCD\u3002\u72B6\u6001\u8D77\u4F0F\u7684\u539F\u56E0\u4ECE\u672A\u88AB\u8BF4\u6E05\uFF1A\u662F\u4F24\u75C5\u7BA1\u7406\u3001\u6218\u672F\u9002\u914D\u8FD8\u662F\u804C\u4E1A\u4E60\u60EF\uFF1F\u4E09\u79CD\u7B54\u6848\u5BF9\u5E94\u4E09\u79CD\u98CE\u9669\u7B49\u7EA7\u3002\u4F53\u80FD\u50A8\u5907\u4E00\u822C\uFF0C\u60C5\u7EEA\u968F\u6BD4\u8D5B\u8D70\u52BF\u6CE2\u52A8\u660E\u663E\u3002\u4ED6\u53EA\u9002\u5408\u4F5C\u4E3A\u201C\u53D8\u62DB\u201D\u800C\u975E\u201C\u57FA\u77F3\u201D\u7B7E\u7EA6\uFF0C\u5408\u540C\u91CC\u8BF7\u5199\u6EE1\u4E0E\u51FA\u573A\u6302\u94A9\u7684\u6761\u6B3E\u3002"
        english: 
