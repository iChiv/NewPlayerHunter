        chineseSimplified: "\u51AC\u7A97\u662F\u7EAA\u5F55\u901A\u80C0\u7684\u91CD\u707E\u533A\u3002\u6BCF\u5F00\u4E00\u6247\u7A97\uFF0C\u201C\u6700\u5E74\u8F7B\u201D\u5C31\u81EA\u52A8\u7EC6\u5206\u51FA\u961F\u53F2\u7248\u3001\u8054\u8D5B\u7248\u3001\u5BA2\u573A\u7248\u548C\u5468\u4E8C\u4E0B\u5348\u7248\u3002\u672C\u520A\u5EFA\u8BAE\u7684\u8BFB\u6CD5\u662F\uFF1A\u5148\u627E\u9650\u5B9A\u8BCD\uFF0C\u518D\u627E\u539F\u59CB\u6587\u4EF6\uFF0C\u6700\u540E\u624D\u770B\u4EF7\u683C\u6807\u7B7E\u3002\u9650\u5B9A\u8BCD\u8D8A\u591A\uFF0C\u7EAA\u5F55\u8D8A\u591A\uFF1B\u9644\u4EF6\u8D8A\u8584\uFF0C\u6807\u9898\u8D8A\u5927\u3002\u4E70\u65B9\u7684\u81EA\u67E5\u4E5F\u5F88\u7B80\u5355\uFF1A\u5982\u679C\u4F60\u53EA\u80FD\u7528\u6807\u9898\u590D\u8FF0\u8FD9\u7B14\u7B7E\u7EA6\uFF0C\u8BF7\u5148\u522B\u7B7E\u5B57\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u5148\u95EE\u7EAA\u5F55\u5168\u79F0\uFF0C\u518D\u95EE\u4EF7\u683C\u3002\u201D"
