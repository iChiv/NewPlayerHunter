        chineseSimplified: "\u7D27\u7F29\u4FE1\u53F7"
        english: 
      sidebarBody:
        chineseSimplified: "\u8F6C\u4F1A\u8D39\u9884\u7B97\u4E3A\u96F6\uFF1B\u79DF\u501F\u9884\u7B97\u4E5F\u4E3A\u96F6\uFF1B\u201C\u5185\u90E8\u6316\u6F5C\u201D\u56DB\u4E2A\u5B57\u51FA\u73B0\u5728\u6240\u6709\u4F1A\u8BAE\u7EAA\u8981\u91CC\u3002"
