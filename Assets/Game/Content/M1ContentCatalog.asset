        english: 
      headline:
        chineseSimplified: "\u53EF\u9760\u6027\uFF0C\u4E00\u79CD\u6C89\u9ED8\u7684\u4EA7\u80FD"
        english: 
      deck:
        chineseSimplified: "\u5E02\u573A\u4E3A\u5929\u8D4B\u4ED8\u6EA2\u4EF7\uFF0C\u4E3A\u53EF\u9760\u6027\u4ED8\u5DE5\u8D44\u2014\u2014\u5E94\u8BE5\u53CD\u8FC7\u6765\u60F3\u60F3\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u6BCF\u5E74\u8F6C\u4F1A\u7A97\uFF0C\u5934\u6761\u5C5E\u4E8E\u5929\u624D\uFF0C\u5DE5\u8D44\u5355\u5C5E\u4E8E\u53EF\u9760\u8005\u3002\u6CD5\u91CC\u4E9A\u5F0F\u4E2D\u573A\u4E0D\u751F\u4EA7\u96C6\u9526\uFF0C\u53EA\u751F\u4EA7\u201C\u6559\u7EC3\u4E0D\u7528\u60F3\u8FD9\u4E2A\u4F4D\u7F6E\u201D\u7684\u5B89\u5FC3\u611F\u2014\u2014\u4E5D\u4E2A\u8D5B\u5B63\u91CC\uFF0C\u4ED6\u7684\u5386\u4EFB\u4E3B\u5E05\u6362\u4E86\u4E00\u832C\u53C8\u4E00\u832C\uFF0C\u6BCF\u4E2A\u4EBA\u7684\u9996\u53D1\u5E03\u7F6E\u4F1A\u90FD\u4ECE\u4ED6\u540D\u5B57\u5199\u8D77\u3002\u53EF\u9760\u6027\u7684\u7ECF\u6D4E\u5B66\u5F88\u7B80\u5355\uFF1A\u4E00\u4E2A\u4F4D\u7F6E\u4E5D\u5E74\u4E0D\u9700\u8981\u4E70\u66FF\u8865\u3001\u4E0D\u9700\u8981\u5E94\u6025\u9884\u6848\u3001\u4E0D\u9700\u8981\u6218\u672FB\u8BA1\u5212\uFF0C\u7701\u4E0B\u7684\u8F6C\u4F1A\u8D39\u548C\u7126\u8651\u6298\u73B0\u540E\u662F\u4E2A\u60CA\u4EBA\u7684\u6570\u5B57\u3002\u672C\u520A\u5EFA\u8BAE\u628A\u201C\u7F3A\u5E2D\u6210\u672C\u201D\u5199\u8FDB\u6BCF\u4EFD\u8BC4\u4F30\u62A5\u544A\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4E07\u91D1\u6CB9\u7403\u5458\u5219\u662F\u53EF\u9760\u6027\u7684\u53E6\u4E00\u79CD\u5F62\u72B6\uFF1A\u4ED6\u4E0D\u662F\u6BCF\u5929\u90FD\u53EF\u9760\uFF0C\u800C\u662F\u5230\u5904\u90FD\u53EF\u7528\u3002\u201C\u54EA\u91CC\u7F3A\u4EBA\u8865\u54EA\u91CC\u201D\u542C\u8D77\u6765\u50CF\u5938\u5956\uFF0C\u8BC4\u4F30\u65F6\u5374\u662F\u9053\u96BE\u9898\u2014\u2014\u6BCF\u4E2A\u4F4D\u7F6E\u90FD\u8E22\u8FC7\uFF0C\u610F\u5473\u7740\u6BCF\u4E2A\u4F4D\u7F6E\u90FD\u8981\u5355\u72EC\u5B9A\u4EF7\u3002\u7FA4\u5C9B\u961F\u6B64\u524D\u90A3\u53E5\u201C\u4E00\u4E2A\u4EBA\u9876\u4E09\u4E2A\u4EBA\u201D\u8BF4\u5F97\u5F88\u5F62\u8C61\uFF0C\u4F46\u8BF7\u8BB0\u4F4F\uFF1A\u4E09\u4E2A\u4F4D\u7F6E\u7684\u51FA\u573A\u65F6\u95F4\uFF0C\u4E0D\u80FD\u53E0\u52A0\u6210\u4E09\u4E2A\u4EBA\u3002\u4E07\u91D1\u6CB9\u7684\u6B63\u786E\u7528\u6CD5\u662F\u586B\u7A7A\uFF0C\u4E0D\u662F\u91CD\u5EFA\u3002\u5723\u676F\u5B66\u9662\u672C\u5468\u5728\u627E\u201C\u79C1\u751F\u6D3B\u68C0\u70B9\u3001\u503C\u5F97\u57F9\u517B\u201D\u7684\u5E74\u8F7B\u4EBA\u2014\u2014\u4E24\u4F4D\u672C\u671F\u4E3B\u89D2\u8D85\u9F84\u4E86\uFF0C\u4F46\u804C\u4E1A\u54C1\u8D28\u8FD9\u95E8\u8BFE\uFF0C\u4ED6\u4EEC\u65E9\u5DF2\u6BD5\u4E1A\u3002"
        english: 
