        chineseSimplified: "\u4F18\u52BF\u6E05\u6E05\u695A\u695A\uFF1A\u8461\u8D85\u51FA\u573A\u7834\u767E\u3001\u6B27\u6218\u89C1\u8FC7\u573A\u9762\uFF0C\u7206\u53D1\u529B\u662F\u5373\u63D2\u5373\u7528\u7684\u90A3\u79CD\u3002\u4E09\u573A\u5B8C\u6574\u5F55\u50CF\u91CC\uFF0C\u4ED6\u7684\u5185\u5207\u7EBF\u8DEF\u51E0\u4E4E\u4E0D\u6362\u82B1\u6837\uFF0C\u9632\u5B88\u8005\u77E5\u9053\u4ED6\u8981\u5E72\u4EC0\u4E48\uFF0C\u8FD8\u662F\u62E6\u4E0D\u4F4F\u3002\u7531\u5B88\u8F6C\u653B\u65F6\uFF0C\u4ED6\u662F\u90A3\u79CD\u8BA9\u4E2D\u540E\u536B\u63D0\u524D\u540E\u6094\u7AD9\u4F4D\u7684\u8FB9\u950B\u3002"
        english: 
