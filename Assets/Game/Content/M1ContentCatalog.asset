      bodyLeft:
        chineseSimplified: "\u5F71\u950B\u7684\u672C\u80FD\u662F\u5929\u751F\u7684\u90A3\u79CD\uFF1A\u4ED6\u559C\u6B22\u4ECE\u524D\u950B\u8EAB\u540E\u7A81\u7136\u63D2\u8FDB\u7981\u533A\uFF0C\u542F\u52A8\u65F6\u673A\u7684\u9009\u62E9\u8FDC\u8D85\u5E74\u9F84\u3002\u9752\u5E74\u56FD\u811A\u8EAB\u4EFD\u5C5E\u5B9E\uFF0C\u6700\u5E74\u8F7B\u51FA\u573A\u7EAA\u5F55\u7ECF\u6587\u4EF6\u6838\u5B9E\u5C5E\u5B9E\u2014\u2014\u5728\u672C\u8D5B\u5B63\u7684\u4FE1\u606F\u73AF\u5883\u91CC\uFF0C\u201C\u5C5E\u5B9E\u201D\u4E24\u4E2A\u5B57\u503C\u5F97\u5355\u72EC\u52A0\u7C97\u3002"
        english: 
