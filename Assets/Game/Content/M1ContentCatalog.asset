        english: 
      bodyLeft:
        chineseSimplified: "\u56DB\u6708\u7684\u75B2\u52B3\u9996\u5148\u653B\u51FB\u7684\u4E0D\u662F\u817F\uFF0C\u662F\u51B3\u7B56\uFF1A\u4F20\u7403\u9009\u62E9\u53D8\u76F4\uFF0C\u56DE\u8FFD\u5C11\u534A\u6B65\uFF0C\u8D5B\u524D\u558A\u7740\u52A0\u7EC3\u7684\u4EBA\u7A81\u7136\u51C6\u65F6\u4E0B\u73ED\u3002\u8D5B\u5B63\u521D\u6211\u4EEC\u56F4\u89C2\u8FC7\u201C\u65F6\u901F\u4E24\u767E\u516C\u91CC\u7684\u5766\u514B\u201D\u548C\u6C38\u52A8\u673A\u5F0F\u7684\u4EBA\u7269\uFF0C\u73B0\u5728\u5230\u4E86\u68C0\u67E5\u4FDD\u517B\u8BB0\u5F55\u7684\u65F6\u5019\u2014\u2014\u795E\u8BDD\u4E5F\u8981\u505A\u56DB\u6708\u5E74\u68C0\uFF0C\u800C\u4E14\u5E74\u68C0\u4E0D\u8FC7\u4E0D\u8BB8\u4E0A\u8DEF\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4F53\u80FD\u7BA1\u7406\u7684\u6B63\u9762\u6559\u6750\u90FD\u85CF\u5728\u7EC6\u8282\u91CC\uFF1A\u8F6E\u6362\u53D1\u751F\u5728\u75B2\u52B3\u4E4B\u524D\u800C\u4E0D\u662F\u4E4B\u540E\uFF0C\u8001\u5C06\u6709\u4E13\u5C5E\u7684\u6062\u590D\u65E5\u7A0B\u3002\u6709\u4E9B\u4FDD\u6E29\u676F\u91CC\u6CE1\u7740\u7684\u914D\u65B9\u5C5E\u4E8E\u7403\u961F\u4E00\u7EA7\u673A\u5BC6\uFF0C\u672C\u520A\u4E0D\u6253\u542C\u6210\u5206\uFF0C\u53EA\u786E\u8BA4\u6548\u679C\u2014\u2014\u56DB\u6708\u7684\u8D5B\u573A\u4E0A\uFF0C\u6E29\u5EA6\u4E5F\u662F\u4E00\u79CD\u7ADE\u4E89\u529B\u3002\u75B2\u52B3\u53EF\u4EE5\u539F\u8C05\uFF0C\u5BF9\u75B2\u52B3\u6492\u8C0E\u4E0D\u884C\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u8DD1\u5F97\u52A8\u662F\u4F53\u80FD\uFF0C\u77E5\u9053\u4EC0\u4E48\u65F6\u5019\u8DD1\u662F\u4F53\u80FD\u7BA1\u7406\u3002\u201D"
