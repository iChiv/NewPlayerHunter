        chineseSimplified: "\u6CA1\u8E22\u8FC7\u9876\u7EA7\u8054\u8D5B\uFF0C\u5374\u4E00\u76F4\u5728\u5F53\u961F\u957F\u2014\u2014\u8FD9\u672C\u8EAB\u5C31\u662F\u4E00\u79CD\u4F4D\u7F6E\u3002"
