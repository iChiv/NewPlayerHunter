        english: 
      bodyLeft:
        chineseSimplified: "\u51B3\u8D5B\u5468\u7684\u95E8\u5C06\u662F\u6700\u5B64\u72EC\u7684\u804C\u4E1A\uFF1A\u5168\u961F\u56F4\u6210\u4E00\u5708\u65F6\uFF0C\u4ED6\u5728\u5708\u91CC\uFF1B\u7403\u5728\u5BF9\u65B9\u534A\u573A\u65F6\uFF0C\u4ED6\u5728\u81EA\u5DF1\u7684\u56DE\u653E\u91CC\u3002\u5FC3\u7406\u5B66\u5BB6\u8BF4\u8FD9\u53EB\u5C97\u4F4D\u7279\u6027\uFF0C\u95E8\u5C06\u8BF4\u8FD9\u53EB\u5468\u4E8C\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u672C\u520A\u91C7\u8BBF\u4E86\u4E09\u4F4D\u53C2\u52A0\u8FC7\u51B3\u8D5B\u7684\u95E8\u5C06\u6559\u7EC3\uFF0C\u7ED3\u8BBA\u4E00\u81F4\uFF1A\u51B3\u8D5B\u524D\u6700\u597D\u7684\u5FC3\u7406\u5EFA\u8BBE\uFF0C\u662F\u8BA9\u95E8\u5C06\u76F8\u4FE1\u6D41\u7A0B\u6BD4\u7ED3\u679C\u5927\u3002\u5176\u6B21\u624D\u662F\u7948\u7977\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u4E5D\u5341\u5206\u949F\u91CC\u95E8\u5C06\u53EA\u72AF\u4E00\u6B21\u9519\u5C31\u591F\u5199\u8FDB\u5E74\u9274\u2014\u2014\u6240\u4EE5\u4ED6\u4EEC\u5B66\u4F1A\u4E86\u5148\u539F\u8C05\u81EA\u5DF1\u3002\u201D"
        english: 
