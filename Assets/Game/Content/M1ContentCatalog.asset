        chineseSimplified: "\u7B7E\u7EA6\u6210\u672C\uFF1A\u4F4E\u3002\u9A8C\u8BC1\u6210\u672C\uFF1A\u4E24\u573A\u516C\u5F00\u8BD5\u8BAD\u3002\u6F5C\u5728\u6536\u76CA\uFF1A\u4E00\u4F4D\u4F1A\u4F20\u4E2D\u7684\u8F6E\u6362\u3002\u6F5C\u5728\u98CE\u9669\uFF1A\u4E00\u6761\u5F00\u653E\u7684\u8FB9\u8DEF\u8D70\u5ECA\u3002"
