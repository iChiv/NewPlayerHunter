        english: 
      headline:
        chineseSimplified: "\u6D41\u91CF\u8D27\u5E01\u5316\uFF0C\u51FA\u573A\u7A00\u7F3A\u5316"
        english: 
      deck:
        chineseSimplified: "\u4ECE\u201C41\u7403\u201D\u5230\u201C\u56DB\u767E\u4E07\u7C89\u201D\uFF1A\u6570\u5B57\u8D8A\u5927\uFF0C\u8D8A\u8981\u95EE\u51FA\u5904\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u672C\u520A\u521B\u520A\u90A3\u5E74\u5B66\u4F1A\u7684\u7B2C\u4E00\u8BFE\uFF0C\u6765\u81EA\u7F57\u91CC\u7684\u201C41\u7403\u201D\uFF1A\u6570\u5B57\u672C\u8EAB\u4E0D\u4F1A\u8BF4\u8C0E\uFF0C\u4F46\u6570\u5B57\u7684\u53E3\u5F84\u4F1A\u3002\u56DB\u767E\u4E07\u7C89\u4E1D\u540C\u7406\u2014\u2014\u5B83\u662F\u771F\u5B9E\u7684\u793E\u4F1A\u8D44\u4EA7\uFF0C\u80FD\u5E26\u6765\u7403\u8863\u9500\u91CF\u3001\u8D5E\u52A9\u8C08\u5224\u548C\u53D1\u5E03\u4F1A\u76F4\u64AD\u7684\u4EBA\u6C14\uFF0C\u8FD9\u4E00\u70B9\u4E0D\u5FC5\u9178\u3002\u95EE\u9898\u5728\u4E8E\uFF0C\u8DB3\u7403\u4FF1\u4E50\u90E8\u540C\u65F6\u662F\u6BCF\u5468\u672B\u63A5\u53D7\u516C\u5F00\u5BA1\u8BA1\u7684\u673A\u6784\uFF1A\u9996\u53D1\u5341\u4E00\u4EBA\u91CC\u6CA1\u6709\u201C\u526A\u8F91\u201D\u8FD9\u4E2A\u804C\u4F4D\u3002\u6D41\u91CF\u578B\u7B7E\u7EA6\u7684\u6B63\u786E\u59FF\u52BF\uFF0C\u662F\u628A\u5546\u4E1A\u5408\u540C\u548C\u7ADE\u6280\u5408\u540C\u5206\u5F00\u7B7E\uFF0C\u5206\u5F00\u8003\u6838\uFF0C\u5206\u5F00\u5BA3\u5E03\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4E1A\u4F59\u795E\u8BDD\u5219\u662F\u6D41\u91CF\u7684\u53CD\u9762\uFF1A\u6CA1\u6709\u6570\u636E\uFF0C\u53EA\u6709\u4EBA\u7F18\u3002\u201C\u961F\u53CB\u90FD\u5F88\u559C\u6B22\u4ED6\u201D\u201C\u52A9\u653B\u5F88\u591A\u201D\u2014\u2014\u8FD9\u7C7B\u8BC4\u4EF7\u7684\u53EF\u9760\u6027\u7EA6\u7B49\u4E8E\u90BB\u5C45\u8BC1\u8BCD\uFF0C\u672C\u520A\u8BC4\u7EA7\uFF1A\u6309\u4F20\u95FB\u5904\u7406\u3002\u4F46\u6CE8\u610F\uFF0C\u4F20\u95FB\u4E0D\u7B49\u4E8E\u9519\u8BEF\uFF0C\u53EA\u7B49\u4E8E\u672A\u9A8C\u8BC1\u3002\u6B63\u786E\u7684\u505A\u6CD5\u662F\u7ED9\u4E00\u6B21\u4F4E\u6210\u672C\u7684\u9A8C\u8BC1\u673A\u4F1A\uFF1A\u516C\u5F00\u8BD5\u8BAD\u3001\u8DDF\u961F\u4E24\u5468\u3001\u8E22\u4E00\u573A\u6709\u8BB0\u5F55\u7684\u5BF9\u6297\u8D5B\u3002\u795E\u8BDD\u4E0D\u6015\u68C0\u9A8C\uFF0C\u6015\u7684\u662F\u6C38\u8FDC\u4E0D\u68C0\u9A8C\u3002\u987A\u4FBF\u4E00\u63D0\uFF0C\u672C\u520A\u81F3\u4ECA\u8BB0\u5F97\u5361\u6D1B\u7528\u4E09\u660E\u6CBB\u6321\u4F4F\u53F7\u7801\u7684\u90A3\u4E2A\u4E0B\u5348\u2014\u2014\u90A3\u662F\u5BF9\u201C\u540D\u6C14\u201D\u6700\u8BDA\u5B9E\u7684\u4E00\u6B21\u5904\u7406\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u5F53\u5E74\u768441\u7403\u6559\u4F1A\u6211\u4EEC\uFF1A\u5927\u6570\u5B57\u90FD\u8981\u914D\u4E0A\u51FA\u5904\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u672C\u520A\u8BC4\u7EA7"
