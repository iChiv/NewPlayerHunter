        chineseSimplified: "\u4ECE\u95E8\u7EBF\u5230\u4E2D\u7EBF\uFF1A\u4E00\u6B21\u9759\u6084\u6084\u7684\u9769\u547D"
        english: 
      deck:
        chineseSimplified: "\u5F53\u6559\u7EC3\u5F00\u59CB\u7528\u4F20\u7403\u6B21\u6570\u8003\u6838\u95E8\u5C06\uFF0C\u8F6C\u4F1A\u5E02\u573A\u7684\u6392\u5E8F\u4E5F\u53D8\u4E86\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u95E8\u5C06\u662F\u8DB3\u7403\u91CC\u6700\u540E\u4E00\u4E2A\u88AB\u91CD\u65B0\u5B9A\u4E49\u7684\u4F4D\u7F6E\u3002\u5341\u5E74\u524D\u7684\u8BC4\u4EF7\u6807\u51C6\u662F\u4E00\u5F20\u6E05\u5355\uFF1A\u53CD\u5E94\u3001\u7AD9\u4F4D\u3001\u9AD8\u7A7A\u7403\u3002\u5982\u4ECA\u6E05\u5355\u591A\u4E86\u4E00\u884C\uFF0C\u800C\u4E14\u88AB\u4E0D\u5C11\u6559\u7EC3\u632A\u5230\u7B2C\u4E00\u884C\uFF1A\u51FA\u7403\u3002\u5149\u5934\u6559\u7EC3\u4EEC\u7684\u903B\u8F91\u5F88\u76F4\u63A5\u2014\u2014\u5982\u679C\u95E8\u5C06\u662F\u5168\u961F\u552F\u4E00\u6C38\u8FDC\u9762\u5BF9\u8FDB\u653B\u65B9\u5411\u7684\u4EBA\uFF0C\u90A3\u4ED6\u7406\u5E94\u53C2\u4E0E\u7EC4\u7EC7\u3002\u4E8E\u662F\u5E02\u573A\u4E0A\u51FA\u73B0\u4E86\u65B0\u54C1\u79CD\uFF1A\u6251\u6551\u5408\u683C\u3001\u811A\u6CD5\u51FA\u8272\u7684\u201C\u7EC4\u7EC7\u578B\u95E8\u5C06\u201D\u3002\u672C\u520A\u63D0\u9192\u4E70\u5BB6\uFF1A\u5148\u60F3\u6E05\u695A\u81EA\u5DF1\u7684\u6218\u672F\u9700\u4E0D\u9700\u8981\u8FD9\u53CC\u811A\uFF0C\u518D\u51B3\u5B9A\u4E3A\u8FD9\u53CC\u811A\u4ED8\u591A\u5C11\u94B1\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u53E6\u4E00\u4F4D\u672C\u5468\u8FDB\u5165\u89C6\u7EBF\u7684\u8001\u5C06\u63D0\u9192\u6211\u4EEC\u4F4D\u7F6E\u7684\u53E6\u4E00\u9762\uFF1A\u5929\u8D4B\u4ECE\u4E0D\u6298\u65E7\uFF0C\u8EAB\u4F53\u4F1A\u3002\u90A3\u4F4D\u66FE\u7ECF\u7684\u4E16\u754C\u7EA7\u4E2D\u573A\uFF0C\u8BAD\u7EC3\u5F55\u50CF\u91CC\u7684\u5DE6\u811A\u4F9D\u7136\u80FD\u628A\u7403\u4F20\u5230\u4EFB\u4F55\u5750\u6807\uFF0C\u4F46\u4E09\u5E74\u6CA1\u6709\u6B63\u5F0F\u6BD4\u8D5B\u7684\u7A7A\u767D\uFF0C\u4E0D\u662F\u96C6\u9526\u80FD\u586B\u6EE1\u7684\u3002\u95E8\u5C06\u9760\u811A\u6CD5\u5EF6\u957F\u804C\u4E1A\u5BFF\u547D\uFF0C\u5DE8\u661F\u8981\u9760\u4F53\u68C0\u62A5\u544A\u4E89\u53D6\u6700\u540E\u4E00\u6B21\u673A\u4F1A\u3002\u4E24\u79CD\u56DE\u5F52\uFF0C\u4E00\u4E2A\u5171\u540C\u7ED3\u8BBA\uFF1A\u5148\u770B\u6700\u8FD1\uFF0C\u518D\u770B\u66FE\u7ECF\u3002\u672C\u520A\u5BF9\u4E24\u8005\u90FD\u4FDD\u6301\u656C\u610F\uFF0C\u4E5F\u90FD\u4FDD\u6301\u6838\u5BF9\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u60C5\u6000\u8D1F\u8D23\u5230\u573A\uFF0C\u4F53\u68C0\u62A5\u544A\u8D1F\u8D23\u4E0A\u573A\u3002"
