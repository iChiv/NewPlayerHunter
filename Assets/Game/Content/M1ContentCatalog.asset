        chineseSimplified: "\u77ED\u7EA6\u4F18\u5148\uFF1B\u51FA\u573A\u6761\u6B3E\u6302\u94A9\uFF1B\u51AC\u7A97\u7B7E\u7EA6\u8BF7\u7ED9\u6625\u5929\u4E0B\u8C03\u7A7A\u95F4\u3002"
