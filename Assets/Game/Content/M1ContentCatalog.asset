      bodyLeft:
        chineseSimplified: "\u6BCF\u5E74\u590F\u7A97\u7B2C\u4E00\u5468\uFF0C\u7403\u63A2\u7684\u90AE\u7BB1\u91CC\u90FD\u8EBA\u7740\u51E0\u5C01\u8BED\u6C14\u8BDA\u6073\u7684\u6C42\u6551\u4FE1\u3002\u4ECA\u5E74\u6700\u8BDA\u6073\u7684\u4E00\u5C01\u6765\u81EA\u9ED1\u9EA6\u9152\u9986\uFF1A\u5934\u53F7\u524D\u950B\u5728\u5E86\u795D\u4E00\u573A\u4E1A\u4F59\u80DC\u5229\u4E4B\u540E\uFF0C\u6682\u65F6\u5931\u53BB\u4E86\u51FA\u573A\u80FD\u529B\u3002\u8FD9\u7C7B\u9700\u6C42\u7684\u6807\u51C6\u89E3\u6CD5\u662F\u627E\u4E00\u4F4D\u201C\u5373\u63D2\u5373\u7528\u201D\u7684\u8001\u719F\u4EBA\uFF0C\u4F46\u672C\u520A\u5EFA\u8BAE\u5148\u95EE\u4E09\u4E2A\u95EE\u9898\uFF1A\u4ED6\u4E0A\u5468\u8E22\u4E86\u5417\uFF1F\u8E22\u4E86\u591A\u4E45\uFF1F\u5BF9\u624B\u662F\u8C01\uFF1F\u4E09\u4E2A\u95EE\u9898\u7B54\u4E0D\u4E0A\u6765\uFF0C\u62A5\u4EF7\u5355\u5C31\u5148\u522B\u7B7E\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u6CD5\u7F57\u706F\u5854\u7684\u6C42\u52A9\u4FE1\u4E25\u8083\u5F97\u591A\u3002\u4FDD\u7EA7\u961F\u7684\u9632\u7EBF\u7126\u8651\u5199\u5728\u6BCF\u4E00\u4E2A\u4E22\u7403\u91CC\uFF0C\u4ED6\u4EEC\u8981\u7684\u4E0D\u662F\u540D\u6C14\uFF0C\u800C\u662F\u4E00\u4E2A\u5728\u7981\u533A\u91CC\u4E0D\u53D1\u6296\u7684\u4EBA\u3002\u672C\u520A\u63D0\u9192\uFF1A\u201C\u7ECF\u9A8C\u4E30\u5BCC\u201D\u5728\u7ECF\u7EAA\u4EBA\u8BCD\u5178\u91CC\u7EA6\u7B49\u4E8E\u201C\u5E74\u7EAA\u4E0D\u5C0F\u201D\uFF0C\u8BF7\u628A\u51FA\u573A\u8BB0\u5F55\u7FFB\u5230\u6700\u8FD1\u4E24\u4E2A\u8D5B\u5B63\uFF0C\u518D\u51B3\u5B9A\u8981\u4E0D\u8981\u611F\u52A8\u3002\u7B2C\u4E00\u5468\u7684\u5E02\u573A\uFF0C\u8010\u5FC3\u6BD4\u94B1\u5305\u91CD\u8981\u3002"
        english: 
