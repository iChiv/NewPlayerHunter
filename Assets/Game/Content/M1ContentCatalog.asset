        chineseSimplified: "\u5C0F\u7A7A\u95F4\u6280\u672F\u662F\u6700\u5927\u8D44\u4EA7\uFF1A\u8857\u5934\u8DB3\u7403\u7EC3\u51FA\u7684\u811A\u4E0B\u9891\u7387\u548C\u53D8\u5411\uFF0C\u5728\u5BC6\u96C6\u9632\u5B88\u91CC\u4F9D\u7136\u80FD\u7528\u3002\u90A3\u573A\u201C\u8FDE\u8FC7\u4E09\u4EBA\u7EDD\u6740\u201D\u7684\u9752\u5E74\u961F\u6BD4\u8D5B\u6709\u5B8C\u6574\u753B\u9762\uFF0C\u4E0D\u662F\u53E3\u8033\u76F8\u4F20\u300215\u5C81\u8FDB\u5165\u804C\u4E1A\u9752\u8BAD\uFF0C\u8DEF\u5F84\u6E05\u6670\uFF0C\u8D44\u6599\u8FDE\u8D2F\u2014\u2014\u5728\u5929\u624D\u8425\u9500\u904D\u5730\u7684\u5E74\u4EE3\uFF0C\u8FD9\u4EFD\u900F\u660E\u5EA6\u672C\u8EAB\u5C31\u503C\u94B1\u3002\u6027\u683C\u5916\u5411\uFF0C\u9002\u5E94\u95E8\u69DB\u4F4E\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u6240\u6709\u7591\u95EE\u90FD\u6765\u81EA\u540C\u4E00\u4E2A\u5730\u65B9\uFF1A\u4ED6\u8FD8\u6CA1\u5728\u6210\u4EBA\u6BD4\u8D5B\u91CC\u88AB\u9A8C\u8BC1\u8FC7\u3002\u9752\u5E74\u961F\u7684\u8EAB\u4F53\u5BF9\u6297\u4E0E\u804C\u4E1A\u8054\u8D5B\u662F\u4E24\u4E2A\u661F\u7403\uFF0C\u4ED6\u7684\u4F53\u683C\u76EE\u524D\u504F\u5355\u8584\u3002\u9632\u5B88\u7AEF\u7684\u6295\u5165\u5EA6\u672A\u77E5\uFF0C\u4F4D\u7F6E\u7EAA\u5F8B\u8FD8\u5728\u57F9\u517B\u671F\u3002\u8FD9\u662F\u4E00\u5F20\u201C\u672A\u6765\u5151\u73B0\u578B\u201D\u5408\u540C\uFF0C\u7B7E\u5B57\u524D\u8BF7\u5148\u56DE\u7B54\uFF1A\u4F60\u7684\u7403\u961F\u7B49\u5F97\u8D77\u51E0\u5E74\uFF1F"
        english: 
      pullQuote:
        chineseSimplified: "\u5929\u8D4B\u662F\u771F\u7684\uFF0C\u65E5\u5386\u4E5F\u662F\u771F\u7684\u3002"
