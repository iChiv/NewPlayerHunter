      deck:
        chineseSimplified: "\u9AD8\u538B\u6837\u672C\u7684\u91C7\u96C6\u4E0E\u8BEF\u8BFB\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u6DD8\u6C70\u8D5B\u8981\u770B\u7684\u4E0D\u662F\u96C6\u9526\u52A8\u4F5C\uFF0C\u662F\u538B\u529B\u53CD\u5E94\uFF1A\u4E22\u7403\u540E\u4E94\u79D2\u7684\u51B3\u7B56\u3001\u88AB\u6273\u5E73\u540E\u5F00\u7403\u90A3\u4E00\u5206\u949F\u3001\u5BA2\u573A\u524D\u4E8C\u5341\u5206\u949F\u7684\u51FA\u7403\u9009\u62E9\u3001\u5B9A\u4F4D\u7403\u9632\u5B88\u65F6\u8C01\u5728\u6307\u6325\u3002\u8FD9\u4E9B\u7247\u6BB5\u5728\u4E24\u56DE\u5408\u91CC\u4F1A\u91CD\u590D\u51FA\u73B0\uFF0C\u6837\u672C\u867D\u5C0F\uFF0C\u6D53\u5EA6\u5F88\u9AD8\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8BEF\u8BFB\u533A\u540C\u6837\u6807\u6CE8\u6E05\u695A\uFF1A\u5355\u573A\u795E\u52C7\u4E0D\u7B49\u4E8E\u6DD8\u6C70\u8D5B\u4F53\u8D28\uFF0C\u5BF9\u624B\u5C11\u4E00\u4EBA\u4E4B\u540E\u7684\u6570\u636E\u8981\u6253\u6298\uFF0C\u70B9\u7403\u5927\u6218\u5F55\u50CF\u8BC4\u4F30\u4E0D\u4E86\u6280\u672F\uFF0C\u53EA\u80FD\u8BC4\u4F30\u5FC3\u7387\u3002\u81F3\u5C11\u770B\u4E24\u573A\u5BA2\u573A\u3001\u4E00\u573A\u843D\u540E\u72B6\u6001\uFF1B\u9886\u5148\u65F6\u7684\u884C\u4E3A\u8BF7\u5355\u72EC\u6807\u8BB0\u2014\u2014\u90A3\u662F\u53E6\u4E00\u79CD\u4EBA\u683C\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6DD8\u6C70\u8D5B\u7684\u5F55\u50CF\u8981\u770B\u5230\u7B2C\u516B\u5341\u4E5D\u5206\u949F\uFF0C\u5305\u62EC\u66FF\u8865\u5E2D\u3002\u201D"
