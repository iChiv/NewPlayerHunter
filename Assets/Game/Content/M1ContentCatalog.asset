      sidebarBody:
        chineseSimplified: "\u516C\u5F00\u753B\u9762\uFF1A\u9752\u5E74\u961F\u6BD4\u8D5B\uFF0C\u53EF\u9760\u6027\u8F83\u9AD8\u3002\u7F3A\u5931\u9879\uFF1A\u6210\u5E74\u8054\u8D5B\u6837\u672C\uFF0C\u96F6\u573A\u3002\u62A5\u4EF7\u8BF7\u6309\u671F\u8D27\u903B\u8F91\uFF0C\u4E0D\u6309\u73B0\u8D27\u3002"
