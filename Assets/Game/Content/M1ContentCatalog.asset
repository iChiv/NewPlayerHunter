        chineseSimplified: "\u7B2C\u4E8C\u4EBA\u751F\u7684\u4F53\u80FD\u8D26"
        english: 
      deck:
        chineseSimplified: "\u79BB\u5F00\u8FC7\u8DB3\u7403\u53C8\u56DE\u6765\u7684\u4EBA\uFF0C\u8EAB\u4F53\u8D26\u672C\u548C\u522B\u4EBA\u4E0D\u4E00\u6837\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u88AB\u9752\u8BAD\u653E\u5F03\uFF0C\u662F\u8DB3\u7403\u4E16\u754C\u91CC\u6700\u666E\u901A\u7684\u4E8B\u6545\uFF1B\u4ECE\u9A6C\u62C9\u677E\u8D5B\u9053\u8DD1\u56DE\u6765\uFF0C\u624D\u662F\u65B0\u95FB\u3002\u5E93\u73C0\u4EEC\u7684\u4F18\u52BF\u5199\u5728\u80BA\u91CC\uFF1A\u8986\u76D6\u9762\u79EF\u5927\uFF0C\u53CD\u590D\u51B2\u523A\u4E0D\u53D1\u6035\uFF0C\u4E5D\u5341\u5206\u949F\u7684\u4F9B\u80FD\u7CFB\u7EDF\u662F\u957F\u8DDD\u79BB\u9879\u76EE\u4EB2\u624B\u6253\u9020\u7684\u3002\u77ED\u677F\u4E5F\u5199\u5728\u540C\u4E00\u4EFD\u5C65\u5386\u91CC\uFF1A17\u5C81\u4EE5\u540E\u7F3A\u4E86\u6570\u5E74\u7CFB\u7EDF\u8BAD\u7EC3\uFF0C\u6280\u672F\u7EC6\u8282\u505C\u5728\u5C11\u5E74\u65F6\u4EE3\u3002\u8FD9\u7C7B\u7403\u5458\u7684\u8BC4\u4F30\u8981\u62C6\u5F00\u4E24\u5F20\u8868\uFF1A\u4F53\u80FD\u8868\u6309\u6210\u5E74\u4EBA\u6807\u51C6\uFF0C\u6280\u672F\u8868\u6309\u56DE\u7089\u9752\u8BAD\u6807\u51C6\u3002\u4E24\u8868\u90FD\u8FC7\uFF0C\u624D\u53EB\u6361\u5230\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5EFA\u7B51\u5DE5\u4EBA\u7279\u7EB3\u63D0\u4F9B\u7684\u662F\u53E6\u4E00\u79CD\u4F53\u80FD\u903B\u8F91\uFF1A\u4E0D\u662F\u8DD1\u51FA\u6765\u7684\uFF0C\u662F\u625B\u51FA\u6765\u7684\u3002\u591A\u5E74\u4F53\u529B\u52B3\u52A8\u7ED9\u4ED6\u7684\u6838\u5FC3\u529B\u91CF\u3001\u5BF9\u6297\u4E60\u60EF\u548C\u5BF9\u75BC\u75DB\u7684\u949D\u611F\uFF0C\u662F\u5065\u8EAB\u623F\u7EC3\u4E0D\u51FA\u7684\u54C1\u79CD\u3002\u961F\u53CB\u90A3\u53E5\u201C\u8E22\u7403\u50CF\u642C\u7816\u201D\u5176\u5B9E\u662F\u8912\u4E49\u2014\u2014\u9632\u5B88\u6CA1\u6709\u591A\u4F59\u82B1\u54E8\uFF0C\u94F2\u7403\u548C\u5934\u7403\u50CF\u4E00\u9053\u9053\u5DE5\u5E8F\uFF0C\u7B80\u5355\u3001\u76F4\u63A5\u3001\u6709\u6548\u3002\u672C\u520A\u63D0\u9192\uFF1A\u201C\u7B2C\u4E8C\u4EBA\u751F\u201D\u7403\u5458\u7684\u4F24\u75C5\u53F2\u8981\u5F80\u5165\u804C\u524D\u7FFB\uFF0C\u5DE5\u5730\u635F\u8017\u4E5F\u662F\u635F\u8017\u3002\u4F53\u68C0\uFF0C\u8BF7\u7FFB\u5230\u7B2C\u4E00\u9875\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4E00\u5F20\u662F\u8DD1\u51FA\u6765\u7684\u80BA\uFF0C\u4E00\u5F20\u662F\u625B\u51FA\u6765\u7684\u80CC\u3002"
        english: 
