    - layout: 1
      kicker:
        chineseSimplified: "\u9881\u5956\u8BCD\xB7\u4E0B"
        english: 
      headline:
        chineseSimplified: "\u5956\u9879\u516D\u81F3\u5341\uFF1A\u5766\u514B\u3001\u7F51\u7EA2\u4E0E\u68C0\u70B9\u95EE\u9898"
        english: 
