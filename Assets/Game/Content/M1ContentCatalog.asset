      bodyLeft:
        chineseSimplified: "\u8FD1\u8DDD\u79BB\u53CD\u5E94\u662F\u9876\u7EA7\u7684\uFF1A\u5355\u5200\u7403\u9762\u524D\uFF0C\u4ED6\u7684\u51FA\u51FB\u65F6\u673A\u50CF\u63D0\u524D\u8BFB\u4E86\u5C04\u95E8\u8005\u7684\u5FF5\u5934\u3002\u4E00\u7C73\u5185\u7684\u4E8C\u6B21\u6251\u6551\u5C24\u5176\u7F55\u89C1\uFF0C\u91CD\u5FC3\u4E22\u51FA\u53BB\u4E86\u8FD8\u80FD\u518D\u635E\u56DE\u6765\u3002\u6BD4\u7532\u5355\u5B63\u96F6\u5C01\u573A\u6B21\u7B2C\u4E00\uFF0C\u8FD9\u4E2A\u53E3\u5F84\u6211\u4EEC\u6838\u5BF9\u8FC7\u2014\u2014\u8D5B\u4E8B\u7EA7\u522B\u3001\u51FA\u573A\u5206\u949F\u3001\u70B9\u7403\u5360\u6BD4\u90FD\u7AD9\u5F97\u4F4F\u3002\u672C\u520A\u9996\u671F\u7684\u6838\u5BF9\u6E05\u5355\uFF0C\u4ED6\u5168\u8FC7\u4E86\u3002"
        english: 
