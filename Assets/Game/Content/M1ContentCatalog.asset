        chineseSimplified: "\u9A6C\u62C9\u677E\u540D\u6B21\uFF1A\u516C\u5F00\u53EF\u67E5\uFF0C\u5DF2\u6838\u3002\u534A\u804C\u4E1A\u8054\u8D5B\u753B\u9762\uFF1A\u82E5\u5E72\uFF0C\u5F3A\u5EA6\u6709\u9650\u3002\u7ED3\u8BBA\uFF1A\u80BA\u662F\u771F\u7684\uFF0C\u5176\u4F59\u6309\u534A\u6210\u54C1\u8BA1\u4EF7\u3002"
