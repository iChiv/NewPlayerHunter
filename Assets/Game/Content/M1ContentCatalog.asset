        english: 
      bodyLeft:
        chineseSimplified: "\u66FF\u8865\u7BA1\u7406\u7684\u5168\u90E8\u96BE\u70B9\u5728\u4E8E\uFF1A\u8BA9\u4E0D\u6BD4\u8D5B\u7684\u4EBA\u4FDD\u6301\u6BD4\u8D5B\u72B6\u6001\u3002\u5185\u90E8\u5BF9\u6297\u8D5B\u7684\u5F3A\u5EA6\u3001\u4E2A\u4EBA\u8BA1\u5212\u7684\u9488\u5BF9\u6027\u3001\u767B\u573A\u524D\u90A3\u5957\u56FA\u5B9A\u70ED\u8EAB\u6D41\u7A0B\uFF0C\u90FD\u662F\u4FDD\u9C9C\u6280\u672F\u3002\u5386\u53F2\u4E0A\u968F\u961F\u593A\u51A0\u5374\u957F\u671F\u5750\u677F\u51F3\u7684\u95E8\u5C06\u4EEC\u8BC1\u660E\u4E86\u53E6\u4E00\u4EF6\u4E8B\u2014\u2014\u5956\u676F\u4E0A\u4E5F\u6709\u66FF\u8865\u7684\u6307\u7EB9\uFF0C\u53EA\u662F\u5370\u5728\u63E1\u624B\u7684\u90A3\u4E00\u9762\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u534A\u51B3\u8D5B\u6362\u4EBA\u662F\u4E00\u573A\u63D0\u524D\u5F00\u59CB\u7684\u68CB\u5C40\uFF1A\u6362\u4EBA\u540D\u989D\u5BF9\u5E94\u4E0D\u540C\u65F6\u6BB5\uFF0C\u516D\u5341\u5206\u949F\u7684\u5BF9\u4F4D\u724C\u3001\u4E03\u5341\u4E94\u5206\u949F\u7684\u4F53\u80FD\u724C\u3001\u52A0\u65F6\u524D\u7684\u5FC3\u8DF3\u724C\u3002\u70B9\u7403\u9884\u6848\u66F4\u8981\u63D0\u524D\u5199\u597D\u987A\u5E8F\u2014\u2014\u5341\u4E8C\u7801\u51B3\u80DC\u4E0D\u662F\u62BD\u7B7E\u73AF\u8282\uFF0C\u662F\u5BB6\u5EAD\u4F5C\u4E1A\u7684\u68C0\u67E5\u73AF\u8282\u3002\u4E34\u573A\u624D\u7FFB\u4F5C\u4E1A\u672C\u7684\u4EBA\uFF0C\u901A\u5E38\u4E5F\u627E\u4E0D\u5230\u672C\u5B50\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u597D\u66FF\u8865\u4E0D\u662F\u8010\u5FC3\u7684\u4EBA\uFF0C\u662F\u968F\u65F6\u4E0D\u8010\u70E6\u4F46\u51C6\u5907\u597D\u4E86\u7684\u4EBA\u3002\u201D"
