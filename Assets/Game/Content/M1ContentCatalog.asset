        english: 
      bodyLeft:
        chineseSimplified: "\u534A\u51B3\u8D5B\u5468\u7684\u70B9\u7403\u6863\u6848\u5BA4\u603B\u4F1A\u70ED\u95F9\u8D77\u6765\uFF1A\u6251\u6551\u65B9\u5411\u7EDF\u8BA1\u3001\u4E3B\u7F5A\u4E60\u60EF\u3001\u52A9\u8DD1\u8282\u594F\u3002\u6574\u7406\u65F6\u8BF7\u628A\u4F20\u8BF4\u5F52\u5165\u6587\u5B66\u6863\u6848\u2014\u2014\u90A3\u4E2A\u201C\u4E00\u4E2A\u4E0B\u5348\u6251\u51FA\u4E94\u7C92\u70B9\u7403\u201D\u7684\u7ECF\u5178\u6848\u4F8B\uFF0C\u5B98\u65B9\u8BB0\u5F55\u662F\u56DB\u6B21\uFF0C\u7B2C\u4E94\u4F4D\u4E3B\u7F5A\u8005\u5728\u52A9\u8DD1\u524D\u8BF7\u4E86\u75C5\u5047\u3002\u6863\u6848\u6807\u7B7E\u5EFA\u8BAE\u5199\uFF1A\u597D\u542C\uFF0C\u4E0D\u53EF\u7528\u4E8E\u6218\u672F\u4F1A\u8BAE\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4E25\u8083\u90E8\u5206\uFF1A\u8BAD\u7EC3\u70B9\u7403\u7684\u547D\u4E2D\u7387\u4E0E\u6B63\u5F0F\u70B9\u7403\u662F\u4E24\u4E2A\u7269\u79CD\uFF0C\u4E2D\u95F4\u9694\u7740\u5FC3\u8DF3\u548C\u770B\u53F0\u7684\u566A\u97F3\u3002\u95E8\u5C06\u7814\u7A76\u7684\u662F\u8D8B\u52BF\uFF0C\u4E0D\u662F\u8BFB\u5FC3\u672F\uFF1B\u4E3B\u7F5A\u8005\u51C6\u5907\u7684\u662F\u9884\u6848\uFF0C\u4E0D\u662F\u52C7\u6C14\u3002\u5BB6\u5EAD\u4F5C\u4E1A\u505A\u5230\u4F4D\u7684\u4EBA\uFF0C\u63B7\u786C\u5E01\u65F6\u4E5F\u4F1A\u663E\u5F97\u6BD4\u8F83\u5E78\u8FD0\u3002\u6863\u6848\u5BA4\u91CC\u8FD8\u6709\u4E00\u53E5\u6279\u6CE8\uFF1A\u7EDF\u8BA1\u53E3\u5F84\u4E0D\u6E05\u7684\u6251\u6551\u53F2\uFF0C\u4E00\u5F8B\u6309\u75C5\u5047\u5904\u7406\u3002"
        english: 
