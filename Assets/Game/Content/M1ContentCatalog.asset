        chineseSimplified: "\u7535\u5B50\u5316\u6539\u9769\u5E74\u5E74\u63D0\u4E0A\u65E5\u7A0B\uFF0C\u5E74\u5E74\u8D25\u7ED9\u4EEA\u5F0F\u611F\u3002\u626B\u63CF\u4EF6\u7167\u6837\u8981\u6253\u5370\u51FA\u6765\u7B7E\u5B57\uFF0C\u518D\u626B\u63CF\u56DE\u53BB\u2014\u2014\u7EB8\u5F20\u88AB\u6DD8\u6C70\u4E86\uFF0C\u7EB8\u7684\u9B3C\u9B42\u8FD8\u5728\u6D41\u7A0B\u91CC\u4E0A\u73ED\u3002\u672C\u520A\u9884\u6D4B\uFF1A\u660E\u5E74\u6B64\u65F6\uFF0C\u4F1A\u6709\u4FF1\u4E50\u90E8\u5BA3\u5E03\u542F\u7528\u5168\u65B0\u6570\u5B57\u7CFB\u7EDF\uFF0C\u7136\u540E\u5728\u622A\u6B62\u591C\u5341\u4E00\u70B9\u534A\u91CD\u542F\u4F20\u771F\u673A\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6280\u672F\u4F1A\u8FDB\u6B65\uFF0C\u5361\u7EB8\u4F1A\u627E\u5230\u65B0\u7684\u5F62\u5F0F\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u5361\u7EB8\u524D\u5146"
        english: 
      sidebarBody:
        chineseSimplified: "\u7EB8\u76D2\u592A\u6EE1\u3001\u6587\u4EF6\u592A\u6025\u3001\u7ECF\u7EAA\u4EBA\u5728\u7535\u8BDD\u91CC\u558A\u201C\u9A6C\u4E0A\u5230\u201D\u3002\u4E09\u8005\u540C\u65F6\u51FA\u73B0\uFF0C\u8BF7\u6362\u4E00\u53F0\u3002"
