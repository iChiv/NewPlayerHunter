        chineseSimplified: "\u4E24\u56DE\u5408\u5236\u662F\u4E00\u9762\u8BDA\u5B9E\u7684\u955C\u5B50\uFF1A\u7B2C\u4E00\u56DE\u5408\u8BD5\u63A2\uFF0C\u7B2C\u4E8C\u56DE\u5408\u644A\u724C\uFF0C\u8054\u8D5B\u91CC\u80FD\u85CF\u4F4F\u7684\u4E1C\u897F\u5728\u8FD9\u91CC\u4F1A\u88AB\u56DE\u653E\u4E24\u904D\u3002\u4E00\u4E2A\u5931\u8BEF\u53EF\u4EE5\u5199\u8FDB\u6574\u5E74\u7EAA\u5F55\u7247\uFF0C\u4E00\u6B21\u6210\u529F\u7684\u9886\u5148\u63A7\u5236\u4E5F\u53EF\u4EE5\u2014\u2014\u53EA\u662F\u540E\u8005\u7684\u89C2\u4F17\u5C11\u5F97\u591A\u3002\u6559\u7EC3\u7EC4\u6700\u5E38\u72AF\u7684\u9519\u8BEF\uFF0C\u662F\u5728\u9996\u56DE\u5408\u5C31\u7528\u5B8C\u4E86\u6240\u6709\u60CA\u559C\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5BA2\u573A\u7B56\u7565\u7684\u771F\u76F8\u5F88\u6734\u7D20\uFF1A\u524D\u4E8C\u5341\u5206\u949F\u4E0D\u4E22\u7403\uFF0C\u6BD4\u8FDB\u4E00\u4E2A\u7403\u66F4\u6539\u53D8\u7CFB\u5217\u8D5B\u7684\u8D70\u5411\u3002\u9886\u5148\u7684\u7403\u961F\u7EC3\u4E60\u7684\u4E0D\u662F\u8FDB\u653B\uFF0C\u662F\u628A\u5BF9\u624B\u7684\u6025\u8E81\u517B\u5927\u3002\u672C\u520A\u63D0\u793A\uFF1A\u522B\u628A\u60AC\u5FF5\u5F53\u654C\u4EBA\uFF0C\u60AC\u5FF5\u662F\u7B2C\u4E8C\u56DE\u5408\u7684\u95E8\u7968\u6536\u5165\u3002\u81F3\u4E8E\u60F3\u4E00\u53E3\u6C14\u89E3\u51B3\u60AC\u5FF5\u7684\u7403\u961F\uFF0C\u5386\u53F2\u4E0A\u4ED6\u4EEC\u591A\u534A\u5728\u7B2C\u4E8C\u56DE\u5408\u6210\u4E86\u60AC\u5FF5\u672C\u8EAB\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6DD8\u6C70\u8D5B\u4E0D\u6DD8\u6C70\u8FD0\u6C14\uFF0C\u53EA\u6DD8\u6C70\u6CA1\u6709\u9884\u6848\u7684\u4EBA\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u9996\u56DE\u5408\u5B88\u5219"
        english: 
      sidebarBody:
        chineseSimplified: "\u522B\u628A\u60AC\u5FF5\u5F53\u654C\u4EBA\uFF1B\u522B\u4E3A\u96C6\u9526\u8E22\u5BA2\u573A\uFF1B\u6362\u4EBA\u540D\u989D\u7559\u7ED9\u52A0\u65F6\u8D5B\u7684\u53EF\u80FD\u3002"
