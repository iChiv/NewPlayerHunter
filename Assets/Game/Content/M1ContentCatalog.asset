        english: 
      sidebarBody:
        chineseSimplified: "\u7B7E\u5B57\u8D39\u3001\u4F63\u91D1\u3001\u5DE5\u8D44\u3001\u4F53\u68C0\u3001\u878D\u5165\u65F6\u95F4\u3002\u6700\u540E\u4E00\u9879\u6CA1\u6709\u53D1\u7968\uFF0C\u4F46\u6700\u8D35\u3002"
