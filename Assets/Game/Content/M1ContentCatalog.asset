        chineseSimplified: "\u7403\u63A2\u62A5\u544A"
        english: 
      headline:
        chineseSimplified: "\u83AB\u96F7\u62C9\uFF1A\u4E1A\u4F59\u8054\u8D5B\u7684\u597D\u597D\u5148\u751F"
        english: 
      deck:
        chineseSimplified: "\u52A9\u653B\u591A\u3001\u4EBA\u7F18\u597D\u3001\u9632\u5B88\u7C97\u7CD9\u2014\u2014\u4E1A\u4F59\u5E02\u573A\u7684\u6807\u51C6\u753B\u50CF\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u4F18\u70B9\u662F\u8089\u773C\u53EF\u89C1\u7684\u90A3\u79CD\uFF1A\u8FB9\u8DEF\u4F20\u4E2D\u8D28\u91CF\u5728\u4E1A\u4F59\u5C42\u9762\u51FA\u6311\uFF0C\u5B9A\u4F4D\u7403\u811A\u6CD5\u6709\u5185\u5BB9\uFF0C\u524D\u573A\u914D\u5408\u610F\u8BC6\u597D\uFF0C\u201C\u52A9\u653B\u5F88\u591A\u201D\u7684\u53E3\u7891\u4E0E\u6709\u9650\u7684\u753B\u9762\u6750\u6599\u80FD\u5BF9\u4E0A\u3002\u6027\u683C\u662F\u66F4\u8863\u5BA4\u8D44\u4EA7\uFF0C\u81EA\u5DF1\u627E\u4E0A\u95E8\u6765\u8C08\uFF0C\u52A8\u673A\u7EAF\u7CB9\uFF0C\u8981\u4EF7\u6734\u7D20\u3002\u5BF9\u9884\u7B97\u7D27\u5F20\u3001\u9700\u8981\u8FDB\u653B\u5957\u8DEF\u8865\u5145\u7684\u7403\u961F\uFF0C\u8BD5\u9519\u6210\u672C\u6781\u4F4E\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u77ED\u677F\u540C\u6837\u8089\u773C\u53EF\u89C1\uFF1A\u9632\u5B88\u7AEF\u7684\u9009\u4F4D\u548C\u5BF9\u6297\u90FD\u7C97\u7CD9\uFF0C\u8EAB\u540E\u7684\u8D70\u5ECA\u5E38\u5E74\u5F00\u653E\u3002\u4E1A\u4F59\u5230\u804C\u4E1A\u7684\u8DDD\u79BB\uFF0C\u6BD4\u4ED6\u7684\u4F20\u4E2D\u5F27\u7EBF\u5927\u5F97\u591A\u2014\u2014\u4F53\u80FD\u3001\u8282\u594F\u3001\u8EAB\u4F53\uFF0C\u6BCF\u4E00\u9879\u90FD\u8981\u91CD\u65B0\u8003\u8BD5\u3002\u201C\u961F\u53CB\u90FD\u559C\u6B22\u4ED6\u201D\u662F\u6E29\u6696\u7684\u8BC4\u4EF7\uFF0C\u4F46\u804C\u4E1A\u8DB3\u7403\u7684\u8003\u9898\u5199\u5728\u522B\u5904\u3002\u5EFA\u8BAE\u6D41\u7A0B\uFF1A\u5148\u8BD5\u8BAD\uFF0C\u5148\u77ED\u7EA6\uFF0C\u5148\u505A\u5177\u4F53\u7684\u68A6\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4EBA\u7F18\u5E2E\u4F60\u8FDB\u66F4\u8863\u5BA4\uFF0C\u9632\u5B88\u8BA9\u4F60\u7559\u5728\u540D\u5355\u91CC\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u6210\u672C\u6D4B\u7B97"
