        chineseSimplified: "\u6BCF 90 \u5206\u949F\u5C04\u95E8\u8D28\u91CF\uFF1B\u91CD\u5927\u673A\u4F1A\u8F6C\u5316\u7387\uFF1B\u5F3A\u5F3A\u5BF9\u8BDD\u6837\u672C\uFF1B\u6700\u8FD1\u4E00\u4E2A\u5B8C\u6574\u8D5B\u5B63\u3002"
