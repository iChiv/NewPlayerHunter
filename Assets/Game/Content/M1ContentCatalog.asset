        chineseSimplified: "\u7F3A\u5E2D\u6210\u672C\uFF1D\u66FF\u8865\u6EA2\u4EF7\uFF0B\u5E94\u6025\u9884\u6848\uFF0B\u66F4\u8863\u5BA4\u7126\u8651\u3002\u5168\u80FD\u6298\u73B0\uFF1D\u4F4D\u7F6E\u6570\xD7\u5355\u4F4D\u7F6E\u5747\u4EF7\xF7\u4F53\u80FD\u4E0A\u9650\u3002\u8BF7\u81EA\u884C\u4EE3\u5165\u3002"
