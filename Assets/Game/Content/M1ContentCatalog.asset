      deck:
        chineseSimplified: "\u51AC\u7A97\u7B7E\u7EA6\u7684\u871C\u6708\u671F\u4E0E\u9000\u8D27\u671F\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u4E3A\u4EC0\u4E48\u4ED6\u4E00\u7A7F\u6211\u4EEC\u7403\u8863\u5C31\u4E0D\u4F1A\u8E22\u4E86\uFF1F\u56E0\u4E3A\u7403\u5458\u4E0D\u662F\u5373\u63D2\u5373\u7528\u8BBE\u5907\uFF0C\u662F\u73AF\u5883\u4F9D\u8D56\u578B\u751F\u7269\uFF1A\u4F53\u7CFB\u3001\u8BED\u8A00\u3001\u57CE\u5E02\u3001\u66F4\u8863\u5BA4\u5EA7\u4F4D\u3001\u8BAD\u7EC3\u573A\u79BB\u5BB6\u7684\u8DDD\u79BB\uFF0C\u6BCF\u4E00\u9879\u90FD\u80FD\u5403\u6389\u4ED6\u4E00\u6210\u7684\u72B6\u6001\u3002\u51AC\u7A97\u4E70\u5BB6\u6700\u5E38\u72AF\u7684\u9519\u8BEF\uFF0C\u662F\u53EA\u8BC4\u4F30\u4E86\u7403\u5458\uFF0C\u6CA1\u6709\u8BC4\u4F30\u81EA\u5DF1\u63D0\u4F9B\u7684\u73AF\u5883\u3002\u73AF\u5883\u8BC4\u4F30\u5E76\u4E0D\u6BD4\u7403\u5458\u8BC4\u4F30\u4FBF\u5B9C\uFF0C\u4F46\u5B83\u6BD4\u89E3\u7EA6\u4FBF\u5B9C\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u89E3\u51B3\u65B9\u6848\u6734\u7D20\u5F97\u50CF\u8BF4\u660E\u4E66\uFF1A\u660E\u786E\u89D2\u8272\u3001\u5B89\u6392\u878D\u5165\u3001\u7ED9\u4ED6\u4E00\u4E2A\u80FD\u542C\u61C2\u4ED6\u73A9\u7B11\u7684\u961F\u53CB\u3002\u65B0\u63F4\u89C1\u9762\u4F1A\u7684\u7EC6\u8282\u4E5F\u8BF7\u6CE8\u610F\u2014\u2014\u7403\u8863\u5C55\u793A\u73AF\u8282\uFF0C\u4E09\u660E\u6CBB\u8BF7\u653E\u5728\u76D8\u5B50\u4FA7\u8FB9\uFF0C\u4E0D\u8981\u6321\u4F4F\u53F7\u7801\u3002\u672C\u520A\u672C\u8D5B\u5B63\u5DF2\u7ECF\u5728\u906E\u6321\u7269\u4E0A\u683D\u8FC7\u4E00\u6B21\u8DDF\u5934\u3002\u8F6C\u4F1A\u8D39\u53EF\u4EE5\u5206\u671F\uFF0C\u6559\u8BAD\u6700\u597D\u4E00\u6B21\u6027\u4ED8\u6E05\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u7403\u8863\u4E0D\u4F1A\u65BD\u6CD5\uFF0C\u53F7\u7801\u4E5F\u4E0D\u4F1A\uFF0C\u8BF7\u628A\u6CE8\u610F\u529B\u653E\u5728\u7403\u5458\u8EAB\u4E0A\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u878D\u5165\u6E05\u5355"
        english: 
      sidebarBody:
        chineseSimplified: "\u4F4F\u623F\u3001\u7FFB\u8BD1\u3001\u6218\u672F\u624B\u518C\u9875\u6570\u4E0A\u9650\u3001\u66F4\u8863\u5BA4\u5EA7\u4F4D\u3002\u53D1\u5E03\u4F1A\u4E09\u660E\u6CBB\u8BF7\u653E\u76D8\u5B50\u4FA7\u8FB9\u3002"
