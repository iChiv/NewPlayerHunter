        chineseSimplified: "\u76F2\u4FA7\u8DD1\u52A8\uFF1A\u8FDB\u7403\u53D1\u751F\u5728\u955C\u5934\u5916\u7684\u90A3\u4E00\u4FA7"
        english: 
      deck:
        chineseSimplified: "\u9632\u5B88\u8005\u7684\u80A9\u8180\u540E\u9762\uFF0C\u4F4F\u7740\u6574\u4E2A\u8D5B\u5B63\u7684\u5931\u7403\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u7EDF\u8BA1\u5458\u6570\u5F97\u6E05\u89E6\u7403\uFF0C\u6570\u4E0D\u6E05\u76F2\u4FA7\u3002\u4E00\u540D\u524D\u950B\u5728\u8FB9\u540E\u536B\u80A9\u540E\u542F\u52A8\u4E09\u6B21\uFF0C\u4E24\u6B21\u6CA1\u6709\u63A5\u5230\u7403\uFF0C\u7B2C\u4E09\u6B21\u4E0A\u4E86\u7B2C\u4E8C\u5929\u7684\u96C6\u9526\u2014\u2014\u524D\u4E24\u6B21\u624D\u662F\u7403\u63A2\u8BE5\u770B\u7684\u90E8\u5206\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u672C\u520A\u63D0\u9192\uFF1A\u96C6\u9526\u955C\u5934\u7684\u5BBD\u5EA6\u662F\u526A\u8F91\u5E08\u51B3\u5B9A\u7684\uFF0C\u7403\u573A\u7684\u5BBD\u5EA6\u4E0D\u662F\u3002\u770B\u4E0D\u89C1\u7684\u5730\u65B9\u51B3\u5B9A\u6BD4\u5206\uFF0C\u4E5F\u51B3\u5B9A\u62A5\u4EF7\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u9632\u5B88\u8005\u56DE\u5934\u7684\u90A3\u4E00\u523B\uFF0C\u8FDB\u653B\u5DF2\u7ECF\u53D1\u751F\u4E86\u4E00\u79D2\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u76F2\u4FA7\u5E38\u8BC6"
        english: 
      sidebarBody:
        chineseSimplified: "\u542F\u52A8\u5728\u80A9\u540E\u3001\u8DEF\u7EBF\u7ED5\u76F2\u533A\u3001\u4F20\u7403\u6765\u81EA\u5F31\u4FA7\u3002\u96C6\u9526\u91CC\u901A\u5E38\u53EA\u6709\u6700\u540E\u4E00\u9879\u6709\u753B\u9762\u3002"
