    - layout: 1
      kicker:
        chineseSimplified: "\u751F\u5B58\u6307\u5357"
        english: 
      headline:
        chineseSimplified: "\u591A\u9762\u624B\u7684\u771F\u5B9E\u4EF7\u683C\uFF1A\u4E00\u4EFD\u5DE5\u8D44\uFF0C\u4E09\u4EFD\u8BF4\u660E\u4E66"
        english: 
      deck:
        chineseSimplified: "\u5168\u80FD\u4E0E\u5168\u4E0D\u80FD\u4E4B\u95F4\uFF0C\u9694\u7740\u4E00\u573A\u6B63\u5F0F\u6BD4\u8D5B\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u591A\u9762\u624B\u884C\u60C5\u5728\u7D27\u7F29\u5468\u671F\u5FC5\u7136\u4E0A\u6DA8\uFF0C\u8BC4\u4F30\u65B9\u6CD5\u4E5F\u5FC5\u987B\u5347\u7EA7\uFF1A\u6BCF\u4E2A\u4F4D\u7F6E\u5355\u72EC\u8BC4\u7EA7\uFF0C\u5206\u5F00\u770B\u5F55\u50CF\u3002\u201C\u90FD\u80FD\u8E22\u201D\u548C\u201C\u90FD\u8E22\u8FC7\u201D\u662F\u4E24\u56DE\u4E8B\uFF0C\u5BA2\u4E32\u8FC7\u4E09\u573A\u8FB9\u540E\u536B\u4E0D\u4EE3\u8868\u4ED6\u80FD\u625B\u4F4F\u6574\u4E2A\u56DB\u6708\u3002\u4E00\u4EFD\u5DE5\u8D44\u4E70\u4E09\u4EFD\u8BF4\u660E\u4E66\u542C\u8D77\u6765\u5212\u7B97\uFF0C\u4F46\u8BF4\u660E\u4E66\u7684\u539A\u5EA6\u901A\u5E38\u548C\u8D28\u91CF\u6210\u53CD\u6BD4\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u98CE\u9669\u4E3B\u8981\u6709\u4E8C\uFF1A\u591A\u4F4D\u7F6E\u8F6E\u6362\u4F1A\u653E\u5927\u4F24\u75C5\uFF0C\u4ECA\u5929\u8865\u5DE6\u8DEF\u660E\u5929\u8865\u4E2D\u8DEF\u7684\u4EBA\uFF0C\u808C\u8089\u4E5F\u5728\u4E0D\u505C\u6362\u5DE5\u4F5C\uFF1B\u5176\u4E8C\u662F\u6218\u672F\u6A21\u7CCA\u6210\u672C\u2014\u2014\u54EA\u91CC\u7F3A\u4EBA\u8865\u54EA\u91CC\uFF0C\u6700\u540E\u53EF\u80FD\u54EA\u91CC\u90FD\u4E0D\u7F3A\u3001\u54EA\u91CC\u90FD\u4E0D\u7CBE\u3002\u7D27\u7F29\u7403\u961F\u7684\u6B63\u786E\u7528\u6CD5\u662F\uFF1A\u7ED9\u4ED6\u4E24\u4E2A\u56FA\u5B9A\u4F4D\u7F6E\uFF0C\u628A\u7B2C\u4E09\u4E2A\u4F4D\u7F6E\u7559\u7ED9\u771F\u6B63\u7684\u7D27\u6025\u72B6\u6001\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u80FD\u8865\u6240\u6709\u4F4D\u7F6E\u7684\u4EBA\uFF0C\u6700\u6015\u88AB\u5B89\u6392\u8865\u6240\u6709\u4F4D\u7F6E\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u6838\u5BF9\u91CD\u70B9"
        english: 
      sidebarBody:
        chineseSimplified: "\u6BCF\u4E2A\u4F4D\u7F6E\u81F3\u5C11\u4E00\u573A\u5B8C\u6574\u5F55\u50CF\uFF1B\u201C\u5BA2\u4E32\u8FC7\u201D\u4E0D\u7B49\u4E8E\u201C\u80FD\u80DC\u4EFB\u201D\uFF1B\u95E8\u5C06\u9664\u5916\uFF0C\u522B\u95EE\u4E3A\u4EC0\u4E48\u3002"
