        english: 
      deck:
        chineseSimplified: "\u4E00\u4E2A\u767D\u5929\u4E0A\u73ED\u665A\u4E0A\u7EC3\u7403\u3001\u4ECE\u4E0D\u5192\u9669\u7684\u4E2D\u573A\uFF0C\u548C\u4E00\u4E2A\u56E0\u8EAB\u9AD8\u88AB\u68AF\u961F\u653E\u5F03\u7684\u95E8\u5C06\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u4F5B\u6717\u54E5\xB7\u6BD4\u5B89\u5947\u7684\u8E22\u7403\u54F2\u5B66\u4E00\u53E5\u8BDD\u80FD\u8BF4\u5B8C\uFF1A\u6C38\u8FDC\u4E0D\u4F20\u7ED9\u53EF\u80FD\u4E22\u7684\u90A3\u4E2A\u4EBA\u3002\u6559\u7EC3\u7684\u8BC4\u4EF7\u8010\u4EBA\u5BFB\u5473\uFF1A\u201C\u4ED6\u4E0D\u4F1A\u521B\u9020\u673A\u4F1A\uFF0C\u4F46\u5F88\u5C11\u8BA9\u522B\u4EBA\u521B\u9020\u673A\u4F1A\u3002\u201D"
        english: 
      bodyRight:
        chineseSimplified: "\u7C73\u683C\u5C14\xB7\u7EB3\u74E6\u7F57\u7684\u5669\u68A6\u5199\u5728\u4F53\u68C0\u8868\u4E0A\uFF1A\u8EAB\u9AD8\u4E0D\u591F\uFF0C\u68AF\u961F\u518D\u89C1\u3002\u4F46\u4ED6\u7684\u51FA\u51FB\u6210\u529F\u7387\u6392\u5728\u897F\u73ED\u7259\u7B2C\u4E09\u7EA7\u522B\u7B2C\u4E00\u2014\u2014\u8001\u9E70\u6293\u9AD8\u7A7A\u7403\uFF0C\u9760\u7684\u662F\u8D77\u8DF3\u65F6\u673A\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u88AB\u4F4E\u4F30\u7684\u4EBA\u7684\u5171\u540C\u70B9\uFF1A\u7F3A\u70B9\u4E00\u773C\u89C1\u5E95\uFF0C\u4F18\u70B9\u8981\u7B97\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u672C\u5468\u6765\u4FE1"
        english: 
      sidebarBody:
        chineseSimplified: "\u6570\u636E\u4E4B\u5149\u4FF1\u4E50\u90E8\uFF1A\u201C\u53EA\u8981\u4EE5\u524D\u8FDB\u8FC7\u5F88\u591A\u7403\uFF0C\u628A\u5C65\u5386\u53D1\u6765\u5C31\u884C\u3002\u201D\u672C\u671F\u6CA1\u6709\u8FD9\u6837\u7684\u524D\u950B\uFF0C\u53EA\u6709\u4E24\u79CD\u66F4\u5B89\u9759\u7684\u7B54\u6848\u3002"
        english: 
