        chineseSimplified: "\u672B\u8F6E\u8FD8\u6709\u4E00\u79CD\u6697\u6218\uFF1A\u9886\u5148\u7684\u4E00\u65B9\u7EC3\u4E60\u63A7\u5236\uFF0C\u843D\u540E\u7684\u4E00\u65B9\u7EC3\u4E60\u68AD\u54C8\u3002\u524D\u8005\u9700\u8981\u6709\u4EBA\u628A\u8282\u594F\u964D\u4E0B\u6765\u3001\u628A\u7403\u62A4\u4F4F\u3001\u628A\u72AF\u89C4\u6311\u5728\u5BF9\u7684\u4F4D\u7F6E\uFF1B\u540E\u8005\u9700\u8981\u6709\u4EBA\u76F8\u4FE1\u4E5D\u5341\u5206\u949F\u591F\u7528\u3002\u4E24\u79CD\u6D3B\u90FD\u4E0D\u4E0A\u96C6\u9526\uFF0C\u4E24\u79CD\u6D3B\u90FD\u51B3\u5B9A\u8C01\u7EE7\u7EED\u4E0A\u73ED\u3001\u8C01\u5F00\u59CB\u89E3\u91CA\u8D5B\u5236\u3002"
