        english: 
      bodyLeft:
        chineseSimplified: "\u9884\u7B97\u8D8A\u5C11\uFF0C\u62A5\u544A\u8D8A\u77ED\uFF0C\u95EE\u9898\u8D8A\u8981\u51C6\uFF1A\u80FD\u4E0D\u80FD\u7ACB\u523B\u9996\u53D1\uFF1F\u4F24\u75C5\u53F2\u5982\u4F55\uFF1F\u5DE5\u8D44\u8981\u6C42\u591A\u5C11\uFF1F\u662F\u5426\u9002\u914D\u67D0\u4E00\u4E2A\u660E\u786E\u804C\u8D23\uFF1F\u56DB\u4E2A\u95EE\u9898\u7B54\u5B8C\uFF0C\u4E00\u9875\u7EB8\u5C31\u591F\u4E86\u3002\u7D27\u7F29\u65F6\u4EE3\u7684\u8C6A\u534E\u62A5\u544A\u662F\u4E00\u79CD\u6D6A\u8D39\uFF0C\u628A\u94B1\u82B1\u5728\u95EE\u9898\u4E0A\uFF0C\u4E0D\u662F\u82B1\u5728\u5F62\u5BB9\u8BCD\u4E0A\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u53EF\u5220\u9664\u5185\u5BB9\u6E05\u5355\uFF1A\u6F5C\u529B\u5F62\u5BB9\u8BCD\u3001\u4E94\u5E74\u89C4\u5212\u3001\u793E\u4EA4\u5A92\u4F53\u7C89\u4E1D\u6570\u3002\u672C\u8D5B\u5B63\u67D0\u4F4D\u56DB\u767E\u4E07\u7C89\u4E1D\u7684\u5019\u9009\u4EBA\u5DF2\u7ECF\u8BC1\u660E\uFF1A\u7C89\u4E1D\u4E0D\u4F1A\u5206\u644A\u5DE5\u8D44\uFF0C\u4E5F\u4E0D\u4F1A\u5728\u5BA2\u573A\u56DE\u8FFD\u3002\u62A5\u544A\u8D85\u51FA\u4E00\u9875\uFF0C\u8BF4\u660E\u4F60\u8FD8\u6CA1\u51B3\u5B9A\u5230\u5E95\u8981\u95EE\u4EC0\u4E48\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u9884\u7B97\u7D27\u5F20\u65F6\uFF0C\u6BCF\u4E00\u884C\u5E9F\u8BDD\u90FD\u662F\u652F\u51FA\u3002\u201D"
