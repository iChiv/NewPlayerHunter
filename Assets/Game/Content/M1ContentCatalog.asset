        chineseSimplified: "\u6280\u672F\uFF1A\u5DF2\u6838\uFF0C\u5C5E\u5B9E\u3002\u8EAB\u4F53\uFF1A\u5F85\u6838\uFF0C\u5173\u952E\u9879\u3002\u5FC3\u6001\uFF1A\u81EA\u8FF0\u201C\u8FD8\u60F3\u8E22\u201D\uFF0C\u5EFA\u8BAE\u5728\u5408\u540C\u91CC\u91CF\u5316\u8FD9\u4E2A\u201C\u60F3\u201D\u3002"
