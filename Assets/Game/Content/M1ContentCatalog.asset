        chineseSimplified: "\u95EE\u53F7\u4E5F\u6E05\u695A\uFF1A\u9635\u5730\u6218\u91CC\u5BF9\u65B9\u8FB9\u540E\u536B\u4E0D\u9000\u534A\u6B65\u65F6\uFF0C\u4ED6\u7684\u6837\u672C\u660E\u663E\u53D8\u8584\uFF1B\u65E0\u7403\u9632\u5B88\u6295\u5165\u5EA6\u968F\u6BD4\u5206\u8D77\u4F0F\u3002\u800C\u201C\u7ED9\u4ED6\u5341\u7C73\u7A7A\u95F4\u4F60\u6700\u597D\u76F4\u63A5\u72AF\u89C4\u201D\u7684\u53E6\u4E00\u9762\u662F\u2014\u2014\u8D8A\u6765\u8D8A\u591A\u5BF9\u624B\u771F\u7684\u9009\u62E9\u4E86\u72AF\u89C4\uFF0C\u4ED6\u5236\u9020\u5B9A\u4F4D\u7403\u540E\u7684\u51FA\u52E4\u7387\u9700\u8981\u5355\u72EC\u6838\u67E5\u3002"
