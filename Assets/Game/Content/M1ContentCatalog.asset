      bodyLeft:
        chineseSimplified: "\u542F\u52A8\u7B2C\u4E00\u6B65\u662F\u6559\u79D1\u4E66\u7EA7\u522B\uFF1A\u62FF\u7403\u3001\u6C89\u80A9\uFF0C\u4EBA\u5DF2\u7ECF\u5728\u4E00\u7C73\u5F00\u5916\u3002\u53CD\u51FB\u573A\u666F\u91CC\u4ED6\u4E00\u4E2A\u4EBA\u5C31\u662F\u4E00\u5957\u6218\u672F\uFF0C\u957F\u8DDD\u79BB\u5E26\u7403\u63A8\u8FDB\u65F6\uFF0C\u56DE\u8FFD\u7684\u540E\u536B\u770B\u8D77\u6765\u50CF\u5728\u8FDB\u884C\u53E6\u4E00\u79CD\u8FD0\u52A8\u3002\u7ECF\u7EAA\u56E2\u961F\u63D0\u4F9B\u7684\u96C6\u9526\u4E0E\u516C\u5F00\u5F55\u50CF\u53E3\u5F84\u4E00\u81F4\uFF0C\u901F\u5EA6\u4E00\u9879\u65E0\u9700\u5B58\u7591\u3002\u804C\u4E1A\u53E3\u7891\u4E0D\u9519\uFF0C\u8BAD\u7EC3\u51FA\u52E4\u7A33\u5B9A\u3002"
        english: 
