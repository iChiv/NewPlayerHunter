        chineseSimplified: "\u906E\u4F4F\u540D\u5B57\u770B\u6570\u636E\uFF0C\u906E\u4F4F\u6570\u636E\u770B\u540D\u5B57\uFF0C\u4E24\u904D\u90FD\u8981\u770B\u3002"
