      bodyLeft:
        chineseSimplified: "\u51AC\u6B47\u4F53\u68C0\u7684\u6B63\u786E\u6253\u5F00\u65B9\u5F0F\u662F\u7FFB\u65E7\u8D26\uFF1A\u8FDE\u7EED\u51FA\u573A\u7EAA\u5F55\u8981\u548C\u4F24\u75C5\u8BB0\u5F55\u5BF9\u7740\u770B\uFF0C\u201C\u5F02\u5E38\u5065\u5EB7\u201D\u7684\u7ED3\u8BBA\u8981\u6709\u533B\u9662\u62AC\u5934\u548C\u65E5\u671F\u3002\u94C1\u4EBA\u6807\u51C6\u7B2C\u4E00\u6761\u4E0D\u662F\u4ECE\u4E0D\u53D7\u4F24\uFF0C\u800C\u662F\u6BCF\u6B21\u5C0F\u4F24\u90FD\u6709\u5B8C\u6574\u7684\u56DE\u5F52\u65F6\u95F4\u8868\u3002\u51E1\u662F\u4F53\u68C0\u62A5\u544A\u6BD4\u7B80\u5386\u8FD8\u8584\u7684\u5019\u9009\u4EBA\uFF0C\u90FD\u503C\u5F97\u591A\u95EE\u4E00\u53E5\uFF1A\u8FD9\u4E9B\u5E74\u4F60\u90FD\u5728\u54EA\u513F\u505A\u7684\u68C0\u67E5\uFF1F"
        english: 
      bodyRight:
        chineseSimplified: "\u4E0E\u4F53\u68C0\u62A5\u544A\u4E00\u8D77\u62B5\u8FBE\u7684\uFF0C\u8FD8\u6709\u4EB2\u621A\u6761\u6B3E\u7C7B\u63A8\u8350\u3002\u6BCF\u9022\u7A97\u53E3\uFF0C\u201C\u4ECE\u5C0F\u770B\u7740\u957F\u5927\u201D\u7684\u8BC1\u660E\u6750\u6599\u5C31\u51C6\u65F6\u52A0\u539A\u3002\u672C\u520A\u7ACB\u573A\u4E0D\u53D8\uFF1A\u4EB2\u5C5E\u53EF\u4EE5\u63A8\u8350\uFF0C\u4F46\u4E0D\u80FD\u4F5C\u8BC1\u3002\u4E0A\u4E00\u4EFD\u7531\u53D4\u53D4\u8F6C\u4EA4\u7684\u5F71\u50CF\u8D44\u6599\u91CC\uFF0C\u5173\u952E\u753B\u9762\u88AB\u4E00\u5757\u4E09\u660E\u6CBB\u6321\u4F4F\u4E86\u53F7\u7801\uFF1B\u8FD9\u4E00\u4EFD\uFF0C\u6211\u4EEC\u5EFA\u8BAE\u81F3\u5C11\u628A\u4E09\u660E\u6CBB\u632A\u5F00\u518D\u8BC4\u4F30\u3002"
