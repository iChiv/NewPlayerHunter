        chineseSimplified: "18\u516C\u91CC\uFF1A\u8FFD\u8E2A\u6570\u636E\uFF0C\u5DF2\u6838\u3002\u8986\u76D6\u8D5B\u5B63\uFF1A\u6700\u8FD1\u4E24\u5B63\u3002\u5F85\u67E5\u9879\uFF1A\u5BC6\u96C6\u8D5B\u7A0B\u4E0B\u7684\u5F3A\u5EA6\u66F2\u7EBF\u3002\u590D\u6D4B\u7A97\u53E3\uFF1A\u51AC\u6B47\u524D\u3002"
