    - layout: 2
      kicker:
        chineseSimplified: "\u7403\u63A2\u62A5\u544A"
        english: 
      headline:
        chineseSimplified: "\u6BD4\u5B89\u5947\uFF1A\u4E0D\u4E22\u7403\uFF0C\u662F\u4ED6\u7684\u5168\u90E8\u6218\u672F"
        english: 
      deck:
        chineseSimplified: "\u767D\u5929\u5728\u5C0F\u4F01\u4E1A\u4E0A\u73ED\uFF0C\u665A\u4E0A\u8BAD\u7EC3\uFF0C\u4F20\u7403\u9009\u62E9\u4FDD\u5B88\u5230\u6781\u81F4\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u6BD4\u8D5B\u7EAA\u5F8B\u6027\u6781\u5F3A\uFF1A\u4F4D\u7F6E\u611F\u597D\uFF0C\u51FA\u7403\u6C38\u8FDC\u9009\u6700\u5B89\u5168\u7684\u90A3\u6761\u7EBF\uFF0C\u5931\u8BEF\u7387\u4F4E\u5230\u6559\u7EC3\u613F\u610F\u4E3A\u4ED6\u6539\u6218\u672F\u677F\u3002\u4F5C\u4E3A\u534A\u804C\u4E1A\u7403\u5458\uFF0C\u8BAD\u7EC3\u51FA\u52E4\u548C\u6BD4\u8D5B\u6001\u5EA6\u65E0\u53EF\u6311\u5254\uFF0C\u6027\u683C\u6E29\u548C\uFF0C\u662F\u66F4\u8863\u5BA4\u7684\u7A33\u5B9A\u56E0\u7D20\u3002\u5BF9\u9884\u7B97\u6709\u9650\u3001\u5148\u8981\u201C\u522B\u518D\u7A00\u91CC\u7CCA\u6D82\u4E22\u7403\u201D\u7684\u7403\u961F\uFF0C\u4ED6\u662F\u5373\u63D2\u5373\u7528\u7684\u6B62\u8840\u5E26\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8FDB\u653B\u8D21\u732E\u63A5\u8FD1\u96F6\uFF1A\u4E0D\u5192\u9669\u610F\u5473\u7740\u4E0D\u521B\u9020\uFF0C\u5411\u524D\u4F20\u7403\u7684\u6BD4\u4F8B\u4F4E\u5F97\u4F1A\u8BA9\u8FDB\u653B\u6559\u7EC3\u5931\u7720\u3002\u534A\u804C\u4E1A\u5230\u804C\u4E1A\u7684\u5F3A\u5EA6\u8DE8\u8D8A\u662F\u6700\u5927\u95EE\u53F7\uFF0C\u4ED6\u4ECE\u672A\u88AB\u771F\u6B63\u7684\u9AD8\u538B\u903C\u62A2\u68C0\u9A8C\u8FC7\u3002\u767D\u5929\u4E0A\u73ED\u7684\u5408\u540C\u7ED3\u6784\u4E5F\u610F\u5473\u7740\u4F53\u80FD\u50A8\u5907\u6709\u9650\u3002\u4ED6\u662F\u4E0B\u9650\u578B\u7B7E\u7EA6\u2014\u2014\u522B\u5E7B\u60F3\u4E0A\u9650\uFF0C\u4E0A\u9650\u4E0D\u5728\u4ED6\u8EAB\u4E0A\uFF0C\u5728\u4F60\u7684\u524D\u950B\u8EAB\u4E0A\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u4E0D\u521B\u9020\u673A\u4F1A\uFF0C\u4E5F\u4E0D\u521B\u9020\u707E\u96BE\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u4FE1\u606F\u6838\u5B9E"
        english: 
      sidebarBody:
        chineseSimplified: "\u6559\u7EC3\u8BC4\u8BED\u201C\u5F88\u5C11\u8BA9\u522B\u4EBA\u521B\u9020\u673A\u4F1A\u201D\u672A\u7ECF\u72EC\u7ACB\u6838\u5B9E\uFF0C\u4F46\u4E0E\u6BD4\u8D5B\u753B\u9762\u5BF9\u5F97\u4E0A\u3002\u8BC1\u636E\u7B49\u7EA7\uFF1A\u53EF\u4FE1\uFF0C\u5F85\u5F3A\u5EA6\u590D\u6D4B\u3002"
