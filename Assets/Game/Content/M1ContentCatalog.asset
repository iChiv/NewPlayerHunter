        chineseSimplified: "\u542F\u52A8\u65F6\u673A\u3001\u5BF9\u4F20\u7403\u8005\u89C6\u7EBF\u7684\u5229\u7528\u3001\u63A5\u7403\u524D\u6700\u540E\u4E24\u6B65\u7684\u89D2\u5EA6\u3002"
