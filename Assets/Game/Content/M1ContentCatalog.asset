      bodyLeft:
        chineseSimplified: "\u8FEA\u5965\u6208\xB7\u4F69\u96F7\u62C9\u5728\u4E94\u4EBA\u5236\u8D5B\u573A\u662F\u53E6\u4E00\u79CD\u751F\u7269\uFF1A\u91CD\u5FC3\u4F4E\u3001\u53D8\u5411\u5FEB\uFF0C\u7403\u50CF\u7C98\u5728\u811A\u4E0A\u3002\u7403\u63A2\u62A5\u544A\u91CC\u5199\u7740\u672C\u671F\u6700\u7F8E\u7684\u4E00\u53E5\u8BDD\uFF1A\u201C\u4ED6\u6700\u5371\u9669\u7684\u65F6\u5019\uFF0C\u662F\u6CA1\u4EBA\u77E5\u9053\u4ED6\u51C6\u5907\u5E72\u4EC0\u4E48\u7684\u65F6\u5019\u3002\u201D"
        english: 
      bodyRight:
        chineseSimplified: "\u5361\u6D1B\u65AF\xB7\u5BCC\u6069\u7279\u65AF\u8D70\u7684\u662F\u53E6\u4E00\u6761\u8DEF\uFF1A\u5730\u533A\u8054\u8D5B\u4E00\u7EA7\u4E00\u7EA7\u8E22\u4E0A\u6765\uFF0C\u8FC7\u53BB\u4E94\u4E2A\u8D5B\u5B63\u8FDB\u7403\u5168\u90E8\u4E0A\u53CC\u3002\u6CA1\u6709\u9B54\u6CD5\uFF0C\u53EA\u6709\u5230\u8D26\u8BB0\u5F55\u3002\u9884\u7B97\u578B\u4E70\u5BB6\u8BF7\u6CE8\u610F\uFF1A\u8FD9\u4E2A\u540D\u5B57\u503C\u5F97\u6284\u4E0B\u6765\u3002"
