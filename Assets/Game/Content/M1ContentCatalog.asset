        chineseSimplified: "\u6A59\u8272\u7403\u961F\uFF1A\u5BFB\u7EC4\u7EC7\u578B\u95E8\u5C06\u3002\u4E1C\u4E9A\u65B9\u5411\uFF1A\u5BFB\u201C90\u5206\u949F\u540E\u8FD8\u80FD\u8DD1\u201D\u7684\u524D\u950B\u3002\u62DB\u8058\u542F\u4E8B\u8D8A\u6765\u8D8A\u50CF\u4F53\u6D4B\u901A\u77E5\u3002"
