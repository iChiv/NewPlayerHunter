        english: 
      deck:
        chineseSimplified: "\u6280\u672F\u666E\u901A\uFF0C\u7EED\u822A\u79BB\u8C31\u3002\u6709\u4E9B\u7403\u961F\u7F3A\u7684\u6070\u6070\u662F\u8FD9\u79CD\u7403\u5458\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u8DD1\u52A8\u80FD\u529B\u662F\u7B80\u5386\u91CC\u552F\u4E00\u52A0\u7C97\u7684\u90E8\u5206\uFF0C\u4E5F\u786E\u5B9E\u7ECF\u5F97\u8D77\u52A0\u7C97\uFF1A\u6BD4\u8D5B\u672B\u6BB5\u7684\u9AD8\u901F\u51B2\u523A\u4E0D\u89C1\u8870\u51CF\uFF0C\u52A0\u65F6\u8D5B\u8FD8\u80FD\u5B8C\u6210\u7EB5\u6DF1\u63D2\u4E0A\u3002\u8BAD\u7EC3\u4E2D\u7684\u8010\u529B\u53E3\u7891\u4ECE\u9752\u8BAD\u4E00\u8DEF\u5E26\u5230\u6210\u5E74\u961F\uFF0C\u5C0F\u5B66\u4F53\u80B2\u8001\u5E08\u201C\u4ED6\u4ECE\u5C0F\u53C2\u52A0\u957F\u8DD1\u201D\u7684\u8BC1\u8BCD\u4E0E\u73B0\u6709\u8868\u73B0\u4E92\u76F8\u5370\u8BC1\u3002\u5BF9\u4EE5\u4F53\u80FD\u6362\u673A\u4F1A\u7684\u7403\u961F\uFF0C\u4ED6\u662F\u5373\u63D2\u5373\u7528\u7684\u6D88\u8017\u54C1\u2014\u2014\u8912\u4E49\u7684\u90A3\u79CD\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8DD1\u52A8\u4E4B\u5916\u7684\u90E8\u5206\u90FD\u504F\u8584\uFF1A\u5C04\u672F\u5E73\u5E73\uFF0C\u80CC\u8EAB\u4E0E\u505A\u7403\u80FD\u529B\u4E00\u822C\uFF0C\u673A\u4F1A\u8F6C\u5316\u7ECF\u5E38\u5BF9\u4E0D\u8D77\u81EA\u5DF1\u8DD1\u51FA\u6765\u7684\u8DDD\u79BB\u3002\u201C\u6C38\u52A8\u673A\u201D\u578B\u524D\u950B\u7684\u4F7F\u7528\u8BF4\u660E\u5F88\u82DB\u523B\u2014\u2014\u7403\u961F\u5FC5\u987B\u5148\u80FD\u9020\u51FA\u503C\u5F97\u4ED6\u8DD1\u7684\u5C40\u9762\u3002\u82E5\u6307\u671B\u4ED6\u89E3\u51B3\u8FDB\u7403\u95EE\u9898\uFF0C\u90A3\u662F\u8BA9\u53D1\u52A8\u673A\u53BB\u5E72\u65B9\u5411\u76D8\u7684\u6D3B\u3002"
        english: 
