      deck:
        chineseSimplified: "\u4E00\u4F4D\u62FF\u7740\u51A0\u519B\u5956\u724C\u5374\u5E38\u5E74\u5750\u677F\u51F3\u7684\u95E8\u5C06\uFF0C\u548C\u4E00\u4F4D\u9EC4\u724C\u6BD4\u8FDB\u7403\u591A\u7684\u8FB9\u540E\u536B\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u6B27\u6587\xB7\u54C8\u91CC\u65AF\u7684\u5C65\u5386\u6709\u4E2A\u53CD\u76F4\u89C9\u7684\u6CE8\u811A\uFF1A\u676F\u8D5B\u51A0\u519B\u6210\u5458\uFF0C\u957F\u671F\u66FF\u8865\u3002\u4ED6\u7684\u4EF7\u503C\u5199\u5728\u522B\u4EBA\u7684\u8868\u73B0\u91CC\u2014\u2014\u4E3B\u529B\u95E8\u5C06\u72B6\u6001\u795E\u52C7\u7684\u90A3\u4E9B\u5E74\uFF0C\u8BAD\u7EC3\u573A\u7684\u6807\u51C6\u662F\u4ED6\u5B9A\u7684\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u9C81\u4F0A\xB7\u5361\u591A\u7D22\u7684\u7EDF\u8BA1\u9875\u5219\u662F\u53E6\u4E00\u79CD\u5947\u89C2\uFF1A\u8FDE\u7EED\u4E24\u4E2A\u8D5B\u5B63\u8054\u8D5B\u9EC4\u724C\u738B\u3002\u9632\u5B88\u4FB5\u7565\u6027\u62C9\u6EE1\uFF0C\u7981\u8D5B\u8BB0\u5F55\u540C\u6837\u62C9\u6EE1\u3002\u9884\u7B97\u8054\u672C\u5468\u5728\u627E\u201C\u4F4E\u6210\u672C\u9AD8\u4EA7\u5C04\u624B\u201D\u2014\u2014\u8FD9\u4E24\u4F4D\u90FD\u4E0D\u662F\u5C04\u624B\uFF0C\u4F46\u201C\u9AD8\u4EA7\u201D\u8FD9\u4E2A\u8BCD\uFF0C\u9EC4\u724C\u699C\u4E0A\u90A3\u4F4D\u5F88\u719F\u3002"
        english: 
      pullQuote:
