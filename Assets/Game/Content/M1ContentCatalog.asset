        english: 
      deck:
        chineseSimplified: "\u66FF\u8865\u95E8\u5C06\u662F\u8DB3\u7403\u91CC\u6700\u8D35\u7684\u5962\u4F88\u54C1\uFF0C\u76F4\u5230\u4ED6\u7A81\u7136\u53D8\u6210\u5FC5\u9700\u54C1\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u4E00\u652F\u7403\u961F\u6BCF\u5E74\u5728\u7B2C\u4E8C\u95E8\u5C06\u8EAB\u4E0A\u82B1\u7684\u94B1\uFF0C\u770B\u8D77\u6765\u50CF\u7ED9\u7A7A\u5EA7\u4F4D\u4E70\u7968\u3002\u76F4\u5230\u4E3B\u529B\u95E8\u5C06\u53D7\u4F24\u90A3\u4E00\u5468\uFF0C\u6574\u4E2A\u8D5B\u5B63\u7A81\u7136\u62BC\u5728\u90A3\u4E2A\u5750\u4E86\u4E00\u5E74\u677F\u51F3\u7684\u4EBA\u8EAB\u4E0A\u2014\u2014\u8FD9\u65F6\u5019\u518D\u8D35\u7684\u5DE5\u8D44\u90FD\u663E\u5F97\u4FBF\u5B9C\u3002\u597D\u7684\u7B2C\u4E8C\u95E8\u5C06\u662F\u7A00\u6709\u54C1\u79CD\uFF1A\u6C34\u5E73\u8981\u63A5\u8FD1\u4E3B\u529B\uFF0C\u5FC3\u6001\u8981\u63A5\u53D7\u66FF\u8865\uFF0C\u8BAD\u7EC3\u8981\u7EF4\u6301\u6807\u51C6\uFF0C\u51FA\u573A\u8981\u5373\u63D2\u5373\u7528\u3002\u56DB\u6761\u540C\u65F6\u6EE1\u8DB3\u7684\u4EBA\uFF0C\u5E02\u573A\u4E0A\u5C48\u6307\u53EF\u6570\u3002\u54C8\u91CC\u65AF\u7684\u51A0\u519B\u5956\u724C\u548C\u591A\u5E74\u66FF\u8865\u5C65\u5386\u6070\u597D\u8BF4\u660E\uFF1A\u4ED6\u65E9\u5C31\u5B66\u4F1A\u4E86\u8FD9\u95E8\u53CD\u4EBA\u6027\u7684\u624B\u827A\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u9EC4\u724C\u6536\u85CF\u5BB6\u5219\u662F\u53E6\u4E00\u79CD\u6210\u672C\u6838\u7B97\u3002\u4FB5\u7565\u6027\u662F\u4ED6\u7684\u4EA7\u54C1\uFF0C\u7981\u8D5B\u662F\u4EA7\u54C1\u7684\u8FD0\u8D39\u2014\u2014\u8FDE\u7EED\u4E24\u4E2A\u8D5B\u5B63\u9EC4\u724C\u738B\uFF0C\u610F\u5473\u7740\u6BCF\u4E2A\u8D5B\u5B63\u90FD\u6709\u51E0\u573A\u6BD4\u8D5B\uFF0C\u4F60\u7684\u8FB9\u8DEF\u8981\u81EA\u5DF1\u60F3\u529E\u6CD5\u3002\u7B97\u8D26\u7684\u6B63\u786E\u65B9\u5F0F\u4E0D\u662F\u95EE\u201C\u4ED6\u4F1A\u4E0D\u4F1A\u505C\u8D5B\u201D\uFF0C\u800C\u662F\u95EE\u201C\u505C\u8D5B\u90A3\u51E0\u573A\u4E22\u591A\u5C11\u5206\uFF0C\u5728\u573A\u90A3\u51E0\u573A\u62A2\u591A\u5C11\u5206\u201D\u3002\u5982\u679C\u540E\u8005\u66F4\u5927\uFF0C\u9EC4\u724C\u5C31\u662F\u7A0E\u800C\u4E0D\u662F\u75C5\u3002\u5F53\u7136\uFF0C\u7A0E\u7387\u9AD8\u5230\u5F71\u54CD\u73B0\u91D1\u6D41\u65F6\uFF0C\u8D22\u653F\u518D\u5065\u5EB7\u7684\u4FF1\u4E50\u90E8\u4E5F\u8BE5\u8003\u8651\u8F6C\u578B\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u66FF\u8865\u7684\u4EF7\u503C\u5E73\u65F6\u770B\u4E0D\u89C1\uFF0C\u770B\u53F0\u770B\u5F97\u6700\u6E05\u3002"
