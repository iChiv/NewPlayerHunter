        english: 
      bodyLeft:
        chineseSimplified: "\u51B3\u8D5B\u5468\u7684\u51B7\u9759\u4E0D\u662F\u5FC3\u6001\u8BFE\u7A0B\uFF0C\u662F\u540E\u52E4\u5DE5\u7A0B\uFF1A\u7761\u7720\u7EDF\u4E00\u3001\u5A92\u4F53\u9694\u79BB\u3001\u8BAD\u7EC3\u8282\u594F\u4E0D\u4E34\u65F6\u52A0\u620F\u3001\u5BB6\u5C5E\u95E8\u7968\u5B89\u6392\u5728\u4E0D\u788D\u4E8B\u7684\u770B\u53F0\u3002\u628A\u6FC0\u52A8\u5217\u5165\u65E5\u7A0B\u8868\uFF0C\u6392\u5728\u51B3\u8D5B\u4E4B\u540E\u2014\u2014\u8FD9\u662F\u6240\u6709\u51A0\u519B\u961F\u7684\u5171\u540C\u7ECF\u9A8C\uFF0C\u867D\u7136\u53D1\u5E03\u4F1A\u4E0A\u7684\u8BF4\u6CD5\u6C38\u8FDC\u662F\u201C\u5E73\u5E38\u5FC3\u201D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u53CD\u9762\u6559\u6750\u7684\u6E05\u5355\u6BCF\u5E74\u90FD\u4E00\u6837\uFF1A\u51B3\u8D5B\u524D\u63A5\u53D7\u56DB\u5341\u5206\u949F\u4E2A\u4EBA\u4E13\u8BBF\u3001\u5B98\u5BA3\u7EED\u7EA6\u8C08\u5224\u3001\u53D1\u5E03\u4E2A\u4EBA\u54C1\u724C\u8054\u540D\u3002\u4E09\u4EF6\u4E8B\u90FD\u53EF\u4EE5\u505A\uFF0C\u4E5F\u90FD\u53EF\u4EE5\u7B49\u3002\u51B3\u8D5B\u5468\u7684\u4F18\u5148\u7EA7\u6392\u5E8F\u80FD\u529B\u662F\u51A0\u519B\u7684\u9690\u5F62\u6280\u80FD\u70B9\u2014\u2014\u7403\u8863\u5546\u5E97\u9664\u5916\uFF0C\u4ED6\u4EEC\u9009\u62E9\u672C\u5468\u4E0A\u65B0\uFF0C\u5E76\u4E14\u4ECE\u4E0D\u9700\u8981\u4F53\u80FD\u6559\u7EC3\u7B7E\u5B57\u3002"
