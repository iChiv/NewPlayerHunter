        chineseSimplified: "\u70B9\u7403\u5FC3\u7406\u5B66\uFF1A\u52A9\u8DD1\u3001\u773C\u795E\u4E0E\u75C5\u5047\u6761"
        english: 
      deck:
        chineseSimplified: "\u95E8\u5C06\u8BFB\u4EBA\uFF0C\u4E3B\u7F5A\u8005\u8BFB\u95E8\u5C06\uFF0C\u5FC3\u7406\u5B66\u5BB6\u8BFB\u79D2\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u70B9\u7403\u662F\u4E00\u573A\u53CC\u5411\u7684\u9605\u8BFB\uFF1A\u95E8\u5C06\u8BFB\u52A9\u8DD1\u8282\u594F\u548C\u652F\u6491\u811A\uFF0C\u4E3B\u7F5A\u8005\u8BFB\u95E8\u5C06\u7684\u7AD9\u4F4D\u6697\u793A\uFF0C\u5FC3\u7406\u5B66\u5BB6\u5728\u573A\u8FB9\u8BFB\u79D2\u3002\u7ECF\u5178\u6559\u5B66\u6848\u4F8B\u4ECD\u5728\u6D41\u4F20\uFF1A\u67D0\u95E8\u5C06\u53F7\u79F0\u4E00\u4E0B\u5348\u4E94\u8FDE\u6251\uFF0C\u7B2C\u4E94\u4F4D\u4E3B\u7F5A\u8005\u56E0\u201C\u7A81\u53D1\u4E0D\u9002\u201D\u672A\u80FD\u51FA\u573A\u2014\u2014\u5FC3\u7406\u6218\u7684\u6700\u9AD8\u5883\u754C\uFF0C\u662F\u8BA9\u5BF9\u624B\u5728\u52A9\u8DD1\u4E4B\u524D\u5C31\u533B\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u95E8\u5C06\u4E00\u4FA7\u7684\u6B63\u7ECF\u51C6\u5907\u5305\u62EC\uFF1A\u65B9\u5411\u8D8B\u52BF\u5361\u3001\u5EF6\u8FDF\u542F\u52A8\u7684\u8010\u5FC3\u3001\u4EE5\u53CA\u6251\u9519\u65B9\u5411\u540E\u7684\u60C5\u7EEA\u590D\u4F4D\u3002\u70B9\u7403\u5927\u6218\u91CC\u6700\u5927\u7684\u654C\u4EBA\u4E0D\u662F\u4E0A\u4E00\u4E2A\u8FDB\u7403\u7684\u4EBA\uFF0C\u662F\u4E0A\u4E00\u4E2A\u81EA\u5DF1\u6CA1\u6251\u5230\u7684\u7403\u3002\u8D44\u6599\u53EF\u4EE5\u6253\u5370\uFF0C\u9547\u5B9A\u53EA\u80FD\u9884\u88C5\uFF0C\u800C\u4E14\u9884\u88C5\u73AF\u5883\u901A\u5E38\u5728\u8D5B\u524D\u4E00\u5468\u7684\u6BCF\u4E00\u4E2A\u666E\u901A\u5468\u4E8C\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6251\u70B9\u4E0D\u662F\u9760\u731C\uFF0C\u662F\u9760\u8BA9\u5BF9\u65B9\u4EE5\u4E3A\u81EA\u5DF1\u88AB\u731C\u4E2D\u4E86\u3002\u201D"
        english: 
