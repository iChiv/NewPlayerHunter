      deck:
        chineseSimplified: "\u77ED\u671F\u8BD5\u8BAD\u7684\u89C2\u5BDF\u8FB9\u754C\u4E0E\u5E38\u89C1\u9519\u89C9\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u4E09\u5929\u8BD5\u8BAD\u80FD\u770B\u6E05\u7684\u4E8B\u60C5\u4E0D\u5C11\uFF1A\u8EAB\u4F53\u72B6\u6001\u3001\u8BAD\u7EC3\u6001\u5EA6\u3001\u57FA\u672C\u6280\u672F\u7684\u6210\u8272\uFF0C\u4EE5\u53CA\u4ED6\u662F\u5426\u8FD8\u613F\u610F\u505A\u4E0D\u663E\u773C\u7684\u5DE5\u4F5C\u2014\u2014\u56DE\u8FFD\u3001\u8865\u4F4D\u3001\u7ED9\u5E74\u8F7B\u961F\u53CB\u591A\u4F20\u4E00\u811A\u8212\u670D\u7684\u7403\u3002\u201C\u8FD8\u80FD\u4E0D\u80FD\u8E22\u201D\u8FD9\u4E2A\u95EE\u9898\uFF0C\u5176\u5B9E\u7B2C\u4E8C\u5929\u4E0B\u5348\u5C31\u6709\u7B54\u6848\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u770B\u4E0D\u6E05\u7684\u662F\u53E6\u4E00\u534A\uFF1A\u6218\u672F\u7406\u89E3\u9700\u8981\u6B63\u5F0F\u6BD4\u8D5B\uFF0C\u6297\u538B\u9700\u8981\u6BD4\u5206\u843D\u540E\uFF0C\u6027\u683C\u9700\u8981\u4E00\u6B21\u51B2\u7A81\u3002\u8BD5\u8BAD\u8868\u73B0\u597D\u4E0D\u7B49\u4E8E\u6BD4\u8D5B\u8868\u73B0\u597D\uFF0C\u65B0\u73AF\u5883\u4EBA\u4EBA\u90FD\u6709\u4E09\u5929\u871C\u6708\u3002\u5EFA\u8BAE\u7528\u77ED\u7EA6\u52A0\u6761\u6B3E\u5BF9\u51B2\uFF0C\u628A\u5224\u65AD\u6743\u7559\u4E00\u90E8\u5206\u7ED9\u6625\u5929\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u8BD5\u8BAD\u80FD\u9A8C\u8BC1\u6000\u7591\uFF0C\u4E0D\u80FD\u66FF\u4EE3\u6000\u7591\u3002\u201D"
        english: 
