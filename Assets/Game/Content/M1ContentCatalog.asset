        chineseSimplified: "\u9886\u5BFC\u529B\u662F\u53EF\u89C2\u5BDF\u7684\uFF1A\u9632\u7EBF\u7AD9\u4F4D\u9760\u4ED6\u558A\u8BDD\u7EF4\u6301\uFF0C\u4E22\u7403\u540E\u7684\u7B2C\u4E00\u53CD\u5E94\u662F\u7EC4\u7EC7\u800C\u4E0D\u662F\u62B1\u6028\u3002\u8461\u8404\u7259\u7B2C\u4E09\u3001\u7B2C\u56DB\u7EA7\u522B\u8F97\u8F6C\u516B\u961F\uFF0C\u6BCF\u5230\u4E00\u5904\u90FD\u6234\u4E0A\u8896\u6807\uFF0C\u8BF4\u660E\u66F4\u8863\u5BA4\u6295\u7968\u5E38\u5E74\u6709\u6548\u3002\u7ECF\u9A8C\u8986\u76D6\u4FDD\u7EA7\u3001\u5347\u7EA7\u3001\u676F\u8D5B\u7206\u51B7\u7B49\u5404\u79CD\u5267\u672C\u3002\u5BF9\u5E74\u8F7B\u7403\u961F\uFF0C\u4ED6\u76F8\u5F53\u4E8E\u534A\u4E2A\u52A9\u7406\u6559\u7EC3\uFF0C\u8FD8\u5360\u4E00\u4E2A\u51FA\u573A\u540D\u989D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8EAB\u4F53\u90E8\u5206\u8BF7\u76F4\u63A5\u8BFB\u5E74\u9F84\uFF1A\u901F\u5EA6\u5DF2\u7ECF\u4E0B\u964D\uFF0C\u56DE\u8FFD\u8986\u76D6\u9762\u6709\u9650\uFF0C\u8FDE\u7EED\u4E00\u5468\u53CC\u8D5B\u4F1A\u5F88\u5403\u529B\u3002\u4ED6\u7684\u6BD4\u8D5B\u4EF7\u503C\u968F\u8D5B\u7A0B\u5BC6\u5EA6\u9012\u51CF\uFF0C\u968F\u6BD4\u5206\u7126\u707C\u5EA6\u9012\u589E\u3002\u522B\u6307\u671B\u4ED6\u62EF\u6551\u8FD0\u52A8\u80FD\u529B\uFF0C\u4ED6\u80FD\u62EF\u6551\u7684\u662F\u79E9\u5E8F\u3002\u5408\u540C\u5EFA\u8BAE\u4E00\u5E74\u4E00\u7B7E\uFF0C\u51FA\u573A\u5B89\u6392\u5EFA\u8BAE\u7CBE\u6311\u5BF9\u624B\u3002"
        english: 
