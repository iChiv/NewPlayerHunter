    - layout: 1
      kicker:
        chineseSimplified: "\u6218\u672F\u8BC4\u8BBA"
        english: 
      headline:
        chineseSimplified: "\u65E0\u804A\u7684\u4EF7\u503C\uFF0C\u4E0E\u88AB\u62D2\u7EDD\u7684\u7406\u7531"
        english: 
      deck:
        chineseSimplified: "\u6709\u4E9B\u7403\u5458\u7684\u4F18\u70B9\u4E0D\u4F1A\u4E0A\u96C6\u9526\uFF0C\u53EA\u4F1A\u51FA\u73B0\u5728\u6559\u7EC3\u7684\u7761\u7720\u91CC\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u201C\u5B89\u5168\u4F20\u7403\u201D\u5728\u7403\u8FF7\u8BCD\u5178\u91CC\u662F\u9A82\u4EBA\u7684\u8BDD\uFF0C\u5728\u6559\u7EC3\u8BCD\u5178\u91CC\u662F\u63A7\u7403\u7387\u7684\u53E6\u4E00\u79CD\u5199\u6CD5\u3002\u6BD4\u5B89\u5947\u5F0F\u4E2D\u573A\u7684\u771F\u6B63\u4EF7\u503C\uFF0C\u8981\u4ECE\u53CD\u5411\u6570\u636E\u91CC\u8BFB\uFF1A\u4ED6\u5728\u573A\u65F6\uFF0C\u7403\u961F\u56E0\u5931\u8BEF\u88AB\u53CD\u51FB\u7684\u6B21\u6570\u6709\u591A\u5C11\uFF1F\u7B54\u6848\u5F80\u5F80\u6F02\u4EAE\u5F97\u65E0\u804A\u3002\u8FD9\u7C7B\u7403\u5458\u7684\u8BC4\u4F30\u9677\u9631\u5728\u4E8E\uFF0C\u96C6\u9526\u65F6\u4EE3\u6CA1\u6709\u4EBA\u4E3A\u201C\u6CA1\u53D1\u751F\u7684\u5931\u8BEF\u201D\u505A\u89C6\u9891\u3002\u672C\u520A\u5EFA\u8BAE\u7528\u8001\u529E\u6CD5\uFF1A\u770B\u5168\u573A\uFF0C\u770B\u961F\u53CB\u5931\u8BEF\u65F6\u4ED6\u5728\u54EA\u4E2A\u4F4D\u7F6E\u8865\u3002\u7B54\u6848\u4F1A\u66FF\u4F60\u62A5\u4EF7\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u7EB3\u74E6\u7F57\u7684\u201C\u8EAB\u9AD8\u95EE\u9898\u201D\u5219\u662F\u53E6\u4E00\u79CD\u5E02\u573A\u5931\u7075\u3002\u95E8\u5C06\u7684\u8EAB\u9AD8\u8981\u6C42\u6709\u5176\u9053\u7406\uFF1A\u8986\u76D6\u9762\u79EF\u3001\u9AD8\u7A7A\u7403\u3001\u51FA\u51FB\u8303\u56F4\u3002\u4F46\u201C\u8EAB\u9AD8\u4E0D\u8DB3\u6240\u4EE5\u653E\u5F03\u201D\u662F\u4E00\u6761\u61D2\u60F0\u7684\u63A8\u7406\u94FE\uFF0C\u6B63\u786E\u7684\u95EE\u6CD5\u662F\uFF1A\u4ED6\u7684\u8D77\u8DF3\u65F6\u673A\u3001\u843D\u70B9\u9884\u5224\u548C\u51FA\u51FB\u51B3\u7B56\uFF0C\u80FD\u5426\u5BF9\u51B2\u90A3\u51E0\u5398\u7C73\u3002\u7B2C\u4E09\u7EA7\u522B\u51FA\u51FB\u6210\u529F\u7387\u7B2C\u4E00\uFF0C\u81F3\u5C11\u8BF4\u660E\u5BF9\u51B2\u90E8\u5206\u6210\u7ACB\u3002\u88AB\u62D2\u7EDD\u8FC7\u7684\u4EBA\u91CC\u5E38\u6709\u5B9D\u8D1D\uFF0C\u524D\u63D0\u662F\u4F60\u628A\u201C\u62D2\u7EDD\u7684\u7406\u7531\u201D\u91CD\u65B0\u5BA1\u4E00\u904D\uFF0C\u800C\u4E0D\u662F\u76F4\u63A5\u7EE7\u627F\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u5E02\u573A\u6700\u5927\u7684\u504F\u89C1\uFF0C\u662F\u628A\u522B\u4EBA\u7684\u7ED3\u8BBA\u5F53\u81EA\u5DF1\u7684\u8003\u5BDF\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u91CD\u5BA1\u6E05\u5355"
        english: 
      sidebarBody:
        chineseSimplified: "\u524D\u4EFB\u653E\u5F03\u4ED6\u7684\u7406\u7531\u662F\u4EC0\u4E48\uFF1F\u8BE5\u7406\u7531\u5728\u4F60\u7684\u4F53\u7CFB\u91CC\u8FD8\u6210\u7ACB\u5417\uFF1F\u6709\u6CA1\u6709\u6570\u636E\u53CD\u8BC1\uFF1F\u4E09\u95EE\u4E4B\u540E\uFF0C\u518D\u8C08\u4EF7\u683C\u3002"
        english: 
