        chineseSimplified: "\u201C\u66FF\u8865\u5E2D\u7684\u6DF1\u5EA6\uFF0C\u662F\u4E3B\u529B\u53D7\u4F24\u90A3\u5929\u624D\u77E5\u9053\u7684\u6C34\u4F4D\u3002\u201D"
