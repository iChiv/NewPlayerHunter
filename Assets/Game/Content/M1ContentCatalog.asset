        english: 
      bodyLeft:
        chineseSimplified: "\u89E3\u5256\u4E00\u6B21\u6210\u529F\u7684\u53CD\u51FB\uFF0C\u4F60\u4F1A\u53D1\u73B0\u5B83\u5F00\u59CB\u5F97\u6BD4\u5F55\u50CF\u663E\u793A\u7684\u66F4\u65E9\uFF1A\u7B2C\u4E00\u811A\u4F20\u7403\u4E4B\u524D\uFF0C\u5F31\u4FA7\u5DF2\u7ECF\u6709\u4EBA\u542F\u52A8\uFF0C\u7B2C\u4E09\u4EBA\u5DF2\u7ECF\u5728\u8DD1\u4F20\u7403\u8005\u7684\u4F20\u7403\u7EBF\u8DEF\u3002\u5C0F\u7EC4\u8D5B\u9636\u6BB5\u6211\u4EEC\u5199\u8FC7\u67D0\u4F4D\u8FB9\u950B\u7684\u8B66\u544A\u2014\u2014\u7ED9\u4ED6\u5341\u7C73\u7A7A\u95F4\uFF0C\u4F60\u6700\u597D\u76F4\u63A5\u72AF\u89C4\u3002\u6DD8\u6C70\u8D5B\u7684\u95EE\u9898\u662F\uFF1A\u7ECF\u9A8C\u8001\u5230\u7684\u7403\u961F\u6839\u672C\u4E0D\u4F1A\u7ED9\u4F60\u90A3\u5341\u7C73\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4E09\u79D2\u89C4\u5219\u53EF\u4EE5\u8BAD\u7EC3\uFF1A\u593A\u56DE\u7403\u6743\u540E\u7B2C\u4E00\u811A\u5411\u524D\u3001\u6700\u8FD1\u4E24\u4EBA\u7ACB\u5373\u4EA4\u53C9\u3001\u4E22\u7403\u65B9\u4E94\u79D2\u5185\u53CD\u62A2\u3002\u4F46\u4F53\u80FD\u8D26\u5FC5\u987B\u53E6\u7B97\u2014\u2014\u8D5B\u5B63\u521D\u90A3\u8F86\u201C\u65F6\u901F\u4E24\u767E\u516C\u91CC\u7684\u5766\u514B\u201D\u63D0\u9192\u6211\u4EEC\uFF0C\u5766\u514B\u4E5F\u9700\u8981\u52A0\u6CB9\u65F6\u95F4\u8868\u3002\u53CD\u51FB\u7684\u8D28\u91CF\uFF0C\u4E00\u534A\u5728\u811A\u6CD5\uFF0C\u4E00\u534A\u5728\u4FDD\u517B\u8BB0\u5F55\u3002"
