        english: 
      bodyLeft:
        chineseSimplified: "\u5947\u8FF9\u7684\u7533\u62A5\u6D41\u7A0B\u5176\u5B9E\u6709\u56FA\u5B9A\u683C\u5F0F\uFF1A\u4E00\u4E2A\u65E9\u8FDB\u7403\u8BA1\u5212\u3001\u5E93\u5B58\u91CC\u7684\u5B9A\u4F4D\u7403\u3001\u4E00\u5F20\u7559\u5230\u6700\u540E\u7684\u6362\u4EBA\u724C\uFF0C\u4EE5\u53CA\u5229\u7528\u5BF9\u65B9\u201C\u6015\u8F93\u201D\u591A\u8FC7\u81EA\u5DF1\u201C\u60F3\u8D62\u201D\u7684\u5FC3\u7406\u5DEE\u3002\u843D\u540E\u4E00\u65B9\u7684\u6218\u672F\u4E0D\u53EB\u4FE1\u4EF0\uFF0C\u53EB\u628A\u6240\u6709\u53EF\u80FD\u6027\u63D0\u524D\u644A\u5728\u684C\u4E0A\uFF0C\u518D\u6309\u6982\u7387\u4ECE\u9AD8\u5230\u4F4E\u6392\u597D\u961F\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8D5B\u540E\u590D\u76D8\u603B\u662F\u62C6\u5947\u8FF9\u7684\u53F0\uFF1A\u51E0\u4E4E\u6BCF\u573A\u7ECF\u5178\u9006\u8F6C\u90FD\u80FD\u627E\u51FA\u4E09\u4E2A\u4EE5\u4E0A\u53EF\u89E3\u91CA\u56E0\u7D20\u3002\u8FD9\u4E5F\u662F\u8D4C\u5F92\u578B\u524D\u950B\u5728\u51B3\u8D5B\u6708\u88AB\u91CD\u65B0\u4F30\u503C\u7684\u539F\u56E0\u2014\u2014\u4E5D\u6B21\u5931\u8D25\u662F\u5E38\u89C4\u8D5B\u7684\u7EDF\u8BA1\u566A\u97F3\uFF0C\u4E00\u6B21\u6210\u529F\u5C31\u662F\u51B3\u8D5B\u7684\u5168\u90E8\u5185\u5BB9\u3002\u5947\u8FF9\u4E0D\u63A5\u5F85\u6CA1\u6709\u51C6\u5907\u7684\u4EBA\uFF0C\u62BD\u7B7E\u4E5F\u4E00\u6837\u3002"
