        chineseSimplified: "\u4F69\u96F7\u62C9\uFF1A\u7403\u5728\u4ED6\u811A\u4E0B\u4F1A\u9690\u8EAB"
        english: 
      deck:
        chineseSimplified: "\u4E94\u4EBA\u5236\u8D5B\u573A\u7684\u9B54\u672F\u5E08\uFF0C\u5341\u4E00\u4EBA\u5236\u7684\u51C6\u8003\u8BC1\u8FD8\u6CA1\u9886\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u5C0F\u7A7A\u95F4\u6280\u672F\u63A5\u8FD1\u5929\u82B1\u677F\uFF1A\u4F4E\u91CD\u5FC3\u3001\u811A\u4E0B\u9891\u7387\u3001\u53D8\u5411\u7684\u6B3A\u9A97\u6027\uFF0C\u5728\u4E94\u4EBA\u5236\u7684\u9AD8\u538B\u9505\u91CC\u70BC\u5230\u7EAF\u719F\u3002\u4E00\u5BF9\u4E00\u51E0\u4E4E\u4E0D\u53EF\u9632\uFF0C\u7403\u63A2\u90A3\u53E5\u201C\u6CA1\u4EBA\u77E5\u9053\u4ED6\u51C6\u5907\u5E72\u4EC0\u4E48\u201D\u4E0D\u662F\u4FEE\u8F9E\uFF0C\u662F\u5BF9\u4F4D\u8005\u7684\u666E\u904D\u4F53\u9A8C\u3002\u6BD4\u8D5B\u6C14\u8D28\u677E\u5F1B\uFF0C\u8D8A\u662F\u5BC6\u96C6\u9632\u5B88\u8D8A\u6765\u52B2\u3002\u8FD9\u7C7B\u5929\u8D4B\u5728\u50F5\u5C40\u65F6\u523B\u662F\u7A00\u7F3A\u8D44\u6E90\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5341\u4E00\u4EBA\u5236\u7684\u4E09\u9053\u8003\u9898\u4ED6\u5168\u6CA1\u4EA4\u5377\uFF1A\u957F\u8DDD\u79BB\u5F80\u8FD4\u7684\u4F53\u80FD\u50A8\u5907\u672A\u77E5\uFF0C\u65E0\u7403\u9636\u6BB5\u7684\u8DD1\u4F4D\u4E60\u60EF\u5F85\u5EFA\uFF0C\u88AB\u8EAB\u4F53\u78BE\u538B\u540E\u7684\u5E94\u5BF9\u6CA1\u6709\u6837\u672C\u3002\u4E94\u4EBA\u5236\u7684\u7EED\u822A\u903B\u8F91\u4E0E\u5927\u573A\u4E0D\u540C\uFF0C\u4ED6\u80FD\u4FDD\u6301\u5F3A\u5EA6\u591A\u4E45\uFF0C\u9700\u8981\u5B9E\u6D4B\u3002\u5EFA\u8BAE\u7684\u7B7E\u7EA6\u7ED3\u6784\uFF1A\u5148\u68AF\u961F\u6216\u676F\u8D5B\u8BD5\u7528\uFF0C\u628A\u201C\u9B54\u6CD5\u201D\u7FFB\u8BD1\u6210\u201C\u5206\u949F\u201D\uFF0C\u518D\u8C08\u957F\u7EA6\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u9B54\u6CD5\u662F\u771F\u7684\uFF0C\u65BD\u6CD5\u8303\u56F4\u5F85\u6D4B\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u5B9E\u6D4B\u65B9\u6848"
        english: 
      sidebarBody:
        chineseSimplified: "\u7B2C\u4E00\u5468\uFF1A\u4F53\u80FD\u57FA\u7EBF\u3002\u7B2C\u4E8C\u5468\uFF1A\u5BF9\u6297\u8D5B\u3002\u7B2C\u4E09\u5468\uFF1A\u8FDE\u7EED\u4E24\u573A\u3002\u4E09\u9879\u8FBE\u6807\u518D\u8FDB\u5927\u540D\u5355\uFF0C\u987A\u5E8F\u522B\u4E71\u3002"
