        english: 
      bodyLeft:
        chineseSimplified: "\u5362\u5361\u65AF\u7684\u7B80\u5386\u4ECE\u8D2B\u6C11\u533A\u7684\u6C34\u6CE5\u5730\u5199\u8D77\uFF1A\u8857\u5934\u8DB3\u7403\u51FA\u8EAB\uFF0C15\u5C81\u88AB\u7403\u63A2\u5E26\u8D70\uFF0C\u9752\u5E74\u961F\u6BD4\u8D5B\u91CC\u8FDE\u8FC7\u4E09\u4EBA\u5B8C\u6210\u7EDD\u6740\u3002\u5357\u7F8E\u8DB3\u7403\u7684\u4E0B\u4E00\u4E2A\u540D\u5B57\uFF0C\u6B63\u5728\u6309\u4F20\u7EDF\u6D41\u7A0B\u6392\u961F\u51FA\u9053\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4F55\u585E\u7684\u7B80\u5386\u8584\u5F97\u591A\uFF0C\u4E5F\u539A\u5F97\u591A\uFF1A\u7B2C\u4E09\u3001\u7B2C\u56DB\u7EA7\u522B\uFF0C\u516B\u652F\u7403\u961F\uFF0C\u961F\u957F\u8896\u6807\u6234\u4E86\u5341\u51E0\u5E74\u3002\u4ED6\u672C\u5468\u627E\u7684\u662F\u6700\u540E\u4E00\u4EFD\u5DE5\u4F5C\u3002\u5C71\u8C37\u9547\u6B63\u5728\u51B2\u51FB\u804C\u4E1A\u8054\u8D5B\uFF0C\u4ED6\u4EEC\u9700\u8981\u89C1\u8FC7\u5C71\u9876\u7684\u4EBA\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4E00\u4E2A\u8FD8\u6CA1\u88AB\u7528\u65E7\uFF0C\u4E00\u4E2A\u5DF2\u7ECF\u88AB\u7528\u900F\uFF0C\u90FD\u662F\u8D44\u4EA7\u3002"
        english: 
