        english: 
      deck:
        chineseSimplified: "\u653E\u5F03\u8FC7\u8DB3\u7403\u53C8\u8DD1\u56DE\u6765\u7684\u4EBA\uFF0C\u5982\u4ECA\u7528\u8DD1\u52A8\u91CF\u91CD\u65B0\u5B9A\u4E49\u524D\u950B\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u524D\u573A\u538B\u8FEB\u662F\u4ED6\u7684\u4EA7\u54C1\u8BF4\u660E\u4E66\uFF1A\u573A\u574718\u516C\u91CC\u4E0D\u662F\u4FEE\u8F9E\uFF0C\u662F\u8FFD\u8E2A\u6570\u636E\u3002\u538B\u8FEB\u8DEF\u7EBF\u806A\u660E\uFF0C\u4E0D\u662F\u778E\u8DD1\u2014\u2014\u5C01\u4F20\u7403\u7EBF\u8DEF\u3001\u903C\u540E\u536B\u7528\u5F31\u811A\u3001\u628A\u51FA\u7403\u8D76\u5411\u8FB9\u7EBF\uFF0C\u4E00\u5957\u6D41\u7A0B\u5B8C\u6574\u6267\u884C\u300219\u5C81\u79BB\u5F00\u300123\u5C81\u5F52\u6765\u7684\u7ECF\u5386\uFF0C\u53CD\u800C\u7ED9\u4E86\u4ED6\u540C\u9F84\u524D\u950B\u6CA1\u6709\u7684\u6210\u719F\uFF1A\u4F4D\u7F6E\u7EAA\u5F8B\u597D\uFF0C\u60C5\u7EEA\u7A33\u5B9A\uFF0C\u6218\u672F\u677F\u6267\u884C\u5230\u5398\u7C73\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u6D88\u8017\u7684\u8D26\u672C\u540C\u6837\u8981\u8BFB\uFF1A18\u516C\u91CC\u7684\u80CC\u540E\u662F\u6062\u590D\u6210\u672C\uFF0C\u8FDE\u7EED\u4E00\u5468\u53CC\u8D5B\u65F6\u5F3A\u5EA6\u80FD\u5426\u7EF4\u6301\u9700\u8981\u6837\u672C\u3002\u8FDB\u653B\u4E09\u533A\u81EA\u5DF1\u7684\u7EC8\u7ED3\u80FD\u529B\u4E2D\u7B49\uFF0C\u538B\u8FEB\u5236\u9020\u7684\u7403\u6743\u8F6C\u5316\uFF0C\u4F9D\u8D56\u961F\u53CB\u8DDF\u8FDB\u8D28\u91CF\u3002\u4F24\u75C5\u53F2\u8981\u7FFB\u523019\u5C81\u90A3\u4E00\u9875\uFF0C\u770B\u5F53\u521D\u4E3A\u4F55\u79BB\u5F00\u3002\u4ED6\u662F\u4F53\u7CFB\u653E\u5927\u5668\u2014\u2014\u4F53\u7CFB\u8D8A\u5F3A\u4ED6\u8D8A\u503C\u94B1\uFF0C\u53CD\u4E4B\u4EA6\u7136\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u8DD1\u7684\u4E0D\u662F\u8DDD\u79BB\uFF0C\u662F\u5BF9\u624B\u7684\u5904\u7406\u65F6\u95F4\u3002"
