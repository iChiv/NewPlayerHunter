        chineseSimplified: "\u6770\u514B\xB7\u7279\u7EB3\u7684\u6545\u4E8B\u5728\u53E6\u4E00\u4E2A\u5DE5\u5730\uFF1A\u591A\u5E74\u5EFA\u7B51\u5DE5\u4EBA\uFF0C\u91CD\u8FD4\u5168\u804C\u8DB3\u7403\u3002\u961F\u53CB\u8BF4\u4ED6\u8E22\u7403\u50CF\u642C\u7816\u2014\u2014\u7B80\u5355\u3001\u76F4\u63A5\u3001\u6709\u6548\u3002\u672C\u5468\u4E24\u652F\u7403\u961F\u7684\u6765\u4FE1\u90FD\u5728\u627E\u201C\u8010\u7528\u7684\u4EBA\u201D\uFF0C\u5DE7\u4E86\u3002"
