      deck:
        chineseSimplified: "\u8FDE\u7EED\u4E24\u5B63\u9EC4\u724C\u738B\uFF0C\u9632\u5B88\u662F\u771F\u7684\u51F6\uFF0C\u505C\u8D5B\u4E5F\u662F\u771F\u7684\u591A\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u8FB9\u8DEF\u9632\u5B88\u7684\u5B58\u5728\u611F\u62C9\u6EE1\uFF1A\u8D34\u8EAB\u3001\u4E0B\u811A\u5FEB\u3001\u5BF9\u6297\u6B32\u671B\u5F3A\uFF0C\u5BF9\u65B9\u8FB9\u950B\u62FF\u7403\u524D\u8981\u5148\u505A\u4E00\u6B21\u5FC3\u7406\u5EFA\u8BBE\u3002\u4ED6\u7684\u4FB5\u7565\u6027\u4E0D\u5168\u662F\u9C81\u83BD\u2014\u2014\u591A\u6570\u72AF\u89C4\u53D1\u751F\u5728\u6218\u672F\u9700\u8981\u7684\u4F4D\u7F6E\uFF0C\u5C5E\u4E8E\u201C\u806A\u660E\u7684\u810F\u201D\u3002\u7F20\u6597\u80FD\u529B\u5F3A\uFF0C\u6BD4\u8D5B\u6C14\u8D28\u786C\uFF0C\u843D\u540E\u65F6\u523B\u662F\u5C11\u6570\u8FD8\u6562\u505A\u52A8\u4F5C\u7684\u4EBA\u3002\u591A\u6B21\u88AB\u8DB3\u534F\u7981\u8D5B\u7684\u8BB0\u5F55\u672C\u8EAB\uFF0C\u4E5F\u8BC1\u660E\u4ED6\u7684\u52A8\u4F5C\u5E38\u5E74\u5728\u89C4\u5219\u8FB9\u754C\u529E\u516C\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u6210\u672C\u9875\u540C\u6837\u6E05\u6670\uFF1A\u9EC4\u724C\u738B\u7684\u8D5B\u5B63\u610F\u5473\u7740\u56FA\u5B9A\u7684\u505C\u8D5B\u7F3A\u5E2D\uFF0C\u5173\u952E\u573A\u6B21\u7684\u505C\u8D5B\u98CE\u9669\u662F\u6218\u7565\u7EA7\u95EE\u9898\u3002\u7EAA\u5F8B\u8BB0\u5F55\u8FD8\u53EF\u80FD\u5E26\u6765\u88C1\u5224\u7684\u201C\u91CD\u70B9\u5173\u6CE8\u201D\u2014\u2014\u540C\u6837\u7684\u52A8\u4F5C\uFF0C\u522B\u4EBA\u9EC4\u724C\u4ED6\u53EF\u80FD\u5347\u7EA7\u3002\u4F4D\u7F6E\u611F\u7684\u77ED\u677F\u9760\u4FB5\u7565\u6027\u63A9\u76D6\uFF0C\u9047\u5230\u8010\u5FC3\u7684\u5BF9\u624B\u4F1A\u88AB\u9493\u9C7C\u3002\u7B7E\u7EA6\u524D\u8BF7\u5148\u770B\u770B\u4F60\u7684\u66FF\u8865\u8FB9\u540E\u536B\u662F\u8C01\uFF1A\u4ED6\u6BCF\u5E74\u90FD\u8981\u4E0A\u573A\u7684\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u7684\u72AF\u89C4\u90FD\u61C2\u6218\u672F\uFF0C\u505C\u8D5B\u4E5F\u61C2\u2014\u2014\u4E13\u6311\u5173\u952E\u573A\u6B21\u3002"
        english: 
