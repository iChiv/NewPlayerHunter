        english: 
      sidebarBody:
        chineseSimplified: "\u9EC4\u724C\u7EAA\u5F55\uFF1A\u8FDE\u7EED\u4E24\u5B63\uFF0C\u5DF2\u6838\u3002\u7981\u8D5B\u573A\u6B21\uFF1A\u53EF\u91CF\u5316\u3002\u88C1\u5224\u5370\u8C61\u5206\uFF1A\u4E0D\u53EF\u91CF\u5316\u4F46\u771F\u5B9E\u5B58\u5728\u3002\u9884\u7B97\u8BF7\u9884\u7559\u66FF\u8865\u65B9\u6848\u3002"
