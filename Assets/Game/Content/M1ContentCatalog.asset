      deck:
        chineseSimplified: "\u8FB9\u8DEF\u63A8\u571F\u673A\u6302\u724C\uFF0C\u51B2\u51FB\u529B\u662F\u771F\u7684\uFF0C\u8BF4\u660E\u4E66\u4E5F\u8981\u4E00\u8D77\u4E70\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u7EB5\u5411\u51B2\u51FB\u529B\u5728\u540C\u4F4D\u7F6E\u5C5E\u4E8E\u7A00\u7F3A\u54C1\uFF1A\u8FB9\u7EBF\u9644\u8FD1\u62FF\u7403\u540E\u7684\u7B2C\u4E00\u6B65\u7206\u53D1\uFF0C\u80FD\u628A\u6574\u6761\u9632\u7EBF\u538B\u9000\u4E94\u7C73\u3002\u4F53\u683C\u4F18\u52BF\u660E\u663E\uFF0C\u5BF9\u6297\u540E\u4E0D\u6389\u901F\u3001\u4E0D\u53D8\u5F62\uFF0C\u8BAD\u7EC3\u51FA\u52E4\u8BB0\u5F55\u5E72\u51C0\u3002\u201C\u65F6\u901F200\u516C\u91CC\u201D\u5F53\u7136\u662F\u6587\u5B66\u4FEE\u8F9E\uFF0C\u4F46\u201C\u5BF9\u624B\u4E3B\u52A8\u8BA9\u8DEF\u201D\u7684\u8BC1\u8BCD\u5728\u4E09\u4E2A\u4E0D\u540C\u6765\u6E90\u5904\u5F97\u5230\u5370\u8BC1\u2014\u2014\u6050\u60E7\u672C\u8EAB\u4E5F\u662F\u6218\u672F\u8D44\u4EA7\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u51B2\u51FB\u578B\u8E22\u6CD5\u7684\u7535\u8D39\u5F88\u9AD8\uFF1A\u4E0A\u4E0B\u7FFB\u98DE\u4E5D\u5341\u5206\u949F\uFF0C\u7EED\u822A\u80FD\u6491\u591A\u4E45\u9700\u8981\u8FDE\u7EED\u6837\u672C\u3002\u6280\u672F\u7EC6\u8282\u7C97\u7CD9\uFF0C\u4F20\u4E2D\u548C\u6700\u540E\u4E00\u4F20\u7ECF\u5E38\u8DDF\u7740\u60EF\u6027\u4E00\u8D77\u51FA\u754C\u3002\u9632\u5B88\u7AEF\u7684\u4F4D\u7F6E\u611F\u9760\u8EAB\u4F53\u8865\u56DE\u6765\uFF0C\u9047\u5230\u4E0D\u8DDF\u4ED6\u62FC\u8EAB\u4F53\u3001\u4E13\u6253\u8EAB\u540E\u7A7A\u5F53\u7684\u5BF9\u624B\u65F6\u4F1A\u6BD4\u8F83\u72FC\u72C8\u3002\u4E70\u5766\u514B\uFF0C\u8BF7\u81EA\u5907\u5239\u8F66\u7247\u3002"
        english: 
