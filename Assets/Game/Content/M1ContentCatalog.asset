        chineseSimplified: "\u8BC1\u8BCD\u4E09\u6E90\u4E92\u8BC1\uFF0C\u96C6\u9526\u53E6\u5B58\u3002\u201C\u65F6\u901F200\u516C\u91CC\u201D\u7CFB\u4FEE\u8F9E\uFF0C\u672C\u520A\u5B9E\u6D4B\u680F\u76EE\u62D2\u7EDD\u4E3A\u5F62\u5BB9\u8BCD\u51FA\u5177\u8BC1\u660E\u3002"
