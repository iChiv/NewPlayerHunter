        chineseSimplified: "\u4E09\u767E\u573A\u82F1\u51A0\u4E0D\u662F\u5C65\u5386\uFF0C\u662F\u4E00\u90E8\u53EF\u4EE5\u5206\u96C6\u6838\u67E5\u7684\u7EAA\u5F55\u7247\uFF1A\u9632\u7EBF\u6307\u6325\u3001\u5B9A\u4F4D\u7403\u7AD9\u4F4D\u3001\u66F4\u8863\u5BA4\u79E9\u5E8F\uFF0C\u5168\u90E8\u6709\u591A\u5E74\u5F55\u50CF\u548C\u591A\u4F4D\u524D\u961F\u53CB\u7684\u4EA4\u53C9\u8BC1\u8BCD\u3002\u5347\u7EA7\u8D5B\u5B63\u4ED6\u5728\u573A\uFF0C\u4FDD\u7EA7\u6CE5\u6F6D\u8D5B\u5B63\u4ED6\u4E5F\u5728\u573A\u2014\u2014\u540E\u8005\u5F80\u5F80\u66F4\u80FD\u8BF4\u660E\u4E00\u4E2A\u961F\u957F\u7684\u6210\u8272\u3002"
