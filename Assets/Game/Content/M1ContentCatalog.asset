        english: 
      bodyLeft:
        chineseSimplified: "\u672C\u520A\u7684\u4F18\u52BF\u81EA\u8BC4\uFF1A\u575A\u6301\u4E86\u5B8C\u6574\u5F55\u50CF\u3001\u53CC\u6E90\u6838\u5B9E\u3001\u7ED9\u6BCF\u6761\u4F20\u95FB\u6807\u6CE8\u53EF\u4FE1\u7B49\u7EA7\uFF1B\u6CA1\u6709\u4E00\u4EFD\u201C\u636E\u4F20\u201D\u76F4\u63A5\u767B\u4E0A\u5C01\u9762\u800C\u6CA1\u6709\u4E0B\u6587\uFF1B\u6240\u6709\u7B11\u8BDD\u5728\u520A\u767B\u524D\u5747\u901A\u8FC7\u4E8B\u5B9E\u90E8\u95E8\u7684\u5E7D\u9ED8\u5BA1\u67E5\uFF0C\u5BA1\u67E5\u6807\u51C6\u662F\uFF1A\u5148\u7B11\uFF0C\u540E\u67E5\uFF0C\u518D\u7B11\u4E00\u6B21\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5B58\u7591\u90E8\u5206\u4E5F\u5982\u5B9E\u520A\u767B\uFF1A\u6211\u4EEC\u5BF9\u7B11\u8BDD\u7684\u70ED\u60C5\u5076\u5C14\u8DD1\u5728\u6570\u636E\u524D\u9762\uFF0C\u4E2A\u522B\u6807\u9898\u6BD4\u6B63\u6587\u5148\u5230\u73B0\u573A\uFF1B\u660E\u5E74\u7684\u6539\u8FDB\u6E05\u5355\u7B2C\u4E00\u6761\u5DF2\u7ECF\u5199\u597D\u2014\u2014\u6807\u9898\u9650\u901F\uFF0C\u6838\u5B9E\u5148\u884C\u3002\u6700\u540E\u4E00\u6761\u6838\u67E5\u6E05\u5355\u6C38\u8FDC\u5199\u7740\uFF1A\u68C0\u67E5\u6838\u67E5\u8005\u3002"
