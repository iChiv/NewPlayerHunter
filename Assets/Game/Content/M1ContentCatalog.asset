        chineseSimplified: "\u5DE5\u4E1A\u8054\u672C\u5468\u7684\u6C42\u52A9\u4FE1\u628A\u4F53\u80FD\u63A8\u6210\u4E86\u786C\u901A\u8D27\uFF1A\u4E03\u540D\u4F24\u5458\u8EBA\u5728\u533B\u52A1\u5BA4\uFF0C\u8001\u677F\u53EA\u95EE\u201C\u4ED6\u5BB9\u6613\u53D7\u4F24\u5417\u201D\u3002\u8FD9\u662F\u672C\u8D5B\u5B63\u6700\u8BDA\u5B9E\u7684\u4E00\u5C01\u6765\u4FE1\u2014\u2014\u80FD\u529B\u53EF\u4EE5\u6162\u6162\u78E8\uFF0C\u51FA\u52E4\u7387\u4ECE\u7B7E\u7EA6\u7B2C\u4E00\u5929\u5C31\u5F00\u59CB\u8BA1\u606F\u3002\u6240\u4EE5\u522B\u7B11\u5E26\u9A6C\u62C9\u677E\u6210\u7EE9\u5355\u6765\u5E94\u8058\u7684\u4EBA\uFF0C\u4E5F\u522B\u6025\u7740\u4E3A\u201C\u5766\u514B\u201D\u638F\u7A7A\u94B1\u5305\u3002\u628A\u8FFD\u8E2A\u6570\u636E\u3001\u4F24\u75C5\u53F2\u3001\u51FA\u573A\u8FDE\u7EED\u6027\u6446\u4E0A\u684C\uFF0C\u795E\u8BDD\u7ACB\u523B\u73B0\u51FA\u539F\u5F62\uFF1A\u6709\u7684\u662F\u771F\u7684\uFF0C\u6709\u7684\u53EA\u662F\u5F62\u5BB9\u8BCD\u6BD4\u8F83\u52AA\u529B\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4FDD\u6E29\u676F\u91CC\u7684\u4E1C\u897F\u4E0D\u91CD\u8981\uFF0C\u91CD\u8981\u7684\u662F\u676F\u4E3B\u8FD8\u5728\u573A\u4E0A\u3002"
        english: 
