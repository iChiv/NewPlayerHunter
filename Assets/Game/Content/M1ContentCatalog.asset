        english: 
      bodyLeft:
        chineseSimplified: "\u6DD8\u6C70\u8D5B\u7684\u5168\u90E8\u6837\u672C\u53EA\u6709\u4E00\u767E\u516B\u5341\u5206\u949F\uFF0C\u5374\u603B\u6709\u4EBA\u613F\u610F\u4E3A\u5B83\u4ED8\u4E09\u5E74\u7684\u5DE5\u8D44\u3002\u201C\u5927\u573A\u9762\u7403\u5458\u201D\u7684\u4F30\u503C\u6A21\u578B\u91CC\uFF0C\u4E00\u6B21\u5173\u952E\u8FDB\u7403\u7684\u6743\u91CD\u9AD8\u5F97\u79BB\u8C31\uFF0C\u800C\u5931\u8BEF\u3001\u8F6E\u7A7A\u548C\u5BF9\u624B\u7EA2\u724C\u90FD\u88AB\u6084\u6084\u644A\u9500\u3002\u5BA3\u4F20\u8BDD\u672F\u4E5F\u5728\u5347\u7EA7\uFF1A\u8D5B\u5B63\u521D\u8FD8\u662F\u201C\u56DB\u5341\u4E00\u7403\u201D\uFF0C\u5982\u4ECA\u8FDB\u5316\u4E3A\u201C\u5927\u573A\u9762\u57FA\u56E0\u201D\u2014\u2014\u7EDF\u8BA1\u53E3\u5F84\u4F9D\u65E7\u7F3A\u5E2D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u771F\u6B63\u503C\u94B1\u7684\u7ECF\u9A8C\u5F80\u5F80\u4E0D\u6027\u611F\uFF1A\u5BA2\u573A\u9886\u5148\u540E\u7684\u9635\u578B\u7EAA\u5F8B\u3001\u88AB\u6273\u5E73\u540E\u5F00\u7403\u7684\u90A3\u4E00\u5206\u949F\u3001\u70B9\u7403\u987A\u5E8F\u8868\u63D0\u524D\u5199\u597D\u800C\u4E0D\u662F\u73B0\u573A\u6C11\u4E3B\u8868\u51B3\u3002\u8FD9\u4E9B\u80FD\u529B\u53EF\u4EE5\u8BAD\u7EC3\u3001\u53EF\u4EE5\u6838\u67E5\u3001\u53EF\u4EE5\u5199\u8FDB\u5408\u540C\u8003\u6838\u3002\u81F3\u4E8E\u201C\u89C1\u8FC7\u4E16\u9762\u201D\uFF0C\u4E16\u9762\u672C\u4EBA\u5E76\u672A\u51FA\u5177\u8BC1\u660E\u3002\u51E1\u662F\u4E0D\u9644\u5F55\u50CF\u65F6\u95F4\u6233\u7684\u201C\u7ECF\u9A8C\u201D\uFF0C\u8BF7\u5148\u6309\u6587\u5B66\u4F5C\u54C1\u5F52\u6863\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6DD8\u6C70\u8D5B\u4E0D\u76F8\u4FE1\u5E73\u5747\u6570\uFF0C\u5B83\u53EA\u8BA4\u8FD9\u4E00\u6B21\u3002\u201D"
        english: 
