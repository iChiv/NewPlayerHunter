        chineseSimplified: "\u7B2C\u4E00\u4EFD\u5DE5\u4F5C\u4E0E\u6700\u540E\u4E00\u4EFD\u5DE5\u4F5C"
        english: 
      deck:
        chineseSimplified: "\u6211\u4EEC\u540C\u65F6\u8BFB\u4E86\u4E24\u4EFD\u7B80\u5386\uFF0C\u53D1\u73B0\u5B83\u4EEC\u4E92\u4E3A\u7B54\u6848\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u5E74\u8F7B\u5929\u624D\u7684\u7B80\u5386\u6C38\u8FDC\u95EA\u95EA\u53D1\u5149\uFF0C\u56E0\u4E3A\u6CA1\u6765\u5F97\u53CA\u7559\u4E0B\u5212\u75D5\u3002\u5362\u5361\u65AF\u7684\u6545\u4E8B\u7B26\u5408\u6240\u6709\u7ECF\u5178\u5143\u7D20\uFF1A\u8D2B\u6C11\u533A\u3001\u8857\u5934\u300115\u5C81\u3001\u7403\u63A2\u3001\u8FDE\u8FC7\u4E09\u4EBA\u7684\u7EDD\u6740\u3002\u8BC1\u636E\u94FE\u4E5F\u6BD4\u4E00\u822C\u7684\u795E\u8BDD\u7ED3\u5B9E\u2014\u2014\u6709\u516C\u5F00\u6BD4\u8D5B\u753B\u9762\uFF0C\u6709\u9752\u8BAD\u4F53\u7CFB\u7684\u63A5\u6536\u8BB0\u5F55\u3002\u672C\u520A\u53EA\u63D0\u9192\u4E00\u4EF6\u4E8B\uFF1A\u9752\u5E74\u6BD4\u8D5B\u7684\u6837\u672C\u8981\u6253\u6298\u770B\uFF0C\u6298\u6263\u7387\u53D6\u51B3\u4E8E\u5BF9\u624B\u5E74\u9F84\u548C\u8054\u8D5B\u5F3A\u5EA6\u3002\u8FD9\u4E0D\u662F\u6CFC\u51B7\u6C34\uFF0C\u8FD9\u662F\u6C47\u7387\u3002\u8D2B\u6C11\u533A\u8D70\u51FA\u7684\u5C11\u5E74\u503C\u5F97\u6240\u6709\u795D\u798F\uFF0C\u4F46\u795D\u798F\u4E0D\u8BA1\u5165\u62A5\u4EF7\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8001\u961F\u957F\u7684\u7B80\u5386\u521A\u597D\u76F8\u53CD\uFF1A\u6CA1\u6709\u9AD8\u5149\uFF0C\u5168\u662F\u65E5\u5386\u3002\u516B\u652F\u7403\u961F\uFF0C\u5341\u51E0\u5E74\uFF0C\u7B2C\u4E09\u7B2C\u56DB\u7EA7\u522B\uFF0C\u6BCF\u4E2A\u8D5B\u5B63\u90FD\u5728\u3002\u4F55\u585E\u7684\u4EF7\u503C\u4E0D\u5728\u4EFB\u4F55\u4E00\u6B21\u94F2\u62A2\u91CC\uFF0C\u800C\u5728\u201C\u4E22\u7403\u540E\u6709\u4EBA\u8BF4\u8BDD\u201D\u8FD9\u4EF6\u4E8B\u672C\u8EAB\u3002\u672C\u5468\u5C71\u8C37\u9547\u7684\u6765\u4FE1\u5199\u5F97\u5F88\u8BDA\u6073\uFF1A\u5C0F\u9547\u9700\u8981\u4E00\u652F\u804C\u4E1A\u7403\u961F\uFF0C\u9700\u8981\u4E00\u4E2A\u89C1\u8FC7\u5C71\u9876\u7684\u4EBA\u5E26\u8DEF\u3002\u5E74\u8F7B\u7403\u5458\u8D1F\u8D23\u4E0A\u9650\uFF0C\u8001\u961F\u957F\u8D1F\u8D23\u4E0B\u9650\u3002\u7B7E\u524D\u8005\u8D4C\u672A\u6765\uFF0C\u7B7E\u540E\u8005\u4E70\u73B0\u5728\u3002\u9884\u7B97\u5141\u8BB8\u7684\u8BDD\uFF0C\u5404\u6765\u4E00\u4E2A\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4E0A\u9650\u8BA9\u7403\u8FF7\u4E70\u7968\uFF0C\u4E0B\u9650\u8BA9\u6559\u7EC3\u7761\u89C9\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u6C47\u7387\u8BF4\u660E"
