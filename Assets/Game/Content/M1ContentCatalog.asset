        chineseSimplified: "\u7B2C\u4E8C\u4EBA\u751F\u7403\u5458\u7684\u4F53\u68C0\u8981\u52A0\u4E24\u9875\uFF1A\u8DB3\u7403\u524D\u7684\u804C\u4E1A\u53F2\u3001\u8DB3\u7403\u5916\u7684\u8FD0\u52A8\u53F2\u3002\u635F\u8017\u548C\u5929\u8D4B\u53EF\u80FD\u6765\u81EA\u540C\u4E00\u4E2A\u5730\u65B9\u3002"
