      deck:
        chineseSimplified: "\u4E94\u4EBA\u5236\u8D5B\u573A\u6700\u7075\u5DE7\u7684\u811A\uFF0C\u548C\u897F3\u6700\u7A33\u5B9A\u7684\u4F4E\u6210\u672C\u5C04\u624B\uFF0C\u672C\u5468\u90FD\u5728\u8D27\u67B6\u4E0A\u3002"
