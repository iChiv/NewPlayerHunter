        chineseSimplified: "\u95EE\u9898\u4E0D\u5728\u4E8E\u8FD9\u4E9B\u7ECF\u5386\u662F\u5426\u771F\u5B9E\u2014\u2014\u5B83\u4EEC\u90FD\u53EF\u67E5\u2014\u2014\u800C\u5728\u4E8E\u5B83\u4EEC\u80FD\u4E3A\u4E0B\u5468\u7684\u6DD8\u6C70\u8D5B\u9884\u652F\u591A\u5C11\u8FDB\u7403\u3002\u5386\u53F2\u53EF\u4EE5\u8BC1\u660E\u80FD\u529B\uFF0C\u4E0D\u80FD\u9884\u8BA2\u6BD4\u5206\u3002"
