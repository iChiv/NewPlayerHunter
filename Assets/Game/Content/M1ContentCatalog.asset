        english: 
      bodyLeft:
        chineseSimplified: "\u76F2\u4FA7\u7684\u7269\u7406\u5B66\u57FA\u7840\u662F\u4EBA\u7C7B\u7684\u8116\u5B50\uFF1A\u9632\u5B88\u8005\u56DE\u5934\u770B\u7403\u7684\u77AC\u95F4\uFF0C\u80A9\u8180\u540E\u9762\u4F1A\u5F00\u51FA\u4E00\u5757\u514D\u8D39\u7A7A\u95F4\uFF0C\u79DF\u671F\u534A\u79D2\u3002\u4F18\u79C0\u7684\u524D\u950B\u4E0D\u4F4F\u5728\u8D8A\u4F4D\u7EBF\u4E0A\uFF0C\u4F4F\u5728\u90A3\u5757\u7A7A\u95F4\u91CC\u3002\u51AC\u7A97\u6211\u4EEC\u5199\u8FC7\u4E00\u540D\u559C\u6B22\u4ECE\u524D\u950B\u8EAB\u540E\u94BB\u8FDB\u7981\u533A\u7684\u5E74\u8F7B\u4EBA\u2014\u2014\u4ED6\u7684\u6574\u6761\u8DEF\u7EBF\uFF0C\u51E0\u4E4E\u5168\u7A0B\u4E0D\u4EA4\u201C\u89C6\u7EBF\u7A0E\u201D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u9632\u5B88\u7AEF\u7684\u5BF9\u5E94\u53EB\u201C\u76F2\u533A\u8F6E\u503C\u201D\uFF1A\u4E2D\u536B\u770B\u7403\u65F6\u8FB9\u536B\u6536\u80A9\uFF0C\u8FB9\u536B\u88AB\u7A81\u7834\u65F6\u540E\u8170\u6362\u4F4D\u3002\u5931\u7403\u56DE\u653E\u91CC\u6700\u5E38\u89C1\u7684\u4E00\u53E5\u8BDD\u662F\u201C\u6211\u4EE5\u4E3A\u4ED6\u5728\u4F60\u90A3\u8FB9\u201D\u2014\u2014\u76F2\u4FA7\u5931\u7403\u4ECE\u6765\u4E0D\u662F\u4E00\u4E2A\u4EBA\u7684\u5931\u8BEF\uFF0C\u662F\u4E24\u4E2A\u4EBA\u5171\u540C\u7684\u5BA2\u6C14\u3002\u8BAD\u7EC3\u573A\u4E0A\u7EA0\u6B63\u5B83\u7684\u529E\u6CD5\u4E5F\u5F88\u6734\u7D20\uFF1A\u8981\u6C42\u6BCF\u4E2A\u4EBA\u4F20\u7403\u524D\u5148\u62A5\u51FA\u81EA\u5DF1\u4F59\u5149\u91CC\u6709\u8C01\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6700\u597D\u7684\u8DD1\u4F4D\uFF0C\u662F\u8BA9\u5BF9\u65B9\u540E\u536B\u6000\u7591\u81EA\u5DF1\u7684\u4F59\u5149\u3002\u201D"
        english: 
