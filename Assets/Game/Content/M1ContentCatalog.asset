        chineseSimplified: "\u672A\u6765\u4E4B\u661F\u4FF1\u4E50\u90E8\u5728\u627E\u4E8C\u5341\u5C81\u4E0A\u4E0B\u3001\u503C\u5F97\u957F\u671F\u57F9\u517B\u7684\u4E2D\u573A\u3002\u672C\u671F\u4E24\u4F4D\u90FD\u4E0D\u5728\u8BE5\u8D27\u67B6\uFF0C\u4F46\u6362\u7B97\u8868\u901A\u7528\u3002"
