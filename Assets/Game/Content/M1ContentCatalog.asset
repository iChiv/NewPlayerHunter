        chineseSimplified: "\u63A5\u4E0B\u6765\u9881\u53D1\u8D5B\u5B63\u4EBA\u7269\u7C7B\u5956\u9879\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u7B2C\u516D\u5EA7\uFF0C\u5E74\u5EA6\u6BD4\u55BB\u5956\uFF1A\u201C\u65F6\u901F\u4E24\u767E\u516C\u91CC\u7684\u5766\u514B\u201D\uFF0C\u4E00\u4E2A\u8BA9\u6574\u4E2A\u8054\u8D5B\u8FB9\u8DEF\u5B66\u4F1A\u8BA9\u8DEF\u7684\u5F62\u5BB9\u3002\u7B2C\u4E03\u5EA7\uFF0C\u5E74\u5EA6\u6EE4\u955C\u5956\uFF1A\u56DB\u767E\u4E07\u7C89\u4E1D\u7684\u7F51\u7EA2\u524D\u950B\uFF0C\u4ED6\u7684\u7403\u6280\u4E0E\u526A\u8F91\u5E08\u5171\u4EAB\u5956\u676F\uFF0C\u5E95\u5EA7\u523B\u7740\u5C0F\u5B57\u2014\u2014\u201C\u89C6\u9891\u6240\u793A\u80FD\u529B\u4EE5\u5B9E\u7269\u4E3A\u51C6\u201D\u3002\u7B2C\u516B\u5EA7\uFF0C\u5E74\u5EA6\u8D54\u7387\u5956\uFF1A\u5341\u6B21\u8FC7\u4EBA\u4E5D\u6B21\u5931\u8D25\u7684\u8D4C\u5F92\uFF0C\u6210\u529F\u7684\u90A3\u4E00\u6B21\u5DF2\u88AB\u5FAA\u73AF\u64AD\u653E\u81F3\u4E0B\u8D5B\u5B63\u5B63\u524D\u8D5B\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u7B2C\u4E5D\u5EA7\uFF0C\u5E74\u5EA6\u59D4\u5A49\u8BED\u5956\uFF1A\u201C\u79C1\u751F\u6D3B\u68C0\u70B9\u95EE\u9898\u201D\uFF0C\u51AC\u7A97\u6700\u5FD9\u788C\u7684\u4E03\u4E2A\u5B57\uFF0C\u672C\u520A\u7ACB\u573A\u4E0D\u53D8\u2014\u2014\u8BF7\u4EE5\u8BAD\u7EC3\u51FA\u52E4\u8BB0\u5F55\u4EE3\u66FF\u731C\u6D4B\u3002\u7B2C\u5341\u5EA7\uFF0C\u5E74\u5EA6\u9650\u5B9A\u8BCD\u5956\uFF1A\u201C\u6700\u5E74\u8F7B\u7EAA\u5F55\u201D\uFF0C\u7EAA\u5F55\u5C5E\u5B9E\uFF0C\u9650\u5B9A\u8BCD\u4E5F\u5C5E\u5B9E\uFF0C\u5728\u672C\u8D5B\u5B63\u7684\u4FE1\u606F\u73AF\u5883\u91CC\uFF0C\u8FD9\u51E0\u4E4E\u503C\u5F97\u4E00\u5EA7\u7EC8\u8EAB\u6210\u5C31\u5956\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u4EBA\u7269\u4F1A\u8FC7\u6C14\uFF0C\u95EE\u9898\u4E0D\u4F1A\uFF1A\u660E\u5E74\u8FD8\u4F1A\u6709\u65B0\u7684\u56DB\u5341\u4E00\u7403\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u63D0\u540D\u9057\u73E0"
        english: 
      sidebarBody:
        chineseSimplified: "\u201C\u54EA\u91CC\u7F3A\u4EBA\u8865\u54EA\u91CC\u201D\u5148\u751F\u3001\u9A6C\u62C9\u677E\u578B\u4E2D\u573A\uFF0C\u4EE5\u53CA\u6240\u6709\u5728\u4EB2\u5C5E\u63A8\u8350\u680F\u586B\u8868\u7684\u4EBA\u3002"
