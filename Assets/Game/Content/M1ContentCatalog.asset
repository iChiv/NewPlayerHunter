        english: 
      bodyLeft:
        chineseSimplified: "\u9AD8\u538B\u95E8\u5C06\u7684\u8BC4\u4F30\u4ECE\u5931\u7403\u540E\u5F00\u59CB\uFF1A\u88AB\u8FDB\u4E00\u7403\u540E\u7684\u4E0B\u4E00\u4E2A\u5341\u5206\u949F\u3001\u8FDE\u7EED\u89D2\u7403\u4E2D\u7684\u51FA\u51FB\u51B3\u7B56\u3001\u6307\u6325\u9632\u7EBF\u7684\u6709\u6548\u97F3\u91CF\u2014\u2014\u6CE8\u610F\u662F\u6709\u6548\uFF0C\u4E0D\u662F\u6700\u5927\u3002\u4E8C\u6B21\u53CD\u5E94\u548C\u7AD9\u4F4D\u7EAA\u5F8B\u5728\u51B3\u8D5B\u91CC\u4F1A\u88AB\u653E\u5927\u5230\u53EF\u4EE5\u8FDB\u884C\u4E3A\u5206\u6790\u7684\u7A0B\u5EA6\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u98CE\u9669\u9879\uFF1A\u4E45\u672A\u53C2\u8D5B\u8005\u7684\u6BD4\u8D5B\u8282\u594F\u3001\u70B9\u7403\u5386\u53F2\u6837\u672C\u7684\u771F\u5B9E\u6027\u3001\u4EE5\u53CA\u51C6\u5907\u6D41\u7A0B\u7684\u957F\u5EA6\u3002\u6709\u7684\u95E8\u5C06\u5F00\u4E00\u6B21\u95E8\u7403\u8981\u76D6\u5341\u4E5D\u4E2A\u7AE0\uFF0C\u6587\u4E66\u9F50\u5168\u4F46\u53CD\u51FB\u5DF2\u6B7B\u2014\u2014\u51B3\u8D5B\u7684\u8282\u594F\u4E0D\u7B49\u624B\u7EED\u3002\u8BF7\u786E\u8BA4\u4F60\u8981\u7684\u662F\u95E8\u536B\uFF0C\u8FD8\u662F\u6863\u6848\u9986\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u8BC4\u4F30\u95E8\u5C06\u8BF7\u770B\u5931\u7403\u4E4B\u540E\uFF0C\u800C\u4E0D\u662F\u96F6\u5C01\u4E4B\u4E2D\u3002\u201D"
