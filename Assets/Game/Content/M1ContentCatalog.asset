        chineseSimplified: "\u9274\u522B\u8981\u70B9"
        english: 
      sidebarBody:
        chineseSimplified: "\u89C6\u9891\u53EF\u4EE5\u526A\u8F91\uFF0C\u6BD4\u8D5B\u4E0D\u80FD\u3002\u7C89\u4E1D\u6570\u662F\u8FD0\u8425\u6570\u636E\uFF0C\u4E0D\u662F\u8FD0\u52A8\u6570\u636E\u3002\u4E24\u8005\u90FD\u5BF9\uFF0C\u4F46\u522B\u7528\u524D\u8005\u7ED9\u540E\u8005\u62A5\u4EF7\u3002"
        english: 
