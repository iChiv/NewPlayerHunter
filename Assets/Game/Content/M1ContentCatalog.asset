        english: 
      sidebarBody:
        chineseSimplified: "\u5C71\u8C37\u9547\uFF1A\u8981\u6709\u9876\u7EA7\u8054\u8D5B\u7ECF\u9A8C\u7684\u4EBA\u5E26\u8DEF\u3002\u9644\u4EF6\u79D1\u6280\uFF1A\u8981\u4E00\u4E2A\u201C\u5C04\u95E8\u65F6\u4E0D\u95ED\u773C\u201D\u7684\u95E8\u5C06\u3002\u95E8\u69DB\u7684\u4E16\u754C\u5343\u5DEE\u4E07\u522B\u3002"
