        chineseSimplified: "\u201C\u7EC8\u7ED3\u8005\u7684\u96C6\u9526\u5F88\u6F02\u4EAE\uFF0C\u96C6\u9526\u7684\u526A\u8F91\u5E08\u4E5F\u5F88\u5FD9\u3002\u201D"
