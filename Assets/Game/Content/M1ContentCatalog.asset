        chineseSimplified: "\u9A6C\u5E93\u65AF\xB7\u5BCC\u6069\u7279\u65AF\u7684\u7B80\u5386\u53EA\u6709\u4E00\u4E2A\u4F4D\u7F6E\u63CF\u8FF0\uFF1A\u201C\u90FD\u53EF\u4EE5\u201D\u3002\u524D\u961F\u53CB\u7684\u8BC1\u8BCD\u8A00\u7B80\u610F\u8D45\uFF1A\u201C\u54EA\u91CC\u7F3A\u4EBA\u4ED6\u90FD\u80FD\u8865\u201D\u3002\u5BF9\u4E86\uFF0C\u4ED6\u4E0E\u672C\u8D5B\u5B63\u65E9\u4E9B\u65F6\u5019\u90A3\u4F4D\u201C\u730E\u4EBA\u201D\u5BCC\u6069\u7279\u65AF\u6CA1\u6709\u4EB2\u5C5E\u5173\u7CFB\uFF0C\u672C\u520A\u5DF2\u6838\u5B9E\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u53EF\u9760\u662F\u8DB3\u7403\u91CC\u6700\u88AB\u4F4E\u4F30\u7684\u5929\u8D4B\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u53EF\u9760\u6027\u53E3\u5F84"
        english: 
      sidebarBody:
        chineseSimplified: "\u5168\u52E4\uFF1A\u770B\u51FA\u573A\u8BB0\u5F55\u4E0E\u7F3A\u5E2D\u539F\u56E0\u3002\u5168\u80FD\uFF1A\u770B\u6BCF\u4E2A\u4F4D\u7F6E\u7684\u5206\u949F\u6570\uFF0C\u800C\u4E0D\u662F\u542C\u201C\u90FD\u80FD\u8E22\u201D\u3002"
