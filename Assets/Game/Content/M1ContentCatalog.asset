        chineseSimplified: "\u7B2C\u4E00\u811A\u5411\u524D\u3001\u6700\u8FD1\u961F\u53CB\u7684\u542F\u52A8\u65B9\u5411\u3001\u4E22\u7403\u65B9\u9635\u578B\u5C1A\u672A\u56DE\u5934\u3002\u4E09\u8005\u9F50\u4E86\u5C31\u5FEB\u8DD1\u3002"
