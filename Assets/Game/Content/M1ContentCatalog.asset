        english: 
      bodyLeft:
        chineseSimplified: "\u5230\u4E86\u56DB\u6708\uFF0C\u6837\u672C\u7EC8\u4E8E\u591F\u5927\uFF1A\u5168\u5B63\u5F55\u50CF\u3001\u5F3A\u5F3A\u5BF9\u8BDD\u3001\u5BA2\u573A\u8868\u73B0\u3001\u8FDE\u7EED\u4E09\u5468\u7684\u7A33\u5B9A\u6027\uFF0C\u90FD\u53EF\u4EE5\u4EA4\u53C9\u9A8C\u8BC1\u3002\u73B0\u5728\u5199\u8FDB\u6863\u6848\u7684\u62A5\u544A\uFF0C\u590F\u5929\u53EF\u4EE5\u76F4\u63A5\u8C03\u6863\uFF0C\u4E0D\u5FC5\u518D\u4ECE\u201C\u636E\u8BF4\u201D\u5F00\u59CB\u3002\u56DB\u6708\u7684\u5F55\u50CF\u662F\u6709\u5229\u606F\u7684\uFF0C\u4E00\u6708\u518D\u53D6\u3002"
        english: 
