        chineseSimplified: "\u9677\u9631\u4E00\u4FA7\uFF1A\u4E45\u758F\u6218\u9635\u7684\u6BD4\u8D5B\u8282\u594F\u65E0\u6CD5\u9760\u8BAD\u7EC3\u6A21\u62DF\uFF0C\u53CB\u8C0A\u8D5B\u5F3A\u5EA6\u662F\u5E7B\u89C9\uFF0C\u201C\u8BAD\u7EC3\u578B\u7403\u5458\u201D\u662F\u771F\u5B9E\u5B58\u5728\u7684\u7269\u79CD\u3002\u8BC4\u4F30\u66FF\u8865\u8BF7\u7528\u591A\u6E20\u9053\uFF1A\u9752\u5E74\u961F\u6BD4\u8D5B\u3001\u961F\u5185\u5BF9\u6297\u7EDF\u8BA1\u3001\u4EE5\u53CA\u8BAD\u7EC3\u573A\u8FB9\u7EBF\u2014\u2014\u90A3\u91CC\u6BD4\u65B0\u95FB\u53D1\u5E03\u4F1A\u8BDA\u5B9E\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u677F\u51F3\u957F\u5EA6\u53EF\u4EE5\u91CF\uFF0C\u677F\u51F3\u6E29\u5EA6\u8981\u4F38\u624B\u3002\u201D"
