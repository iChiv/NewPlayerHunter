        chineseSimplified: "\u81EA\u7531\u8EAB\u3001\u79DF\u501F\u4E0E\u9752\u8BAD\u7684\u9690\u5F62\u8D26\u5355\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u7D27\u7F29\u5DE5\u5177\u7BB1\u5C31\u4E09\u6837\uFF1A\u81EA\u7531\u8EAB\u3001\u79DF\u501F\u3001\u9752\u8BAD\u3002\u81EA\u7531\u8EAB\u7684\u6210\u672C\u5728\u5DE5\u8D44\u5355\uFF0C\u79DF\u501F\u7684\u6210\u672C\u5728\u5206\u644A\u6761\u6B3E\uFF0C\u9752\u8BAD\u7684\u6210\u672C\u5728\u65F6\u95F4\u2014\u2014\u800C\u65F6\u95F4\u6070\u6070\u662F\u79EF\u5206\u699C\u4E0D\u80AF\u8D4A\u8D26\u7684\u8D27\u5E01\u3002\u4FBF\u5B9C\u9009\u9879\u91CC\u4E5F\u6709\u8E0F\u5B9E\u8D27\uFF1A\u67D0\u4E9B\u8001\u5C06\u7684\u5168\u90E8\u88C5\u5907\u53EA\u6709\u4E00\u53CC\u65E7\u978B\u548C\u4E00\u53EA\u4FDD\u6E29\u676F\uFF0C\u4F46\u843D\u70B9\u5224\u65AD\u8FD9\u79CD\u4E1C\u897F\uFF0C\u4ECE\u6765\u4E0D\u9700\u8981\u9884\u7B97\u5BA1\u6279\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5356\u4EBA\u5FC3\u7406\u5B66\u662F\u53E6\u4E00\u534A\u5B66\u95EE\uFF1A\u522B\u5728\u6240\u6709\u4EBA\u90FD\u77E5\u9053\u4F60\u7F3A\u94B1\u7684\u65F6\u5019\u6302\u724C\uFF0C\u90A3\u7B49\u4E8E\u7ED9\u62A5\u4EF7\u5355\u6253\u4E03\u6298\u518D\u53D1\u51FA\u53BB\u3002\u4E3B\u5E2D\u70ED\u7EBF\u5728\u7D27\u7F29\u671F\u5C24\u5176\u5371\u9669\uFF0C\u6DF1\u591C\u7684\u4E00\u53E5\u201C\u8981\u4E0D\u6211\u4EEC\u518D\u770B\u770B\u90A3\u4E2A\u8C01\u201D\uFF0C\u7B2C\u4E8C\u5929\u5C31\u4F1A\u53D8\u6210\u4F1A\u8BAE\u7EAA\u8981\u3002\u7D27\u7F29\u4FF1\u4E50\u90E8\u7684\u7B2C\u4E00\u6761\u7EAA\u5F8B\uFF1A\u7A77\u8981\u7A77\u5F97\u6709\u4FDD\u5BC6\u610F\u8BC6\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u7A77\u4E0D\u662F\u95EE\u9898\uFF0C\u8BA9\u5BF9\u624B\u77E5\u9053\u4F60\u7A77\u624D\u662F\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u7701\u94B1\u8BEF\u533A"
        english: 
      sidebarBody:
        chineseSimplified: "\u538B\u4EF7\u5230\u6700\u540E\u4E00\u5468\uFF1B\u7701\u6389\u4F53\u68C0\uFF1B\u8BA9\u4E3B\u6559\u7EC3\u517C\u804C\u53F8\u673A\u2014\u2014\u7B2C\u4E09\u9879\u5DF2\u6709\u4FF1\u4E50\u90E8\u8BD5\u884C\uFF0C\u7ED3\u679C\u4E0D\u4E88\u520A\u767B\u3002"
        english: 
