        chineseSimplified: "\u4ECE\u7403\u8863\u9500\u91CF\u5230\u51FA\u573A\u65F6\u95F4\uFF0C\u540D\u6C14\u7684\u5151\u6362\u7387\u6BCF\u5929\u90FD\u5728\u53D8\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u91D1\u8272\u6C99\u4E18\u7684\u62A5\u4EF7\u903B\u8F91\u5E76\u4E0D\u65B0\u9C9C\uFF1A\u4E70\u540D\u6C14\uFF0C\u987A\u4FBF\u4E70\u8DB3\u7403\u3002\u8FD9\u7C7B\u4EA4\u6613\u7684\u5751\u5728\u4E8E\uFF0C\u540D\u6C14\u662F\u6298\u65E7\u6781\u5FEB\u7684\u8D44\u4EA7\u2014\u2014\u5B83\u6309\u201C\u6700\u8FD1\u4E00\u6B21\u88AB\u63D0\u8D77\u201D\u8BA1\u4EF7\uFF0C\u800C\u4E0D\u662F\u6309\u201C\u6700\u8FD1\u4E00\u6B21\u8FDB\u7403\u201D\u3002\u7B7E\u7EA6\u53D1\u5E03\u4F1A\u4E0A\u7403\u8FF7\u6B22\u547C\u7684\u5206\u8D1D\uFF0C\u4E0E\u534A\u4E2A\u8D5B\u5B63\u540E\u66FF\u8865\u5E2D\u7684\u6E29\u5EA6\uFF0C\u5F80\u5F80\u6210\u53CD\u6BD4\u3002\u672C\u520A\u5EFA\u8BAE\u6240\u6709\u60F3\u4E70\u540D\u6C14\u7684\u4FF1\u4E50\u90E8\u5148\u505A\u4E00\u4E2A\u5C0F\u6D4B\u8BD5\uFF1A\u628A\u540D\u5B57\u906E\u4F4F\uFF0C\u53EA\u770B\u6700\u8FD1\u4E24\u4E2A\u8D5B\u5B63\u7684\u51FA\u573A\u4E0E\u8D21\u732E\uFF0C\u518D\u95EE\u81EA\u5DF1\u8FD8\u6FC0\u52A8\u5417\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u81F3\u4E8E\u201C\u4F20\u5947\u7684\u4EB2\u621A\u201D\u8FD9\u4E2A\u54C1\u79CD\uFF0C\u5E02\u573A\u65E9\u5C31\u7ED9\u51FA\u8FC7\u5B9A\u4EF7\uFF1A\u6545\u4E8B\u5F52\u6545\u4E8B\uFF0C\u5408\u540C\u5F52\u5408\u540C\u3002\u8840\u7F18\u65E0\u6CD5\u901A\u8FC7\u4F53\u68C0\uFF0C\u5929\u8D4B\u4E5F\u6CA1\u6709\u9057\u4F20\u8BC1\u660E\u4E66\u3002\u5F53\u5E74\u201C41\u7403\u201D\u7F57\u91CC\u6559\u4F1A\u6211\u4EEC\uFF1A\u51E1\u662F\u9700\u8981\u90BB\u5C45\u51FA\u9762\u4F5C\u8BC1\u7684\u5929\u8D4B\uFF0C\u4E00\u5F8B\u6309\u4F20\u95FB\u5904\u7406\u3002\u91D1\u8272\u6C99\u4E18\u7684\u94B1\u4E0D\u662F\u6211\u4EEC\u7684\u94B1\uFF0C\u4F46\u672C\u520A\u8FD8\u662F\u529D\u4E00\u53E5\uFF1A\u652F\u7968\u672C\u6253\u5F00\u4E4B\u524D\uFF0C\u5148\u628A\u5F55\u50CF\u6253\u5F00\u3002"
        english: 
