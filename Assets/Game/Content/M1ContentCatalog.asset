        chineseSimplified: "\u5965\u7EB3\u5E93\uFF1A\u811A\u4E0B\u6709\u7403\uFF0C\u5FC3\u4E2D\u6709\u56FE"
        english: 
      deck:
        chineseSimplified: "\u88AB\u6539\u9020\u6210\u95E8\u5C06\u7684\u524D\u573A\u7403\u5458\uFF0C\u51FA\u7403\u662F\u5929\u8D4B\uFF0C\u6251\u6551\u662F\u624B\u827A\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u51FA\u7403\u80FD\u529B\u662F\u771F\u6750\u5B9E\u6599\uFF1A\u538B\u529B\u4E0B\u7B2C\u4E00\u811A\u89E6\u7403\u4ECE\u5BB9\uFF0C\u957F\u77ED\u4F20\u90FD\u6709\u8C31\uFF0C\u540E\u573A\u7EC4\u7EC7\u65F6\u7684\u9009\u4F4D\u601D\u8DEF\u660E\u663E\u5E26\u7740\u524D\u573A\u7403\u5458\u7684\u89C6\u89D2\u2014\u2014\u4ED6\u672C\u5C31\u662F\u56E0\u53CD\u5E94\u5FEB\u88AB\u6539\u9020\u6210\u95E8\u5C06\u7684\u3002\u5728\u4E4B\u524D\u7684\u4F53\u7CFB\u91CC\uFF0C\u4ED6\u957F\u671F\u62C5\u4EFB\u540E\u573A\u7B2C\u4E00\u51FA\u7403\u70B9\uFF0C\u8FD9\u4E0D\u662F\u5305\u88C5\u3002\u5FC3\u6001\u6C89\u7A33\uFF0C\u4E22\u7403\u540E\u4E0B\u4E00\u811A\u5904\u7406\u4E0D\u614C\u4E71\uFF0C\u8FD9\u4E00\u70B9\u6BD4\u811A\u6CD5\u66F4\u96BE\u5F97\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8F6C\u578B\u7684\u53E6\u4E00\u9762\u4E5F\u5199\u5F97\u660E\u767D\uFF1A\u6251\u6551\u662F\u624B\u827A\u6D3B\uFF0C\u4ED6\u7684\u624B\u827A\u53EA\u80FD\u7B97\u53CA\u683C\u3002\u95E8\u7EBF\u53CD\u5E94\u3001\u4E00\u5BF9\u4E00\u5C01\u5835\u90FD\u4E0D\u7B97\u5F3A\u9879\uFF0C\u9AD8\u7403\u5904\u7406\u7684\u7A33\u5B9A\u6027\u4E00\u822C\u3002\u4E70\u4ED6\u7B49\u4E8E\u540C\u65F6\u4E70\u4E0B\u4F7F\u7528\u8BF4\u660E\u2014\u2014\u7403\u961F\u5FC5\u987B\u80FD\u628A\u9632\u7EBF\u63A8\u5230\u4E2D\u573A\uFF0C\u628A\u95E8\u5C06\u7684\u6251\u6551\u9700\u6C42\u964D\u5230\u6700\u4F4E\u3002\u6218\u672F\u4E0D\u5BF9\u53E3\uFF0C\u4F18\u70B9\u4F1A\u95F2\u7F6E\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u7684\u811A\u89E3\u51B3\u4E86\u4F60\u7684\u51FA\u7403\uFF0C\u8C01\u6765\u89E3\u51B3\u4F60\u7684\u6251\u6551\uFF1F"
        english: 
