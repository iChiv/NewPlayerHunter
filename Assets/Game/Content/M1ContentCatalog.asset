        chineseSimplified: "\u795E\u8BDD\u5206\u7EA7"
        english: 
      sidebarBody:
        chineseSimplified: "\u4E00\u7EA7\uFF1A\u8F76\u4E8B\u578B\uFF08\u4FDD\u6E29\u676F\uFF09\u3002\u4E8C\u7EA7\uFF1A\u6570\u636E\u578B\uFF08\u9A6C\u62C9\u677E\u540D\u6B21\uFF09\u3002\u4E09\u7EA7\uFF1A\u7EF0\u53F7\u578B\uFF08\u5766\u514B\u3001\u6C38\u52A8\u673A\uFF09\u3002\u91C7\u8D2D\u524D\u8BF7\u786E\u8BA4\u7B49\u7EA7\u3002"
