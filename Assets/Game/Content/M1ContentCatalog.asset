        chineseSimplified: "\u5173\u7A97\u8BED\u8A00\u5B66"
        english: 
      headline:
        chineseSimplified: "\u201C\u6211\u4EEC\u5B8C\u6210\u4E86\u4E3B\u8981\u76EE\u6807\u201D\uFF1A\u5173\u7A97\u58F0\u660E\u5BF9\u7167\u7FFB\u8BD1"
        english: 
      deck:
        chineseSimplified: "\u5B98\u65B9\u8BDD\u672F\u4E0E\u5B9E\u9645\u64CD\u4F5C\u7684\u53C2\u8003\u8BD1\u6587\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u5173\u7A97\u58F0\u660E\u5BF9\u7167\u7FFB\u8BD1\uFF0C\u672C\u5E74\u5EA6\u4FEE\u8BA2\u7248\uFF1A\u201C\u6211\u4EEC\u5B8C\u6210\u4E86\u4E3B\u8981\u76EE\u6807\u201D\u2014\u2014\u6CA1\u4E70\u5230\u9996\u9009\uFF1B\u201C\u73B0\u6709\u9635\u5BB9\u5177\u5907\u7ADE\u4E89\u529B\u201D\u2014\u2014\u9884\u7B97\u5DF2\u9501\uFF1B\u201C\u4FF1\u4E50\u90E8\u7740\u773C\u9752\u8BAD\u201D\u2014\u2014\u9884\u7B97\u9501\u5F97\u6BD4\u8F83\u5F7B\u5E95\uFF1B\u201C\u8FD9\u662F\u4E00\u6B21\u6218\u7565\u6027\u6C89\u9ED8\u201D\u2014\u2014\u4F20\u771F\u673A\u771F\u7684\u574F\u4E86\u3002\u58F0\u660E\u8D8A\u77ED\uFF0C\u4E8B\u60C5\u8D8A\u5927\uFF0C\u8FD9\u662F\u51AC\u7A97\u7684\u6469\u5C14\u5B9A\u5F8B\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5356\u65B9\u7684\u4FEE\u8F9E\u540C\u6837\u7CBE\u5F69\uFF1A\u201C\u5C0A\u91CD\u7403\u5458\u610F\u613F\u201D\u901A\u5E38\u610F\u5473\u7740\u7403\u5458\u5DF2\u7ECF\u79DF\u597D\u4E86\u65B0\u516C\u5BD3\uFF1B\u201C\u53CC\u8D62\u201D\u610F\u5473\u7740\u53CC\u65B9\u90FD\u4E8F\u5F97\u4E0D\u597D\u610F\u601D\u58F0\u5F20\u3002\u800C\u6240\u6709\u5BA3\u5E03\u65B0\u63F4\u201C\u6570\u636E\u51FA\u8272\u201D\u7684\u901A\u7A3F\uFF0C\u5176\u7EDF\u8BA1\u53E3\u5F84\u4E0E\u8D5B\u5B63\u521D\u8457\u540D\u7684\u201C\u56DB\u5341\u4E00\u7403\u201D\u7591\u4F3C\u51FA\u81EA\u540C\u4E00\u5BB6\u51FA\u7248\u793E\u3002\u672C\u520A\u5DF2\u81F4\u51FD\u6C42\u8BC1\uFF0C\u56DE\u4FE1\u662F\u4E00\u5F20\u7A7A\u767D\u7684\u7B2C\u4E8C\u9875\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6BCF\u4EFD\u5173\u7A97\u58F0\u660E\u90FD\u5E94\u9644\u4E00\u4EFD\u8BDA\u5B9E\u5EA6\u9644\u5F55\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u5E38\u89C1\u53E5\u5F0F"
