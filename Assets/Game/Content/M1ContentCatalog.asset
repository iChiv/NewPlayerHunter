      headline:
        chineseSimplified: "\u6D77\u8036\u65AF\uFF1A\u955C\u5934\u91CC\u7684\u7403\u738B"
        english: 
      deck:
        chineseSimplified: "\u89C6\u9891\u91CC\u7684\u6280\u672F\u662F\u771F\u7684\uFF0C\u6BD4\u8D5B\u91CC\u7684\u8BC1\u636E\u662F\u96F6\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u516C\u5E73\u5730\u8BF4\uFF0C\u4ED6\u7684\u7403\u611F\u4E0D\u662F\u6F14\u7684\uFF1A\u89C6\u9891\u91CC\u7684\u98A0\u7403\u3001\u5C0F\u8303\u56F4\u63A7\u7403\u6709\u771F\u529F\u592B\uFF0C\u660E\u663E\u662F\u4ECE\u5C0F\u8E22\u8FC7\u7403\u7684\u4EBA\u3002\u955C\u5934\u611F\u3001\u8868\u8FBE\u6B32\u3001\u4EB2\u548C\u529B\u90FD\u662F\u804C\u4E1A\u7EA7\u522B\u2014\u2014\u5982\u679C\u201C\u804C\u4E1A\u201D\u6307\u7684\u662F\u53D1\u5E03\u4F1A\u7684\u804C\u4E1A\u3002\u5BF9\u9700\u8981\u66DD\u5149\u5EA6\u7684\u4FF1\u4E50\u90E8\uFF0C\u4ED6\u7684\u5546\u4E1A\u4EF7\u503C\u6E05\u6670\u53EF\u7B97\uFF1A\u7C89\u4E1D\u753B\u50CF\u3001\u4E92\u52A8\u6570\u636E\u3001\u5E26\u8D27\u8BB0\u5F55\uFF0C\u5168\u90E8\u516C\u5F00\u53EF\u67E5\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u7ADE\u6280\u90E8\u5206\u5219\u5B8C\u5168\u7A7A\u767D\uFF1A\u6CA1\u6709\u6210\u5E74\u6B63\u5F0F\u6BD4\u8D5B\u8BB0\u5F55\uFF0C\u6CA1\u6709\u4F53\u6D4B\u6570\u636E\uFF0C\u6CA1\u6709\u5BF9\u6297\u6837\u672C\u3002\u89C6\u9891\u662F\u526A\u8F91\u7684\u827A\u672F\uFF0C\u5355\u6311\u91CE\u7403\u548C\u5341\u4E00\u4EBA\u5236\u662F\u4E24\u4E2A\u9879\u76EE\u3002\u5E74\u9F84\u4E5F\u4E0D\u7AD9\u5728\u201C\u4ECE\u5934\u57F9\u517B\u201D\u8FD9\u4E00\u8FB9\u3002\u82E5\u7B7E\u4ED6\uFF0C\u8BF7\u628A\u5546\u4E1A\u6761\u6B3E\u4E0E\u7ADE\u6280\u6761\u6B3E\u5206\u5F00\uFF1A\u53D1\u5E03\u4F1A\u53EF\u4EE5\u538B\u8F74\uFF0C\u9996\u53D1\u9700\u8981\u8003\u6838\u3002\u987A\u5E8F\u5343\u4E07\u522B\u53CD\uFF0C\u53CD\u4E86\u5C31\u662F\u4E8B\u6545\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u80FD\u5356\u51FA\u95E8\u7968\uFF0C\u95EE\u9898\u662F\u8C01\u6765\u8D62\u4E0B\u6BD4\u8D5B\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u8BC1\u636E\u7B49\u7EA7"
        english: 
      sidebarBody:
        chineseSimplified: "\u8D26\u53F7\u6570\u636E\uFF1A\u5E73\u53F0\u53EF\u67E5\uFF0C\u5DF2\u6838\u3002\u6BD4\u8D5B\u6837\u672C\uFF1A\u65E0\u3002\u8BC1\u636E\u7B49\u7EA7\uFF1A\u672A\u9A8C\u8BC1\u3002\u5EFA\u8BAE\u6D41\u7A0B\uFF1A\u5148\u516C\u5F00\u8BD5\u8BAD\uFF0C\u518D\u5F00\u53D1\u5E03\u4F1A\u3002"
