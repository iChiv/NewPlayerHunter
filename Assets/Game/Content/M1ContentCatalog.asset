      deck:
        chineseSimplified: "\u7ED9\u201C\u4E0D\u7A33\u5B9A\u201D\u6807\u4EF7\u4E4B\u524D\uFF0C\u5148\u641E\u6E05\u695A\u5B83\u4E0D\u7A33\u5B9A\u7684\u539F\u56E0\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u8F6C\u4F1A\u5E02\u573A\u5BF9\u201C\u72B6\u6001\u8D77\u4F0F\u201D\u5411\u6765\u6001\u5EA6\u7C97\u66B4\uFF1A\u76F4\u63A5\u6253\u6298\u3002\u4F46\u672C\u520A\u7684\u5341\u4E5D\u5F20\u8868\u2014\u2014\u5BF9\uFF0C\u5C31\u662F\u7C73\u6D1B\u90A3\u5341\u4E5D\u5F20\u8868\u2014\u2014\u65E9\u5C31\u8BF4\u660E\u4E00\u4EF6\u4E8B\uFF1A\u6CE2\u52A8\u4E5F\u5206\u54C1\u79CD\u3002\u7B2C\u4E00\u79CD\u662F\u73AF\u5883\u578B\u6CE2\u52A8\uFF0C\u6362\u4E2A\u4F53\u7CFB\u5C31\u7A33\u5B9A\uFF0C\u6BD4\u5982\u90A3\u4E9B\u201C\u5728A\u961F\u9690\u8EAB\u3001\u5728B\u961F\u5C01\u795E\u201D\u7684\u4EBA\u3002\u7B2C\u4E8C\u79CD\u662F\u968F\u673A\u578B\u6CE2\u52A8\uFF0C\u8FDE\u4ED6\u81EA\u5DF1\u90FD\u9884\u6D4B\u4E0D\u4E86\uFF0C\u6BD4\u5982\u95EA\u7535\u578B\u8FB9\u950B\u3002\u7B2C\u4E09\u79CD\u662F\u4F2A\u6CE2\u52A8\uFF1A\u51FA\u573A\u88AB\u5207\u5F97\u7C89\u788E\uFF0C\u5206\u949F\u6570\u788E\u6210\u6E23\uFF0C\u8C01\u6765\u4E86\u90FD\u5F97\u201C\u72B6\u6001\u4E0D\u7A33\u201D\u3002\u4E09\u79CD\u6CE2\u52A8\uFF0C\u4E09\u79CD\u4EF7\u683C\uFF0C\u6DF7\u5728\u4E00\u8D77\u8C08\u5C31\u662F\u9001\u94B1\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u7981\u533A\u5E7D\u7075\u662F\u53E6\u4E00\u9053\u5B9A\u4EF7\u96BE\u9898\uFF1A\u4ED6\u7684\u4EA7\u51FA\u9AD8\u5EA6\u96C6\u4E2D\u2014\u2014\u4E0D\u62A2\u65AD\u3001\u4E0D\u7EC4\u7EC7\u3001\u4E0D\u56DE\u9632\uFF0C\u53EA\u505A\u4E00\u4EF6\u4E8B\uFF0C\u51FA\u73B0\u5728\u7403\u5373\u5C06\u51FA\u73B0\u7684\u5730\u65B9\u3002\u8FD9\u7C7B\u7403\u5458\u7684\u6B63\u786E\u4F30\u503C\u65B9\u5F0F\u662F\u6309\u201C\u6BCF90\u5206\u949F\u9884\u671F\u8D21\u732E\u201D\uFF0C\u800C\u4E0D\u662F\u6309\u201C\u5168\u573A\u5B58\u5728\u611F\u201D\u3002\u5B58\u5728\u611F\u4F4E\u5F97\u53EF\u6015\uFF0C\u4EA7\u51FA\u9AD8\u5F97\u7A33\u5B9A\u3002\u672C\u5468\u96FE\u6E2F\u8981\u201C\u4E22\u7403\u540E\u6709\u4EBA\u8BF4\u8BDD\u201D\u7684\u540E\u536B\uFF0C\u7FA4\u5C9B\u8981\u201C\u4E00\u4E2A\u4EBA\u9876\u4E09\u4E2A\u4EBA\u201D\u7684\u4E07\u80FD\u5DE5\u2014\u2014\u9700\u6C42\u5199\u5F97\u8D8A\u5177\u4F53\uFF0C\u4F30\u503C\u8D8A\u4E0D\u5BB9\u6613\u88AB\u6545\u4E8B\u5E26\u8DD1\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u628A\u6CE2\u52A8\u62C6\u5F00\u770B\uFF0C\u6709\u7684\u662F\u98CE\u9669\uFF0C\u6709\u7684\u662F\u6298\u6263\u3002"
        english: 
