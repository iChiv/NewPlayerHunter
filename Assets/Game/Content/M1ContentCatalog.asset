      bodyLeft:
        chineseSimplified: "\u5FC5\u987B\u516C\u5E73\u5730\u8BF4\uFF1A\u9752\u5E74\u8054\u8D5B\u65F6\u671F\u7684\u4ED6\u786E\u5B9E\u6709\u8FC7\u7075\u6C14\uFF0C\u5C0F\u8303\u56F4\u7684\u89E6\u7403\u548C\u60F3\u8C61\u529B\u5E26\u7740\u5357\u7F8E\u8857\u5934\u7684\u5473\u9053\u3002\u201C\u7403\u738B\u6765\u5BB6\u91CC\u5403\u8FC7\u996D\u201D\u7684\u4F20\u95FB\u81F3\u5C11\u8BF4\u660E\uFF0C\u4ED6\u4ECE\u5C0F\u751F\u6D3B\u5728\u8DB3\u7403\u6C1B\u56F4\u91CC\u3002\u8425\u9500\u4EF7\u503C\u4E5F\u662F\u771F\u5B9E\u5B58\u5728\u2014\u2014\u7403\u8863\u80CC\u540E\u5370\u4E0A\u8FD9\u4E2A\u59D3\u6C0F\uFF0C\u786E\u5B9E\u6709\u4EBA\u613F\u610F\u4E70\u5355\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u95EE\u9898\u5728\u4E8E\uFF0C\u201C\u4EB2\u621A\u201D\u4E24\u4E2A\u5B57\u65E0\u6CD5\u901A\u8FC7\u4EFB\u4F55\u4E00\u9879\u8DB3\u7403\u6D4B\u8BD5\u3002\u6210\u5E74\u540E\u7684\u6BD4\u8D5B\u6837\u672C\u7A00\u8584\uFF0C\u4F53\u80FD\u50A8\u5907\u5728\u6B63\u5F0F\u5F3A\u5EA6\u4E0B\u80FD\u6491\u591A\u4E45\u662F\u672A\u77E5\u6570\uFF0C\u804C\u4E1A\u6001\u5EA6\u4E5F\u53EA\u6709\u4F20\u95FB\u7EA7\u522B\u3002\u90BB\u5C45\u7684\u8BC1\u8BCD\u70ED\u60C5\u6D0B\u6EA2\uFF0C\u4F46\u90BB\u5C45\u7684\u8003\u6838\u6807\u51C6\u4E0D\u662F\u804C\u4E1A\u6807\u51C6\u3002\u82E5\u91D1\u8272\u6C99\u4E18\u53EA\u4E3A\u540D\u6C14\u800C\u6765\uFF0C\u8BF7\u4FBF\uFF1B\u82E5\u4E3A\u8FDB\u7403\u800C\u6765\uFF0C\u8BF7\u7ED5\u8DEF\u3002"
