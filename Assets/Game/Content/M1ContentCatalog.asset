        english: 
      bodyLeft:
        chineseSimplified: "\u5F53\u4F53\u80B2\u4E3B\u7BA1\u7684\u9884\u7B97\u8868\u51FA\u73B0\u526A\u89D2\uFF0C\u591A\u9762\u624B\u7684\u884C\u60C5\u5C31\u4F1A\u4E0A\u6DA8\u3002\u80FD\u8E22\u4E09\u4E2A\u4F4D\u7F6E\u7684\u4EBA\u786E\u5B9E\u7701\u94B1\u2014\u2014\u524D\u63D0\u662F\u4F60\u63A5\u53D7\u4ED6\u5728\u4E09\u4E2A\u4F4D\u7F6E\u90FD\u9886\u5230\u540C\u4E00\u4EFD\u201C\u8FD8\u884C\u201D\u7684\u8BC4\u4EF7\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u672C\u520A\u8D70\u8BBF\u4E86\u4E09\u5BB6\u7D27\u7F29\u4FF1\u4E50\u90E8\uFF0C\u5171\u540C\u70B9\u662F\uFF1A\u533B\u7597\u5BA4\u6BD4\u66F4\u8863\u5BA4\u7A7A\uFF0C\u7948\u7977\u5BA4\u6BD4\u5206\u6790\u5BA4\u5FD9\uFF0C\u4EE5\u53CA\u6BCF\u4E2A\u4EBA\u90FD\u58F0\u79F0\u8BA4\u8BC6\u201C\u54EA\u91CC\u7F3A\u4EBA\u8865\u54EA\u91CC\u201D\u5148\u751F\u7684\u8FDC\u623F\u4EB2\u621A\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u4E00\u4E2A\u4EBA\u9876\u4E09\u4E2A\u4EBA\uFF0C\u9996\u5148\u4ED6\u5F97\u9876\u5F97\u4F4F\u81EA\u5DF1\u90A3\u4E00\u4EFD\u3002\u201D"
        english: 
