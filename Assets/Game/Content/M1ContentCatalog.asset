      headline:
        chineseSimplified: "\u81EA\u7531\u8EAB\u5E02\u573A\uFF1A\u4FBF\u5B9C\u662F\u6700\u8D35\u7684\u7B5B\u9009\u6761\u4EF6"
        english: 
      deck:
        chineseSimplified: "\u96F6\u8F6C\u4F1A\u8D39\u4E0D\u7B49\u4E8E\u96F6\u6210\u672C\uFF0C\u7B7E\u5B57\u8D39\u548C\u5DE5\u8D44\u90FD\u5728\u6392\u961F\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u81EA\u7531\u8EAB\u5E02\u573A\u7684\u6807\u8BED\u662F\u201C\u96F6\u8F6C\u4F1A\u8D39\u201D\uFF0C\u8D26\u5355\u4E0D\u662F\uFF1A\u7B7E\u5B57\u8D39\u3001\u4F63\u91D1\u3001\u5DE5\u8D44\u4E00\u6837\u4E0D\u5C11\uFF0C\u53EA\u662F\u6362\u4E86\u4ED8\u6B3E\u540D\u76EE\u3002\u771F\u6B63\u7684\u7B5B\u9009\u5728\u4F53\u68C0\u5BA4\u3002\u6709\u7684\u8001\u5C06\u884C\u674E\u91CC\u53EA\u6709\u4E00\u53EA\u4FDD\u6E29\u676F\uFF0C\u90A3\u662F\u597D\u5146\u5934\u2014\u2014\u8BF4\u660E\u4ED6\u6E05\u695A\u81EA\u5DF1\u7684\u819D\u76D6\u9700\u8981\u4EC0\u4E48\uFF0C\u5E76\u4E14\u5DF2\u7ECF\u548C\u819D\u76D6\u548C\u89E3\u591A\u5E74\u3002\u771F\u6B63\u8981\u8B66\u60D5\u7684\uFF0C\u662F\u8FDE\u4F53\u68C0\u9884\u7EA6\u90FD\u60F3\u6539\u671F\u7684\u4EBA\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u88AB\u653E\u5F03\u8005\u5206\u4E24\u79CD\uFF1A\u5E26\u7740\u8BC1\u660E\u81EA\u5DF1\u7684\u6124\u6012\u7684\uFF0C\u548C\u5E26\u7740\u88AB\u8BC1\u660E\u7684\u75B2\u60EB\u7684\u3002\u524D\u8005\u5728\u8BD5\u8BAD\u91CC\u8FFD\u6BCF\u4E00\u4E2A\u4E8C\u5206\u4E4B\u4E00\u7403\uFF0C\u540E\u8005\u5728\u7B49\u522B\u4EBA\u5148\u4F38\u624B\u3002\u4E09\u5929\u8BD5\u8BAD\u770B\u4E0D\u51FA\u5168\u90E8\uFF0C\u4F46\u770B\u5F97\u51FA\u8FD9\u4E2A\u3002\u6DD8\u91D1\u6307\u5357\u6700\u540E\u4E00\u6761\uFF1A\u6124\u6012\u4F1A\u8FC7\u671F\uFF0C\u75B2\u60EB\u4F1A\u4F20\u67D3\uFF0C\u7B7E\u7EA6\u524D\u8BF7\u786E\u8BA4\u4F60\u4E70\u7684\u662F\u54EA\u4E00\u79CD\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u514D\u8D39\u7403\u5458\u7684\u5DE5\u8D44\u5355\u4ECE\u4E0D\u514D\u8D39\u3002\u201D"
        english: 
