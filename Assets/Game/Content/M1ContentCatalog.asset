        chineseSimplified: "\u5BCC\u6069\u7279\u65AF\uFF1A\u5341\u4E2A\u4F4D\u7F6E\uFF0C\u4E00\u4EFD\u5DE5\u8D44"
        english: 
      deck:
        chineseSimplified: "\u201C\u54EA\u91CC\u7F3A\u4EBA\u4ED6\u90FD\u80FD\u8865\u201D\u2014\u2014\u8FD9\u53E5\u8BDD\u8981\u6309\u4F4D\u7F6E\u9010\u4E2A\u9A8C\u6536\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u591A\u529F\u80FD\u6027\u662F\u771F\u5B9E\u7684\uFF1A\u5730\u533A\u8054\u8D5B\u591A\u5E74\uFF0C\u524D\u573A\u5230\u540E\u573A\u7684\u51FA\u573A\u8BB0\u5F55\u90FD\u80FD\u7FFB\u5230\uFF0C\u6BCF\u4E2A\u4F4D\u7F6E\u90FD\u80FD\u5B8C\u6210\u57FA\u672C\u4EFB\u52A1\uFF0C\u6218\u672F\u7406\u89E3\u56E0\u6B64\u9AD8\u4E8E\u540C\u6C34\u5E73\u7403\u5458\u3002\u6027\u683C\u968F\u548C\uFF0C\u4E34\u5371\u53D7\u547D\u4E0D\u602F\u573A\uFF0C\u676F\u8D5B\u8F6E\u6362\u548C\u4F24\u75C5\u6F6E\u91CC\u4ED6\u662F\u6559\u7EC3\u7684\u5907\u80CE\u7BB1\u3002\u5DE5\u8D44\u9884\u671F\u6E29\u548C\uFF0C\u5BF9\u8584\u9884\u7B97\u7403\u961F\uFF0C\u4ED6\u4E00\u4E2A\u4EBA\u5C31\u662F\u540D\u5355\u6DF1\u5EA6\u7684\u5145\u503C\u5361\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u9A8C\u6536\u65F6\u5FC5\u987B\u62C6\u5F00\u770B\uFF1A\u201C\u90FD\u80FD\u8E22\u201D\u4E0D\u7B49\u4E8E\u201C\u90FD\u8E22\u597D\u201D\uFF0C\u4ED6\u5728\u6BCF\u4E2A\u4F4D\u7F6E\u7684\u4E0A\u9650\u90FD\u662F\u201C\u591F\u7528\u201D\uFF0C\u6CA1\u6709\u4E00\u4E2A\u662F\u201C\u51FA\u8272\u201D\u3002\u4F53\u80FD\u4E00\u822C\uFF0C\u8865\u8FB9\u540E\u536B\u8FD9\u79CD\u9AD8\u6D88\u8017\u4F4D\u7F6E\u65F6\u7EED\u822A\u5403\u7D27\u3002\u5730\u533A\u8054\u8D5B\u7684\u5BF9\u6297\u5F3A\u5EA6\u4E0E\u804C\u4E1A\u8D5B\u573A\u7684\u5DEE\u8DDD\uFF0C\u4F1A\u540C\u65F6\u8003\u9A8C\u4ED6\u6240\u6709\u7684\u4F4D\u7F6E\u3002\u6B63\u786E\u7528\u6CD5\uFF1A\u7279\u5B9A\u573A\u6B21\u7684\u586B\u7A7A\u8005\u3002\u9519\u8BEF\u7528\u6CD5\uFF1A\u5EFA\u961F\u57FA\u77F3\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u80FD\u586B\u4EFB\u4F55\u5751\uFF0C\u524D\u63D0\u662F\u4F60\u522B\u628A\u5751\u6316\u592A\u5927\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u9A8C\u6536\u65B9\u6CD5"
        english: 
      sidebarBody:
        chineseSimplified: "\u9010\u4F4D\u7F6E\u6838\u5BF9\u5206\u949F\u6570\u4E0E\u5BF9\u624B\u7EA7\u522B\uFF0C\u201C\u90FD\u80FD\u8E22\u201D\u6309\u6700\u5F31\u4E00\u73AF\u5B9A\u4EF7\u3002\u53CB\u60C5\u63D0\u793A\uFF1A\u95E8\u5C06\u4F4D\u7F6E\u4E0D\u5728\u5176\u5217\uFF0C\u522B\u88AB\u70ED\u60C5\u51B2\u660F\u5934\u3002"
