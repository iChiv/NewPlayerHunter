        english: 
      sidebarBody:
        chineseSimplified: "\u7761\u7720\u4F18\u5148\uFF1B\u4E0D\u770B\u5931\u8BEF\u96C6\u9526\uFF1B\u4E0D\u4E0E\u70B9\u7403\u624B\u5BF9\u89C6\u8D85\u8FC7\u4E09\u79D2\uFF1B\u624B\u5957\u591A\u5907\u4E00\u526F\u3002"
