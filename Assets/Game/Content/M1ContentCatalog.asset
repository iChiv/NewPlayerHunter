        english: 
      bodyLeft:
        chineseSimplified: "\u51B2\u523A\u671F\u7684\u5FC3\u7406\u7ED3\u6784\u5F88\u5BF9\u79F0\uFF1A\u699C\u9996\u6015\u5931\u53BB\uFF0C\u699C\u5C3E\u6015\u5E0C\u671B\uFF0C\u4E2D\u95F4\u6015\u65E0\u804A\u3002\u538B\u529B\u5728\u663E\u5FAE\u955C\u4E0B\u957F\u5F97\u4E00\u6A21\u4E00\u6837\uFF0C\u533A\u522B\u53EA\u5728\u4E8E\u79EF\u5206\u699C\u7684\u65B9\u5411\u3002\u6559\u7EC3\u53D1\u5E03\u4F1A\u8FDB\u5165\u9AD8\u9891\u6A21\u5F0F\uFF0C\u201C\u4E00\u573A\u4E00\u573A\u8E22\u201D\u7684\u4F7F\u7528\u7387\u4E0E\u4ED6\u7684\u6392\u540D\u7126\u8651\u5448\u6B63\u76F8\u5173\uFF0C\u800C\u4E0E\u7403\u961F\u7684\u5B9E\u9645\u8D5B\u7A0B\u5BC6\u5EA6\u6BEB\u65E0\u5173\u7CFB\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8FD9\u4E2A\u65F6\u8282\u6700\u8003\u9A8C\u9635\u5BB9\u91CC\u7684\u7279\u6B8A\u7269\u79CD\uFF1A\u6BD4\u5982\u90A3\u4F4D\u5341\u6B21\u8FC7\u4EBA\u4E5D\u6B21\u5931\u8D25\u7684\u8D4C\u5F92\u578B\u524D\u950B\u3002\u5E38\u89C4\u8D5B\u91CC\u4E5D\u6B21\u5931\u8D25\u662F\u566A\u97F3\uFF0C\u56DB\u6708\u4EE5\u540E\u6559\u7EC3\u4EEC\u79C1\u4E0B\u627F\u8BA4\u2014\u2014\u5982\u679C\u90A3\u4E00\u6B21\u6210\u529F\u53D1\u751F\u5728\u7B2C
