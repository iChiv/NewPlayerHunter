        chineseSimplified: "\u8BAD\u7EC3\u573A\u8FB9\u7EBF\u6BD4\u65B0\u95FB\u53D1\u5E03\u4F1A\u8BDA\u5B9E\uFF1B\u9752\u5E74\u961F\u6BD4\u8D5B\u5F55\u50CF\uFF1B\u961F\u5185\u5BF9\u6297\u7684\u6280\u672F\u7EDF\u8BA1\u3002"
