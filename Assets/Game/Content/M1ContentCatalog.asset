        english: 
      deck:
        chineseSimplified: "\u51B7\u9759\u3001\u72E1\u733E\u3001\u8001\u7EC3\uFF0C\u8EAB\u4F53\u72B6\u6001\u5374\u50CF\u521A\u8FDB\u804C\u4E1A\u8DB3\u7403\u7684\u5E74\u8F7B\u4EBA\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u6BD4\u8D5B\u5185\u5BB9\u8001\u7EC3\u5F97\u53EF\u6015\uFF1A\u8DD1\u4F4D\u65F6\u673A\u3001\u5047\u52A8\u4F5C\u7684\u8010\u5FC3\u3001\u7EC8\u7ED3\u524D\u7684\u51B7\u9759\uFF0C\u5168\u662F\u201C\u8E22\u8FC7\u5F88\u591A\u5E74\u201D\u7684\u75D5\u8FF9\u3002\u9752\u5E74\u8054\u8D5B\u534A\u573A\u4E09\u7403\u7684\u51FA\u9053\u6218\u6709\u636E\u53EF\u67E5\uFF0C\u95E8\u524D\u7684\u672C\u80FD\u6CA1\u6709\u8FC7\u671F\u3002\u6700\u96BE\u5F97\u7684\u662F\u8EAB\u4F53\u72B6\u6001\u2014\u2014\u901F\u5EA6\u3001\u53D8\u5411\u3001\u8FDE\u7EED\u4F5C\u6218\u80FD\u529B\u4FDD\u6301\u5F97\u50CF\u4E8C\u5341\u51FA\u5934\u3002\u201C\u5E74\u9F84\u7B26\u5408\u6CE8\u518C\u8981\u6C42\u201D\u4E4B\u5916\uFF0C\u4ED6\u7684\u4F53\u80FD\u672C\u8EAB\u5C31\u662F\u4E00\u4EFD\u53CD\u8BC1\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8C1C\u7684\u90E8\u5206\u5FC5\u987B\u5199\u8FDB\u62A5\u544A\uFF1A\u5E74\u9F84\u6210\u8C1C\u610F\u5473\u7740\u804C\u4E1A\u751F\u6DAF\u957F\u5EA6\u65E0\u6CD5\u9884\u4F30\uFF0C\u62A5\u4EF7\u5E74\u9650\u7F3A\u4E4F\u951A\u70B9\u3002\u4E0D\u8C08\u8FC7\u53BB\u610F\u5473\u7740\u80CC\u666F\u6838\u67E5\u5B58\u5728\u76F2\u533A\u3002\u5DC5\u5CF0\u671F\u4E3A\u4F55\u957F\u671F\u6E38\u79BB\u4E8E\u4E3B\u6D41\u89C6\u91CE\u4E4B\u5916\uFF0C\u6CA1\u6709\u4EFB\u4F55\u6743\u5A01\u89E3\u91CA\u3002\u8BC1\u636E\u7B49\u7EA7\uFF1A\u4E2D\u7B49\uFF0C\u5173\u952E\u9879\u7F3A\u5931\u3002\u7B7E\u7EA6\u5EFA\u8BAE\uFF1A\u5E74\u9650\u4ECE\u77ED\uFF0C\u6761\u6B3E\u4ECE\u4E25\uFF0C\u628A\u201C\u8C1C\u201D\u7684\u5B9A\u4EF7\u6743\u63E1\u5728\u81EA\u5DF1\u624B\u91CC\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u8E22\u4E86\u591A\u4E45\u4E0D\u91CD\u8981\uFF0C\u8FD8\u80FD\u8E22\u591A\u4E45\u624D\u91CD\u8981\u2014\u2014\u800C\u8FD9\u6070\u6070\u4E0D\u77E5\u9053\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u8BC1\u636E\u7B49\u7EA7"
        english: 
      sidebarBody:
        chineseSimplified: "\u81EA\u8FF0\uFF1A\u201C\u6BD4\u4F60\u4EEC\u77E5\u9053\u7684\u66F4\u4E45\u201D\u3002\u4F50\u8BC1\uFF1A\u961F\u53CB\u8F6C\u8FF0\u3002\u6863\u6848\uFF1A\u5408\u89C4\u4F46\u7A7A\u767D\u3002\u8BC4\u7EA7\uFF1A\u4E2D\u7B49\uFF0C\u5408\u540C\u5E74\u9650\u8BF7\u81EA\u884C\u52A0\u4FDD\u9669\u3002"
