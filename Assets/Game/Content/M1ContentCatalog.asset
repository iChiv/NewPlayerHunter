        english: 
      bodyLeft:
        chineseSimplified: "\u51B3\u8D5B\u6708\u7684\u4E09\u79CD\u58F0\u97F3\uFF1A\u4E89\u51A0\u961F\u8C08\u51B7\u9759\uFF0C\u4FDD\u7EA7\u961F\u8C08\u5947\u8FF9\uFF0C\u4E2D\u6E38\u961F\u53D1\u5E03\u4E86\u4E0B\u8D5B\u5B63\u7403\u8863\u2014\u2014\u9884\u552E\u9875\u9762\u7684\u52A0\u8F7D\u901F\u5EA6\u6BD4\u7403\u961F\u53CD\u51FB\u8FD8\u5FEB\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u672C\u520A\u4E0D\u8BC4\u4EF7\u54EA\u79CD\u58F0\u97F3\u66F4\u4F53\u9762\u3002\u6211\u4EEC\u53EA\u63D0\u9192\uFF1A\u51B7\u9759\u9700\u8981\u4F53\u80FD\u5B58\u6B3E\uFF0C\u5947\u8FF9\u9700\u8981\u6982\u7387\u8BB8\u53EF\u8BC1\uFF0C\u7403\u8863\u9700\u8981\u6709\u4EBA\u8FD8\u5728\u4E70\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u8D5B\u5B63\u6700\u540E\u4E00\u4E2A\u6708\uFF0C\u4EBA\u4EBA\u6210\u4E86\u54F2\u5B66\u5BB6\uFF0C\u53EA\u6709\u7403\u8863\u5546\u5E97\u662F\u5B9E\u5E72\u5BB6\u3002\u201D"
