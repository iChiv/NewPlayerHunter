        english: 
      bodyLeft:
        chineseSimplified: "\u5148\u8BF4\u597D\u6D88\u606F\uFF1A\u6700\u65B0\u8BAD\u7EC3\u5F55\u50CF\u786E\u8BA4\uFF0C\u5DE6\u811A\u7684\u4F20\u7403\u3001\u8FDC\u5C04\u3001\u4EFB\u610F\u7403\u529F\u592B\u90FD\u5728\uFF0C\u89C6\u91CE\u548C\u8282\u594F\u611F\u662F\u672C\u80FD\uFF0C\u4E0D\u4F1A\u8FC7\u671F\u3002\u804C\u4E1A\u7D20\u517B\u53E3\u7891\u6781\u4F73\uFF0C\u8C6A\u95E8\u5C65\u5386\u4E0E\u56FD\u5BB6\u961F\u5927\u8D5B\u7ECF\u5386\u610F\u5473\u7740\u4ED6\u4E0D\u6035\u4EFB\u4F55\u573A\u9762\u3002\u82E5\u6062\u590D\u5230\u53EF\u7528\u72B6\u6001\uFF0C\u8FD9\u7B14\u7B7E\u7EA6\u7684\u7ADE\u6280\u4E0A\u9650\u662F\u672C\u671F\u5E02\u573A\u6700\u9AD8\u7684\uFF0C\u6CA1\u6709\u4E4B\u4E00\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u7136\u540E\u662F\u90A3\u4EFD\u4F53\u68C0\u62A5\u544A\u524D\u7684\u95EE\u9898\u6E05\u5355\uFF1A\u4E09\u5E74\u51E0\u4E4E\u65E0\u6B63\u5F0F\u6BD4\u8D5B\uFF0C\u6BD4\u8D5B\u4F53\u80FD\u8981\u4ECE\u96F6\u91CD\u5EFA\uFF1B\u5927\u4F24\u4E4B\u540E\u7684\u53CD\u590D\u98CE\u9669\u65E0\u6CD5\u9884\u4F30\uFF1B\u6062\u590D\u671F\u7684\u8010\u5FC3\u4E0E\u85AA\u6C34\u540C\u6837\u6602\u8D35\u3002\u4ED6\u6700\u5408\u9002\u7684\u89D2\u8272\u53EF\u80FD\u4E0D\u662F\u4E3B\u529B\uFF0C\u800C\u662F\u7279\u5B9A\u65F6\u6BB5\u7684\u80DC\u8D1F\u624B\u3002\u62A5\u4EF7\u8BF7\u6309\u201C\u80FD\u7528\u7684\u5206\u949F\u6570\u201D\u8BA1\u7B97\uFF0C\u800C\u4E0D\u662F\u6309\u201C\u66FE\u7ECF\u7684\u9AD8\u5EA6\u201D\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u522B\u4E3A\u8BB0\u5FC6\u4ED8\u9876\u85AA\uFF0C\u4E3A\u5206\u949F\u4ED8\u5DE5\u8D44\u3002"
        english: 
