        english: 
      bodyLeft:
        chineseSimplified: "\u7981\u533A\u91CC\u7684\u90E8\u5206\u53EF\u4EE5\u4FE1\u4EFB\uFF1A\u62A2\u70B9\u3001\u5355\u5200\u3001\u7B2C\u4E00\u53CD\u5E94\u5C04\u95E8\uFF0C\u91D1\u9774\u7ADE\u4E89\u8005\u548C\u9876\u7EA7\u8054\u8D5B\u4E24\u5B63\u7684\u7ECF\u5386\u90FD\u67E5\u5F97\u5230\u3002\u4ED6\u7684\u8DD1\u4F4D\u4E0D\u60CA\u8273\uFF0C\u4F46\u603B\u51FA\u73B0\u5728\u540E\u536B\u6700\u4E0D\u60F3\u770B\u5230\u4EBA\u7684\u4F4D\u7F6E\u3002\u6DD8\u6C70\u8D5B\u4E34\u8FD1\uFF0C\u8FD9\u79CD\u201C\u6B63\u786E\u65F6\u95F4\u51FA\u73B0\u5728\u6B63\u786E\u5730\u70B9\u201D\u7684\u5C65\u5386\u4F1A\u88AB\u91CD\u65B0\u5B9A\u4EF7\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5907\u6CE8\u680F\u540C\u6837\u957F\uFF1A\u201C\u6D6A\u8D39\u673A\u4F1A\u8FC7\u591A\u201D\u7684\u7403\u8FF7\u8BC4\u4EF7\u9700\u8981\u6570\u636E\u590D\u6838\u2014\u2014\u628A\u4ED6\u7684\u91CD\u5927\u673A\u4F1A\u8F6C\u5316\u7387\u548C\u540C\u7EA7\u5C04\u624B\u653E\u5728\u4E00\u8D77\u770B\uFF0C\u522B\u548C\u96C6\u9526\u6BD4\u3002\u53E6\u5916\u8BF7\u786E\u8BA4\u4ED6\u9700\u8981\u7684\u8F93\u9001\u7C7B\u578B\uFF1A\u7EC8\u7ED3\u8005\u7684\u6548\u7387\uFF0C\u4E00\u534A\u5199\u5728\u81EA\u5DF1\u7684\u811A\u4E0A\uFF0C\u4E00\u534A\u5199\u5728\u522B\u4EBA\u7684\u4F20\u7403\u91CC\u3002"
        english: 
