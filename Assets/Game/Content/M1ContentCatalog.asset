        chineseSimplified: "\u6CD5\u91CC\u4E9A\uFF1A\u8FDE\u7EED\u4E5D\u5E74\uFF0C\u573A\u573A\u5728\u518C"
        english: 
      deck:
        chineseSimplified: "\u4E0D\u51FA\u96C6\u9526\u7684\u4E2D\u573A\uFF0C\u51FA\u5168\u52E4\u8BB0\u5F55\u3002\u4F53\u68C0\u62A5\u544A\u5E72\u51C0\u5F97\u50CF\u51FA\u5382\u8BBE\u7F6E\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u53EF\u9760\u6027\u662F\u786C\u6570\u636E\uFF1A\u8FDE\u7EED\u4E5D\u4E2A\u8D5B\u5B63\u51FA\u573A30+\uFF0C\u65E0\u91CD\u5927\u4F24\u75C5\uFF0C\u65E0\u7EAA\u5F8B\u505C\u8D5B\uFF0C\u51FA\u52E4\u66F2\u7EBF\u5E73\u5F97\u50CF\u4E00\u6761\u76F4\u7EBF\u3002\u8E22\u6CD5\u670D\u52A1\u4E8E\u7A33\u5B9A\uFF1A\u4F20\u63A7\u5B89\u5168\uFF0C\u4F4D\u7F6E\u7EAA\u5F8B\u4E25\u660E\uFF0C\u8DD1\u52A8\u91CF\u5E38\u5E74\u5728\u7EBF\u3002\u6559\u7EC3\u66F4\u66FF\u4E0D\u6539\u5176\u4F4D\uFF0C\u8BF4\u660E\u6218\u672F\u517C\u5BB9\u6027\u6781\u5F3A\u3002\u5BF9\u4EFB\u4F55\u9700\u8981\u201C\u5FD8\u6389\u8FD9\u4E2A\u4F4D\u7F6E\u201D\u7684\u7403\u961F\uFF0C\u4ED6\u5C31\u662F\u7B54\u6848\u672C\u8EAB\u3002\u4EF7\u683C\u4E5F\u900F\u7740\u9760\u8C31\u2014\u2014\u6CA1\u6709\u6EA2\u4EF7\u9879\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u786C\u5E01\u7684\u53E6\u4E00\u9762\uFF1A\u4E5D\u5E74\u7684\u7A33\u5B9A\u4E5F\u610F\u5473\u7740\u4E5D\u5E74\u7684\u4E0A\u9650\u6E05\u6670\u53EF\u89C1\u3002\u4ED6\u4E0D\u63D0\u4F9B\u7206\u70B9\uFF0C\u8282\u594F\u504F\u6162\uFF0C\u9AD8\u5F3A\u5EA6\u903C\u62A2\u4E0B\u7684\u51FA\u7403\u4F1A\u8D8B\u4E8E\u4FDD\u5B88\u3002\u5E74\u9F84\u5DF2\u7AD9\u5728\u5408\u540C\u77ED\u5E74\u5316\u7684\u4E00\u8FB9\u3002\u201C\u4ECE\u672A\u53D7\u4F24\u201D\u662F\u8FD0\u6C14\u4E0E\u4F53\u8D28\u7684\u5408\u8C0B\uFF0C\u4E0D\u662F\u6C38\u52A8\u4FDD\u8BC1\u4E66\uFF0C\u4FDD\u9669\u6761\u6B3E\u7167\u4E70\u3002\u4E70\u4ED6\u4E70\u7684\u662F\u786E\u5B9A\u6027\uFF0C\u8BF7\u522B\u5728\u7B7E\u7EA6\u540E\u62B1\u6028\u786E\u5B9A\u6027\u7684\u65E0\u804A\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4E70\u4ED6\u4E0D\u4E3A\u60CA\u559C\uFF0C\u4E3A\u4E0D\u7528\u60F3\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u6838\u67E5\u8BB0\u5F55"
        english: 
      sidebarBody:
        chineseSimplified: "\u4E5D\u5B63\u51FA\u573A\uFF1A\u9010\u5B63\u6838\u5BF9\uFF0C\u5C5E\u5B9E\u3002\u4F53\u68C0\uFF1A\u5F02\u5E38\u5065\u5EB7\uFF0C\u539F\u6587\u5982\u6B64\u3002\u7F3A\u5E2D\u5386\u53F2\uFF1A\u8FD1\u4E4E\u7A7A\u767D\u3002\u7ED3\u8BBA\uFF1A\u53EF\u7B7E\uFF0C\u5E74\u9650\u4ECE\u77ED\u3002"
