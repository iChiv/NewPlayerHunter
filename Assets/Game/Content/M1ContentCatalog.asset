        chineseSimplified: "\u81F3\u5C11\u4E24\u573A\u5BA2\u573A\uFF1B\u81F3\u5C11\u4E00\u573A\u843D\u540E\u72B6\u6001\uFF1B\u6BD4\u5206\u9886\u5148\u65F6\u7684\u884C\u4E3A\u5355\u72EC\u6807\u8BB0\u3002"
