        chineseSimplified: "\u4E5D\u961F\u5C65\u5386\uFF1A\u5DF2\u6838\u3002\u79BB\u961F\u539F\u56E0\uFF1A\u4E5D\u4E2A\u7248\u672C\uFF0C\u4E92\u4E0D\u91CD\u5408\u3002\u5EFA\u8BAE\u9762\u8C08\u65F6\u76F4\u63A5\u95EE\u4ED6\uFF1A\u7B2C\u5341\u652F\u7403\u961F\u60F3\u542C\u4EC0\u4E48\u3002"
