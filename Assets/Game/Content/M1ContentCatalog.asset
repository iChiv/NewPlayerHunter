        chineseSimplified: "\u4ECE\u5DE5\u5730\u76F4\u63A5\u8D70\u56DE\u7403\u573A\u7684\u4EBA\uFF0C\u94F2\u7403\u548C\u5934\u7403\u90FD\u5E26\u7740\u5DE5\u9F84\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u5BF9\u6297\u662F\u4ED6\u7684\u6BCD\u8BED\uFF1A\u8EAB\u4F53\u5F3A\u58EE\uFF0C\u94F2\u7403\u65F6\u673A\u8001\u5230\uFF0C\u5934\u7403\u843D\u70B9\u5224\u65AD\u51C6\uFF0C\u5B9A\u4F4D\u7403\u653B\u9632\u4E24\u7AEF\u90FD\u80FD\u7528\u3002\u6BD4\u8D5B\u98CE\u683C\u5E72\u51C0\u76F4\u63A5\uFF0C\u6CA1\u6709\u591A\u4F59\u52A8\u4F5C\u3002\u6027\u683C\u8E0F\u5B9E\uFF0C\u8BAD\u7EC3\u51FA\u52E4\u7387\u6781\u9AD8\uFF0C\u6559\u7EC3\u5E03\u7F6E\u7684\u4EFB\u52A1\u6309\u5DE5\u5E8F\u5B8C\u6210\u2014\u2014\u4ECA\u5929\u780C\u5899\uFF0C\u660E\u5929\u8FD8\u780C\u5899\uFF0C\u8D28\u91CF\u7A33\u5B9A\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8F6C\u8EAB\u901F\u5EA6\u548C\u811A\u4E0B\u9891\u7387\u662F\u5929\u7136\u77ED\u677F\uFF0C\u9762\u5BF9\u7075\u5DE7\u578B\u524D\u950B\u4F1A\u88AB\u53CD\u590D\u8C03\u5934\u6298\u78E8\u3002\u51FA\u7403\u57FA\u672C\u53EA\u6709\u5B89\u5168\u9009\u9879\uFF0C\u4F53\u7CFB\u8981\u6C42\u4ED6\u53C2\u4E0E\u7EC4\u7EC7\u65F6\u4F1A\u9732\u9985\u3002\u591A\u5E74\u5DE5\u5730\u751F\u6DAF\u7559\u4E0B\u7684\u52B3\u635F\uFF0C\u9700\u8981\u961F\u533B\u9010\u9875\u6838\u5BF9\u3002\u4ED6\u7684\u4E0A\u9650\u8089\u773C\u53EF\u89C1\uFF0C\u4E0B\u9650\u4E5F\u8089\u773C\u53EF\u89C1\u2014\u2014\u4E70\u4ED6\u4E70\u7684\u662F\u540E\u8005\uFF0C\u8BF7\u6309\u9700\u4E0B\u5355\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u4E0D\u60CA\u8273\u4EFB\u4F55\u4EBA\uFF0C\u4E5F\u4E0D\u80CC\u53DB\u4EFB\u4F55\u4EBA\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u9002\u914D\u63D0\u793A"
        english: 
      sidebarBody:
        chineseSimplified: "\u9002\u5408\uFF1A\u94F8\u94C1\u961F\u672C\u5468\u201C\u5E72\u810F\u6D3B\u201D\u5C97\u4F4D\u3002\u4E0D\u9002\u5408\uFF1A\u8981\u6C42\u540E\u536B\u7B2C\u4E00\u811A\u51FA\u7403\u7A7F\u900F\u4E24\u6761\u7EBF\u7684\u4F53\u7CFB\u3002\u8BF4\u660E\u4E66\u968F\u4EBA\u9644\u8D60\u3002"
