        english: 
      bodyLeft:
        chineseSimplified: "\u7B2C\u4E00\u5EA7\uFF0C\u6700\u4F73\u7EDF\u8BA1\u53E3\u5F84\u5956\uFF0C\u6388\u4E88\u8D5B\u5B63\u521D\u90A3\u4EFD\u201C\u56DB\u5341\u4E00\u7403\u201D\uFF1A\u6CA1\u6709\u8054\u8D5B\u540D\u79F0\u3001\u6CA1\u6709\u51FA\u573A\u6570\u3001\u6CA1\u6709\u6BD4\u8D5B\u7EA7\u522B\uFF0C\u5374\u6210\u529F\u8BA9\u5168\u884C\u4E1A\u7684\u7403\u63A2\u5728\u63A5\u4E0B\u6765\u4E00\u5E74\u91CC\u5148\u95EE\u53E3\u5F84\u518D\u62A5\u4EF7\u3002\u7B2C\u4E8C\u5EA7\uFF0C\u91D1\u4FDD\u6E29\u676F\u5956\uFF0C\u6388\u4E88\u90A3\u53EA\u968F\u961F\u591A\u5E74\u7684\u4FDD\u6E29\u676F\u2014\u2014\u5B83\u89C1\u8BC1\u4E86\u843D\u70B9\u5224\u65AD\u6BD4\u51B2\u523A\u66F4\u957F\u5BFF\uFF0C\u5E76\u4EE5\u5168\u7968\u8FDE\u4EFB\u201C\u6700\u53EF\u9760\u5728\u573A\u4EBA\u5458\u201D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u7B2C\u4E09\u5EA7\uFF0C\u5E74\u5EA6\u75C5\u5047\u5956\uFF0C\u6388\u4E88\u201C\u4E94\u8FDE\u6251\u201D\u4F20\u8BF4\u91CC\u52A9\u8DD1\u524D\u8BF7\u75C5\u5047\u7684\u7B2C\u4E94\u4F4D\u4E3B\u7F5A\u8005\uFF1A\u4ED6\u7684\u7F3A\u5E2D\u634D\u536B\u4E86\u7EDF\u8BA1\u7684\u771F\u5B9E\u6027\u3002\u7B2C\u56DB\u5EA7\uFF0C\u6700\u4F73\u906E\u6321\u5956\uFF0C\u6388\u4E88\u90A3\u5757\u6321\u4F4F\u7403\u8863\u53F7\u7801\u7684\u4E09\u660E\u6CBB\uFF0C\u5B83\u6559\u4F1A\u6211\u4EEC\u8BC1\u636E\u4E5F\u4F1A\u997F\u3002\u7B2C\u4E94\u5EA7\uFF0C\u5E74\u5EA6\u6587\u4E66\u5956\uFF0C\u7531\u5341\u4E5D\u5F20\u8868\u4E0E\u4E00\u53F0\u5361\u7EB8\u4F20\u771F\u673A\u5171\u4EAB\u2014\u2014\u624B\u7EED\u9F50\u5168\uFF0C\u53CD\u51FB\u5DF2\u6B7B\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u672C\u8D5B\u5B63\u7684\u6BCF\u4E2A\u7B11\u8BDD\u90FD\u5728\u540C\u4E00\u6761\u6218\u7EBF\u4E0A\uFF1A\u5148\u6838\u5B9E\uFF0C\u518D\u520A\u767B\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u83B7\u5956\u611F\u8A00"
        english: 
      sidebarBody:
        chineseSimplified: "\u4FDD\u6E29\u676F\uFF1A\u201C\u6C34\u8FD8\u662F\u6E29\u7684\u3002\u201D\u4E09\u660E\u6CBB\uFF1A\u7F3A\u5E2D\uFF0C\u7531\u5BB6\u5C5E\u4EE3\u9886\u3002\u4F20\u771F\u673A\uFF1A\u7EF4\u4FEE\u4E2D\uFF0C\u65E0\u6CD5\u5230\u573A\u3002"
