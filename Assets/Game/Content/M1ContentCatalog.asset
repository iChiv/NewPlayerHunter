        chineseSimplified: "\u963F\u91CC\xB7\u54C8\u6851\u7684\u5C65\u5386\u8868\u5E72\u51C0\u5F97\u53EF\u7591\uFF1A\u9752\u5E74\u8054\u8D5B\u534A\u573A\u4E09\u7403\u51FA\u9053\uFF0C\u968F\u540E\u8D44\u6599\u9875\u53EA\u5269\u4E00\u53E5\u201C\u5E74\u9F84\u7B26\u5408\u6CE8\u518C\u8981\u6C42\u201D\u3002\u961F\u53CB\u8BF4\uFF0C\u4ED6\u4ECE\u4E0D\u8C08\u8FC7\u53BB\uFF0C\u53EA\u8BF4\u201C\u6211\u8E22\u7403\u7684\u65F6\u95F4\u6BD4\u4F60\u4EEC\u77E5\u9053\u7684\u66F4\u4E45\u201D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u6258\u9A6C\u65AF\xB7\u91CC\u5FB7\u7684\u7B80\u5386\u5219\u7CBE\u786E\u5230\u5C0F\u6570\u70B9\uFF1A19\u5C81\u79BB\u5F00\u804C\u4E1A\u8DB3\u7403\uFF0C23\u5C81\u56DE\u6765\uFF0C\u5982\u4ECA\u573A\u5747\u8DD1\u52A818\u516C\u91CC\uFF0C\u524D\u573A\u538B\u8FEB\u4ECE\u7B2C\u4E00\u5206\u949F\u8FDB\u884C\u5230\u8865\u65F6\u3002\u672C\u5468\u70ED\u641C\u961F\u8FD8\u5728\u627E\u201C\u80FD\u4E0A\u65B0\u95FB\u7684\u4EBA\u201D\u2014\u2014\u201C\u5E7D\u7075\u201D\u5DF2\u7ECF\u4E0A\u4E86\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4E00\u4EFD\u7B80\u5386\u6CA1\u6709\u5E74\u9F84\uFF0C\u4E00\u4EFD\u7B80\u5386\u5168\u662F\u91CC\u7A0B\u3002"
