        chineseSimplified: "\u62F3\u53F0\u6765\u7684\u4EBA\u548C\u724C\u684C\u6765\u7684\u4EBA\uFF0C\u90FD\u5F97\u5148\u8FC7\u8DB3\u7403\u7684\u7B97\u76D8\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u8DE8\u754C\u8FD0\u52A8\u5458\u7684\u5356\u70B9\u6C38\u8FDC\u8BF1\u4EBA\uFF1A\u62F3\u51FB\u624B\u7684\u6838\u5FC3\u529B\u91CF\u3001\u6297\u51FB\u6253\u548C\u4E00\u5BF9\u4E00\u5FC3\u7406\u6218\uFF0C\u542C\u8D77\u6765\u5C31\u662F\u4E3A\u7981\u533A\u8089\u640F\u5B9A\u5236\u7684\u3002\u4F46\u62F3\u53F0\u7EAA\u5F8B\u548C\u7981\u533A\u7EAA\u5F8B\u6709\u4E2A\u81F4\u547D\u5DEE\u522B\u2014\u2014\u62F3\u51FB\u91CC\u6402\u62B1\u662F\u6280\u672F\uFF0C\u8DB3\u7403\u91CC\u6402\u62B1\u662F\u70B9\u7403\u3002\u51EF\u5229\u4EEC\u7684\u8F6C\u578B\u8BC4\u4F30\u8981\u76EF\u7D27\u201C\u624B\u90E8\u4E60\u60EF\u201D\u8FD9\u4E00\u9879\uFF1A\u524D\u81C2\u5361\u4F4D\u662F\u827A\u672F\uFF0C\u53CC\u624B\u4E0A\u80CC\u662F\u707E\u96BE\u3002\u597D\u6D88\u606F\u662F\uFF0C\u62F3\u51FB\u51FA\u8EAB\u7684\u4EBA\u901A\u5E38\u4E0D\u6015\u6328\u9A82\uFF0C\u6559\u7EC3\u6539\u9020\u8D77\u6765\u987A\u624B\u3002\u5BF9\u6297\u53EF\u4EE5\u6559\uFF0C\u80C6\u91CF\u6559\u4E0D\u4E86\uFF0C\u4ED6\u4E24\u9879\u90FD\u81EA\u5E26\u3002"
        english: 
      bodyRight:
