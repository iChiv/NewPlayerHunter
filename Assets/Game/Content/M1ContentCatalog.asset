      bodyLeft:
        chineseSimplified: "\u73B0\u5728\u5C31\u80FD\u8BC4\u5206\u7684\u4E8B\u9879\uFF1A\u6CE8\u518C\u662F\u5426\u5B8C\u6210\u3001\u6587\u4EF6\u662F\u5426\u9F50\u5168\u3001\u4F53\u68C0\u662F\u5426\u771F\u5B9E\u901A\u8FC7\u3001\u7403\u8863\u53F7\u7801\u662F\u5426\u5DF2\u5206\u914D\u4E14\u65E0\u906E\u6321\u7269\u3002\u8FD9\u4E9B\u90FD\u5C5E\u4E8E\u884C\u653F\u5206\uFF0C\u867D\u7136\u65E0\u804A\uFF0C\u4F46\u5386\u53F2\u4E0A\u786E\u6709\u4EA4\u6613\u6B7B\u5728\u4E00\u5F20\u8868\u4E0A\u2014\u2014\u5177\u4F53\u662F\u7B2C\u5341\u4E5D\u5F20\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u73B0\u5728\u4E0D\u80FD\u8BC4\u5206\u7684\uFF1A\u878D\u5165\u3001\u5316\u5B66\u53CD\u5E94\u3001\u72B6\u6001\u66F2\u7EBF\uFF0C\u4EE5\u53CA\u4E00\u5207\u5E26\u201C\u53CC\u8D62\u201D\u5B57\u6837\u7684\u7ED3\u8BBA\u3002\u65B0\u63F4\u7684\u7B2C\u4E00\u6B21\u89E6\u7403\u548C\u7B2C\u4E94\u5341\u6B21\u89E6\u7403\u4E4B\u95F4\u9694\u7740\u6574\u4E2A\u6625\u5929\u3002\u4E09\u6708\u770B\u51FA\u573A\uFF0C\u56DB\u6708\u770B\u8D21\u732E\uFF0C\u4E94\u6708\u770B\u79EF\u5206\u699C\u2014\u2014\u4E00\u6708\u516C\u5E03\u7684\u8BC4\u5206\u53EA\u4EE3\u8868\u5FC3\u60C5\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u51AC\u7A97\u8BC4\u5206\u5728\u4E94\u6708\u516C\u5E03\uFF0C\u4E00\u6708\u516C\u5E03\u7684\u53EB\u5FC3\u60C5\u3002\u201D"
