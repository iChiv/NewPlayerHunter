        chineseSimplified: "\u9B54\u6CD5\u8D1F\u8D23\u8FC7\u4EBA\uFF0C\u8D26\u7C3F\u8D1F\u8D23\u8FDB\u7403\uFF0C\u90FD\u8981\u6838\u9A8C\u3002"
