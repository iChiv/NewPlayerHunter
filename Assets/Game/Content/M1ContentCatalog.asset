      headline:
        chineseSimplified: "\u7EB3\u74E6\u7F57\uFF1A\u88AB\u8EAB\u9AD8\u62D2\u7EDD\uFF0C\u88AB\u843D\u70B9\u6536\u7559"
        english: 
      deck:
        chineseSimplified: "\u68AF\u961F\u5ACC\u4ED6\u77EE\uFF0C\u7B2C\u4E09\u7EA7\u522B\u7684\u51FA\u51FB\u699C\u4E0D\u5ACC\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u53CD\u5E94\u901F\u5EA6\u548C\u8D77\u8DF3\u65F6\u673A\u662F\u4ED6\u7684\u8865\u507F\u673A\u5236\uFF1A\u5BF9\u4F20\u4E2D\u843D\u70B9\u7684\u9884\u5224\u6781\u51C6\uFF0C\u51FA\u51FB\u679C\u65AD\uFF0C\u9AD8\u7A7A\u7403\u5904\u7406\u65B9\u5F0F\u6210\u719F\u2014\u2014\u5148\u5224\u65AD\u62FF\u4E0D\u62FF\u5F97\u5230\uFF0C\u518D\u51B3\u5B9A\u51FA\u4E0D\u51FA\u53BB\u3002\u897F\u73ED\u7259\u7B2C\u4E09\u7EA7\u522B\u51FA\u51FB\u6210\u529F\u7387\u7B2C\u4E00\uFF0C\u516C\u5F00\u6570\u636E\u53EF\u67E5\u3002\u88AB\u653E\u5F03\u7684\u7ECF\u5386\u6CA1\u6709\u7559\u4E0B\u6028\u6C14\uFF0C\u53EA\u7559\u4E0B\u51C6\u5907\u6D3B\u52A8\u6BD4\u522B\u4EBA\u505A\u5F97\u66F4\u65E9\u7684\u4E60\u60EF\u3002\u4EF7\u683C\u5408\u7406\uFF0C\u6001\u5EA6\u514D\u68C0\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8EAB\u9AD8\u5E26\u6765\u7684\u9650\u5236\u771F\u5B9E\u5B58\u5728\uFF1A\u9762\u5BF9\u9AD8\u70B9\u8F70\u70B8\u578B\u4E2D\u950B\uFF0C\u4ED6\u9700\u8981\u9632\u7EBF\u524D\u7F6E\u4FDD\u62A4\uFF1B\u8FDC\u89D2\u540A\u5C04\u7684\u8986\u76D6\u534A\u5F84\u5403\u4E8F\u3002\u7B2C\u4E09\u7EA7\u522B\u5230\u66F4\u9AD8\u7EA7\u522B\u7684\u4F20\u4E2D\u8D28\u91CF\u4E0D\u53EF\u540C\u65E5\u800C\u8BED\uFF0C\u6210\u529F\u7387\u8981\u6253\u8054\u8D5B\u7CFB\u6570\u3002\u53E6\u5916\u6837\u672C\u96C6\u4E2D\u5728\u4E00\u652F\u7403\u961F\u3001\u4E00\u79CD\u6253\u6CD5\uFF0C\u4F53\u7CFB\u8FC1\u79FB\u7684\u9002\u5E94\u6027\u5F85\u9A8C\u8BC1\u3002\u7B7E\u7EA6\u524D\u8BF7\u5B89\u6392\u4E00\u573A\u201C\u9AD8\u7A7A\u7403\u538B\u529B\u6D4B\u8BD5\u201D\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u8EAB\u9AD8\u662F\u4F53\u68C0\u8868\u7ED9\u7684\uFF0C\u51FA\u51FB\u699C\u662F\u4ED6\u81EA\u5DF1\u6323\u7684\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u6298\u6263\u7CFB\u6570"
        english: 
      sidebarBody:
        chineseSimplified: "\u7B2C\u4E09\u7EA7\u522B\u6570\u636E\u6309\u60EF\u4F8B\u6253\u6298\uFF0C\u4F46\u201C\u51FA\u51FB\u6210\u529F\u7387\u7B2C\u4E00\u201D\u6253\u6298\u540E\u4ECD\u662F\u7B2C\u4E00\u3002\u5EFA\u8BAE\u5B9E\u6D4B\uFF1A\u8FDE\u7EED\u4E09\u5929\uFF0C\u53EA\u7EC3\u4F20\u4E2D\u3002"
