      bodyLeft:
        chineseSimplified: "\u51AC\u7A97\u8FDB\u5165\u7B2C\u4E09\u5468\uFF0C\u5E02\u573A\u89C4\u5F8B\u5F00\u59CB\u663E\u5F62\uFF1A\u7B2C\u4E00\u5468\u6700\u8D35\u7684\u662F\u7403\u5458\uFF0C\u7B2C\u4E09\u5468\u6700\u8D35\u7684\u662F\u6545\u4E8B\u3002\u540C\u4E00\u4E2A\u540D\u5B57\uFF0C\u4E24\u5468\u524D\u7684\u5356\u70B9\u662F\u201C\u6218\u672F\u62FC\u56FE\u201D\uFF0C\u73B0\u5728\u53D8\u6210\u4E86\u201C\u4E0D\u80FD\u518D\u9519\u8FC7\u201D\u3002\u4EF7\u683C\u6CA1\u6709\u53D8\uFF0C\u5F62\u5BB9\u8BCD\u5148\u6DA8\u4E86\u4EF7\u3002\u4E70\u65B9\u7684\u5BF9\u7B56\u53EA\u6709\u4E00\u4E2A\uFF1A\u6E05\u5355\u5728\u5F00\u7A97\u524D\u5199\u597D\uFF0C\u6EA2\u4EF7\u5728\u60C5\u7EEA\u91CC\u8BC6\u522B\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u622A\u6B62\u65E5\u524D\u56DB\u5341\u516B\u5C0F\u65F6\uFF0C\u5EFA\u8BAE\u6240\u6709\u4F53\u80B2\u4E3B\u7BA1\u53EA\u63A5\u7535\u8BDD\u3001\u4E0D\u62E8\u7535\u8BDD\uFF0C\u5E76\u628A\u4F20\u771F\u673A\u7EB8\u76D2\u63D0\u524D\u88C5\u6EE1\u2014\u2014\u4E0B\u5468\u4F60\u4EEC\u7528\u5F97\u4E0A\u8FD9\u4E2A\u4F20\u7EDF\uFF0C\u672C\u520A\u5E74\u5EA6\u4FDD\u7559\u8282\u76EE\u201C\u5361\u7EB8\u201D\u6B63\u5728\u9884\u70ED\u3002\u6700\u540E\u63D0\u9192\uFF1A\u6050\u614C\u4E0D\u662F\u5F15\u63F4\u7B56\u7565\uFF0C\u53EA\u662F\u6BD4\u8F83\u8D35\u7684\u5F15\u63F4\u7B56\u7565\u3002\u5356\u65B9\u540C\u7406\uFF1A\u5982\u679C\u4F60\u53EA\u5728\u6700\u540E\u4E00\u5468\u624D\u63A5\u5230\u7535\u8BDD\uFF0C\u8BF7\u53CD\u601D\u524D\u4E09\u4E2A\u661F\u671F\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u622A\u6B62\u65E5\u4E0D\u4E70\u7D27\u8FEB\u611F\uFF0C\u53EA\u4E70\u6E05\u5355\u4E0A\u539F\u6765\u5C31\u6709\u7684\u540D\u5B57\u3002\u201D"
        english: 
