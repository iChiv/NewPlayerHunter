        chineseSimplified: "\u4E00\u5E74\u4EFD\u7684\u6897\uFF0C\u4E00\u6B21\u53D1\u5B8C\uFF0C\u8C22\u7EDD\u50AC\u66F4\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u4ECE\u590F\u5929\u7684\u201C\u56DB\u5341\u4E00\u7403\u201D\u5230\u51AC\u7A97\u7684\u4F20\u771F\u673A\u5361\u7EB8\uFF0C\u8FD9\u4E2A\u8D5B\u5B63\u8BC1\u660E\u4E86\u4E00\u4EF6\u4E8B\uFF1A\u8DB3\u7403\u91CC\u6CA1\u6709\u5B64\u7ACB\u7684\u7B11\u8BDD\uFF0C\u6BCF\u4E2A\u7B11\u8BDD\u90FD\u4F1A\u5728\u67D0\u4E2A\u5468\u4E8C\u665A\u4E0A\u83B7\u5F97\u7EED\u96C6\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4ECA\u665A\u6211\u4EEC\u9881\u53D1\u5341\u4E2A\u5956\u9879\u3002\u8BC4\u59D4\u662F\u5B8C\u6574\u6BD4\u8D5B\u5F55\u50CF\uFF0C\u516C\u8BC1\u5904\u662F\u51FA\u573A\u540D\u5355\uFF0C\u5956\u676F\u7531\u4E00\u53EA\u4FDD\u6E29\u676F\u8D5E\u52A9\u2014\u2014\u5B83\u672C\u8D5B\u5B63\u7B2C\u56DB\u6B21\u5F53\u9009\u201C\u6700\u53EF\u9760\u5728\u573A\u4EBA\u5458\u201D\u3002"
