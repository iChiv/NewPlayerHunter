        english: 
      bodyLeft:
        chineseSimplified: "\u7981\u533A\u5185\u7684\u9884\u5224\u662F\u4ED6\u7684\u5168\u90E8\uFF0C\u4E5F\u662F\u4ED6\u7684\u62A4\u57CE\u6CB3\uFF1A\u4F20\u4E2D\u8FD8\u5728\u7A7A\u4E2D\uFF0C\u4ED6\u5DF2\u7ECF\u5F00\u59CB\u5411\u843D\u70B9\u79FB\u52A8\u3002\u4E24\u811A\u90FD\u80FD\u7EC8\u7ED3\uFF0C\u5C0F\u52A8\u4F5C\u6446\u8131\u5F88\u5B9E\u7528\u3002\u91D1\u9774\u662F\u516C\u5F00\u8BB0\u5F55\u3001\u53EF\u6838\u7684\u786C\u4EA7\u51FA\u3002\u4E03\u5E74\u540C\u4E00\u7EA7\u522B\uFF0C\u7A33\u5B9A\u672C\u8EAB\u5C31\u662F\u4FE1\u606F\uFF1A\u6559\u7EC3\u5E74\u5E74\u6362\u4EBA\uFF0C\u4ED6\u7684\u9996\u53D1\u5E74\u5E74\u4E0D\u6362\u3002\u4EF7\u683C\u9884\u8BA1\u4E0D\u8D35\uFF0C\u6027\u4EF7\u6BD4\u66F2\u7EBF\u6F02\u4EAE\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5E7D\u7075\u7684\u53E6\u4E00\u9762\u5FC5\u987B\u8BF4\u6E05\uFF1A\u6CA1\u6709\u901F\u5EA6\u610F\u5473\u7740\u6CA1\u6709\u7EB5\u6DF1\uFF0C\u9632\u7EBF\u524D\u63D0\u65F6\u4ED6\u7684\u5A01\u80C1\u51CF\u534A\u3002\u4E0D\u53C2\u4E0E\u903C\u62A2\uFF0C\u9632\u5B88\u7EA6\u7B49\u4E8E\u5341\u6253\u5341\u4E00\u3002\u5BF9\u66F4\u9AD8\u5F3A\u5EA6\u8054\u8D5B\u7684\u9002\u5E94\u6027\u5B8C\u5168\u6CA1\u6709\u6837\u672C\u3002\u4ED6\u662F\u4F53\u7CFB\u7684\u5962\u4F88\u54C1\u2014\u2014\u7403\u961F\u5FC5\u987B\u5148\u80FD\u628A\u7403\u7A33\u5B9A\u9001\u8FDB\u7981\u533A\uFF0C\u4ED6\u624D\u5B58\u5728\u3002\u4E70\u4ED6\u4E4B\u524D\uFF0C\u5148\u6570\u6E05\u695A\u81EA\u5DF1\u961F\u91CC\u6709\u51E0\u4E2A\u80FD\u4F20\u4E2D\u7684\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u4E0D\u8FFD\u7403\uFF0C\u4ED6\u53BB\u672A\u6765\u7B49\u7403\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u6838\u67E5\u6E05\u5355"
        english: 
      sidebarBody:
        chineseSimplified: "\u91D1\u9774\uFF1A\u5DF2\u6838\u3002\u6240\u5728\u7EA7\u522B\uFF1A\u7B2C\u56DB\u7EA7\u3002\u66F4\u9AD8\u7EA7\u522B\u6837\u672C\uFF1A\u65E0\u3002\u7ED3\u8BBA\uFF1A\u4EA7\u51FA\u771F\u5B9E\uFF0C\u6210\u8272\u8BF7\u6309\u8054\u8D5B\u7EA7\u522B\u6298\u7B97\u3002"
