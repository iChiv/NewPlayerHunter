    - layout: 2
      kicker:
        chineseSimplified: "\u7403\u63A2\u65B9\u6CD5"
        english: 
      headline:
        chineseSimplified: "\u76F2\u4FA7\u8BC4\u4F30\u8868\uFF1A\u7ED9\u770B\u4E0D\u89C1\u7684\u4E1C\u897F\u6253\u5206"
        english: 
      deck:
        chineseSimplified: "\u65E0\u7403\u4EF7\u503C\u7684\u8BC4\u5206\u6846\u67B6\u4E0E\u5E38\u89C1\u8BEF\u5224\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u53EF\u8BC4\u5206\u9879\uFF1A\u7275\u5236\u9632\u5B88\u4EBA\u6570\u3001\u62C9\u5F00\u5BBD\u5EA6\u7684\u6B21\u6570\u3001\u4E3A\u961F\u53CB\u521B\u9020\u63A5\u7403\u7EBF\u7684\u8DD1\u52A8\u3001\u4E22\u7403\u540E\u7B2C\u4E00\u65F6\u95F4\u7684\u56DE\u4F4D\u8DEF\u7EBF\u3002\u8FD9\u4E9B\u90FD\u4E0D\u8FDB\u96C6\u9526\uFF0C\u4F46\u90FD\u53EF\u4EE5\u8FDB\u62A5\u544A\u2014\u2014\u524D\u63D0\u662F\u8BB0\u5F55\u8005\u613F\u610F\u628A\u89C6\u7EBF\u4ECE\u7403\u4E0A\u79FB\u5F00\uFF0C\u5E76\u4E14\u5750\u5230\u4E00\u4E2A\u770B\u5F97\u89C1\u6574\u6761\u5F31\u4FA7\u7684\u5EA7\u4F4D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u5E38\u89C1\u8BEF\u5224\uFF1A\u628A\u201C\u6CA1\u78B0\u7403\u201D\u5F53\u201C\u6CA1\u53C2\u4E0E\u201D\uFF0C\u628A\u201C\u62C9\u5F00\u201D\u5F53\u201C\u6563\u6B65\u201D\uFF0C\u628A\u955C\u5934\u5916\u7684\u8D21\u732E\u5F53\u6210\u4E0D\u5B58\u5728\u3002\u8BC4\u4F30\u8005\u81EA\u5DF1\u4E5F\u6709\u76F2\u533A\uFF0C\u627F\u8BA4\u8FD9\u4E00\u70B9\u662F\u65B9\u6CD5\u7684\u4E00\u90E8\u5206\u3002\u770B\u4E0D\u61C2\u7684\u65E0\u7403\u8DD1\u52A8\uFF0C\u5148\u522B\u6253\u4F4E\u5206\uFF0C\u5148\u6362\u5EA7\u4F4D\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6700\u597D\u7684\u7275\u5236\uFF0C\u662F\u8BA9\u6570\u636E\u8868\u4E0A\u591A\u51FA\u4E00\u540D\u4E0D\u5B58\u5728\u7684\u961F\u53CB\u3002\u201D"
