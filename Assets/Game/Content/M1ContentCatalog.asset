      bodyLeft:
        chineseSimplified: "\u95E8\u5C06\u7684\u62DB\u8058\u542F\u4E8B\u53D8\u4E86\u3002\u4E00\u652F\u6A59\u8272\u7403\u961F\u7684\u5149\u5934\u6559\u7EC3\u628A\u8BDD\u6311\u660E\uFF1A\u4ED6\u8981\u7684\u4E0D\u662F\u95E8\u7EBF\u4E0A\u7684\u96D5\u50CF\uFF0C\u800C\u662F\u540E\u573A\u7684\u7B2C\u4E00\u4E2A\u7EC4\u7EC7\u8005\u3002\u7528\u811A\u8E22\u7403\uFF0C\u4ECE\u52A0\u5206\u9879\u53D8\u6210\u4E86\u5165\u573A\u5238\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u540C\u4E00\u4EFD\u5468\u62A5\u91CC\uFF0C\u6211\u4EEC\u8FD8\u8BFB\u5230\u4E00\u5C01\u4F24\u611F\u7684\u7B80\u5386\u3002\u66FE\u7ECF\u7528\u5DE6\u811A\u521B\u9020\u65E0\u6570\u5947\u8FF9\u7684\u4E2D\u573A\uFF0C\u79BB\u5F00\u8D5B\u573A\u4E09\u5E74\uFF0C\u60F3\u56DE\u6765\u3002\u6280\u672F\u5F55\u50CF\u8FD8\u5728\uFF0C\u95EE\u9898\u5728\u8EAB\u4F53\u3002"
