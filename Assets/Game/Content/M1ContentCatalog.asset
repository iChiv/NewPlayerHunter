    - layout: 2
      kicker:
        chineseSimplified: "\u7403\u63A2\u62A5\u544A"
        english: 
      headline:
        chineseSimplified: "\u5BCC\u6069\u7279\u65AF\uFF1A\u4E94\u4E2A\u8D5B\u5B63\uFF0C\u5168\u90E8\u4E0A\u53CC"
        english: 
      deck:
        chineseSimplified: "\u6CA1\u6709\u534E\u4E3D\u6280\u672F\u7684\u5C04\u624B\uFF0C\u6709\u6700\u534E\u4E3D\u7684\u4E1C\u897F\uFF1A\u5230\u8D26\u8BB0\u5F55\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u7A33\u5B9A\u6027\u662F\u4ED6\u7B80\u5386\u7684\u9AA8\u67B6\uFF1A\u897F3\u8FC7\u53BB\u4E94\u5B63\uFF0C\u8FDB\u7403\u5168\u90E8\u4E0A\u53CC\uFF0C\u4E0D\u9760\u70B9\u7403\u5806\u780C\uFF0C\u4E0D\u9760\u5355\u5B63\u7206\u53D1\u3002\u5C04\u672F\u624E\u5B9E\uFF0C\u53CC\u811A\u548C\u5934\u7403\u90FD\u6709\u7EC8\u7ED3\u624B\u6BB5\uFF0C\u7981\u533A\u5185\u7B2C\u4E00\u811A\u89E6\u7403\u662F\u4E3A\u5C04\u95E8\u670D\u52A1\u7684\u3002\u65E0\u7403\u65F6\u613F\u610F\u505A\u810F\u6D3B\uFF0C\u538B\u8FEB\u6267\u884C\u4E0D\u542B\u7CCA\u3002\u201C\u730E\u4EBA\u201D\u7684\u7EF0\u53F7\u6765\u81EA\u8DD1\u4F4D\u4E60\u60EF\uFF1A\u4E0D\u663E\u5C71\u9732\u6C34\uFF0C\u4E13\u7B49\u540E\u536B\u7728\u773C\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4E0A\u9650\u95EE\u9898\u5FC5\u987B\u76F4\u8BF4\uFF1A\u4ED6\u4ECE\u672A\u5728\u66F4\u9AD8\u7EA7\u522B\u8BC1\u660E\u8FC7\u81EA\u5DF1\uFF0C\u5355\u5175\u7206\u7834\u80FD\u529B\u4E00\u822C\uFF0C\u9700\u8981\u4F53\u7CFB\u6301\u7EED\u4F9B\u5F39\u3002\u5E74\u9F84\u5DF2\u8FC7\u201C\u57F9\u517B\u201D\u7A97\u53E3\uFF0C\u4E70\u4ED6\u662F\u4E70\u73B0\u5728\uFF0C\u4E0D\u662F\u4E70\u672A\u6765\u3002\u4E94\u5B63\u7A33\u5B9A\u4E5F\u610F\u5473\u7740\u6CA1\u6709\u60CA\u559C\u85CF\u5728\u7B80\u5386\u91CC\u2014\u2014\u6240\u89C1\u5373\u6240\u5F97\u3002\u5BF9\u9884\u7B97\u578B\u9700\u6C42\uFF0C\u8FD9\u53EB\u5BF9\u53E3\uFF1B\u5BF9\u68A6\u60F3\u578B\u4E70\u5BB6\uFF0C\u8FD9\u53EB\u529D\u9000\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u4ED6\u4E0D\u8BB8\u8BFA\u60CA\u559C\uFF0C\u4ED6\u53EA\u91CD\u590D\u5230\u8D26\u3002"
        english: 
      sidebarTitle:
        chineseSimplified: "\u53E3\u5F84\u6838\u5BF9"
        english: 
      sidebarBody:
        chineseSimplified: "\u4E94\u5B63\u4E0A\u53CC\uFF1A\u9010\u5B63\u6838\u5BF9\uFF0C\u5C5E\u5B9E\u3002\u70B9\u7403\u5360\u6BD4\uFF1A\u6B63\u5E38\u533A\u95F4\u3002\u5BF9\u624B\u5F3A\u5EA6\uFF1A\u897F3\u6807\u51C6\u3002\u7ED3\u8BBA\uFF1A\u6570\u5B57\u5E72\u51C0\uFF0C\u6298\u7B97\u540E\u53EF\u4E0B\u5355\u3002"
