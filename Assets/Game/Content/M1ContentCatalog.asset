        chineseSimplified: "\u95E8\u5C06\u53D1\u8A00\u5B66\uFF1A\u53D1\u5E03\u4F1A\u4E0A\u7684\u624B\u5957\u54F2\u5B66"
        english: 
      deck:
        chineseSimplified: "\u8FD9\u4E2A\u4F4D\u7F6E\u7684\u4EBA\u8BF4\u8BDD\uFF0C\u603B\u6BD4\u6251\u6551\u6162\u534A\u62CD\u624D\u7A33\u59A5\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u95E8\u5C06\u7684\u53D1\u5E03\u4F1A\u662F\u8FD9\u4E2A\u4F4D\u7F6E\u7684\u53E6\u4E00\u526F\u624B\u5957\uFF1A\u5C11\u8BF4\u201C\u6211\u201D\uFF0C\u591A\u8BF4\u201C\u6211\u4EEC\u201D\uFF1B\u4E0D\u8BC4\u4EF7\u5BF9\u65B9\u70B9\u7403\u624B\u7684\u5FC3\u7406\u72B6\u6001\uFF1B\u4E0D\u627F\u8BFA\u96F6\u5C01\uFF1B\u4E0D\u5728\u5468\u4E09\u8C08\u8BBA\u547D\u8FD0\u3002\u4E00\u4F4D\u8001\u6559\u7EC3\u7684\u6807\u51C6\u81F3\u4ECA\u6709\u6548\uFF1A\u6700\u597D\u7684\u95E8\u5C06\u91C7\u8BBF\u53EA\u6709\u4E09\u53E5\u2014\u2014\u7403\u6765\u4E86\uFF0C\u6211\u6251\u4E86\uFF0C\u5403\u665A\u996D\u4E86\u3002\u8D85\u8FC7\u4E09\u53E5\u7684\u90E8\u5206\uFF0C\u4E00\u822C\u5F52\u516C\u5173\u90E8\u8D1F\u8D23\u5584\u540E\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u8FD9\u4E2A\u4F4D\u7F6E\u8FD8\u6709\u81EA\u5DF1\u7684\u4F20\u627F\u7ECF\u6D4E\u5B66\uFF1A\u8001\u95E8\u5C06\u5E26\u5C0F\u95E8\u5C06\uFF0C\u5B66\u8D39\u662F\u5931\u8BEF\u5408\u96C6\uFF0C\u6559\u6750\u662F\u819D\u76D6\u548C\u8170\u80CC\u7684\u4F7F\u7528\u8BF4\u660E\u3002\u51B3\u8D5B\u5468\u8BF7\u628A\u8BDD\u7B52\u66F4\u591A\u9012\u7ED9\u6559\u7EC3\u7EC4\uFF0C\u8BA9\u95E8\u5C06\u4FDD\u7559\u5185\u5FC3\u620F\u2014\u2014\u7403\u95E8\u4E03\u7C73\u4E09\u4E8C\u5BBD\uFF0C\u4ED6\u4EEC\u7684\u601D\u7EEA\u6CA1\u6709\u8FB9\u7EBF\uFF0C\u4F46\u81F3\u5C11\u53EF\u4EE5\u6709\u4F11\u8D5B\u671F\u3002\u4F11\u8D5B\u671F\u7684\u7B2C\u4E00\u9879\u89C4\u5B9A\u540C\u6837\u662F\uFF1A\u4E0D\u8C08\u547D\u8FD0\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u6700\u597D\u7684\u95E8\u5C06\u91C7\u8BBF\u53EA\u6709\u4E09\u53E5\uFF1A\u7403\u6765\u4E86\uFF0C\u6211\u6251\u4E86\uFF0C\u5403\u665A\u996D\u4E86\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u53D1\u8A00\u7EA2\u7EBF"
