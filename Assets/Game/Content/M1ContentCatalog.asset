        english: 
      bodyLeft:
        chineseSimplified: "\u51B3\u8D5B\u6837\u672C\u9700\u8981\u52A0\u6743\u91CD\u770B\uFF1A\u6297\u538B\u4E0B\u7684\u7B2C\u4E00\u6B21\u89E6\u7403\u3001\u5931\u8BEF\u540E\u7684\u4E0B\u4E00\u5206\u949F\u3001\u52A0\u65F6\u8D5B\u91CC\u8C01\u8FD8\u5728\u4E3B\u52A8\u8981\u7403\u3002\u8FD9\u4E9B\u65F6\u523B\u628A\u5E73\u65F6\u7684\u6280\u672F\u7EDF\u8BA1\u716E\u5F00\uFF0C\u6D6E\u4E0A\u6765\u7684\u624D\u662F\u80FD\u5E26\u53BB\u4E0B\u4E00\u5B63\u7684\u4E1C\u897F\u3002\u770B\u53F0\u89C2\u5BDF\u540C\u6837\u6709\u6548\uFF1A\u51B3\u8D5B\u91CC\u7684\u65E0\u7403\u8DD1\u52A8\u6BD4\u5E73\u65F6\u8BDA\u5B9E\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u9700\u8981\u51CF\u6743\u91CD\u770B\u7684\uFF1A\u5355\u573A\u82F1\u96C4\u4E3B\u4E49\u7684\u62A5\u4EF7\u51B2\u52A8\u3001\u60C5\u7EEA\u5316\u8D5B\u540E\u91C7\u8BBF\u91CC\u7684\u627F\u8BFA\u3001\u4EE5\u53CA\u201C\u51B3\u8D5B\u7EA7\u7403\u5458\u201D\u6807\u7B7E\u7684\u901A\u8D27\u81A8\u80C0\u3002\u51B3\u8D5B\u8868\u73B0\u53EF\u4EE5\u8FDB\u6863\u6848\uFF0C\u4F46\u4E0D\u8BB8\u72EC\u5360\u6863\u6848\uFF1B\u5956\u676F\u5408\u5F71\u662F\u7EAA\u5FF5\u54C1\uFF0C\u4E0D\u662F\u7EED\u7EA6\u7406\u7531\u3002"
