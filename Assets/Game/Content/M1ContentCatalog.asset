        chineseSimplified: "\u6DD8\u6C70\u8D5B\u7684\u7B2C\u4E00\u8BFE\u53EA\u6709\u4E09\u79D2\uFF1A\u593A\u56DE\u7403\u6743\u540E\u7684\u4E09\u79D2\u91CC\uFF0C\u5411\u524D\u8FD8\u662F\u6A2A\u4F20\uFF0C\u662F\u6574\u573A\u6BD4\u8D5B\u6700\u771F\u5B9E\u7684\u81EA\u6211\u4ECB\u7ECD\u3002\u8054\u8D5B\u53EF\u4EE5\u63A9\u9970\uFF0C\u4E24\u56DE\u5408\u5236\u4F1A\u628A\u7B54\u6848\u590D\u5370\u4E24\u904D\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u672C\u520A\u89C2\u5BDF\u4E86\u5341\u516D\u6B21\u5FEB\u901F\u53CD\u51FB\uFF0C\u6210\u529F\u7684\u90FD\u5177\u5907\u540C\u4E00\u4EF6\u4E8B\uFF1A\u6709\u4EBA\u5728\u4E22\u7403\u524D\u5C31\u5DF2\u7ECF\u5F00\u59CB\u8DD1\u4F4D\u3002\u53CD\u51FB\u4E0D\u662F\u4ECE\u62A2\u4E0B\u7403\u5F00\u59CB\uFF0C\u662F\u4ECE\u9884\u611F\u5F00\u59CB\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u4E09\u79D2\u949F\u4E0D\u591F\u601D\u8003\u4EBA\u751F\uFF0C\u4F46\u8DB3\u591F\u770B\u6E05\u4E00\u652F\u7403\u961F\u3002\u201D"
        english: 
