      sidebarBody:
        chineseSimplified: "\u4E0D\u8BC4\u4EF7\u5BF9\u65B9\u70B9\u7403\u624B\u5FC3\u7406\uFF1B\u4E0D\u627F\u8BFA\u96F6\u5C01\uFF1B\u4E0D\u5728\u5468\u4E09\u8C08\u8BBA\u547D\u8FD0\u3002"
