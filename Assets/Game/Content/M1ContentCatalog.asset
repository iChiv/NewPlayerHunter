        chineseSimplified: "\u7B2C\u4E8C\u95E8\u5C06\u4EF7\u503C\uFF1D\u4E3B\u529B\u7F3A\u9635\u6982\u7387\xD7\u8D5B\u5B63\u6743\u91CD\u3002\u9EC4\u724C\u6210\u672C\uFF1D\u505C\u8D5B\u573A\u6B21\xD7\u5BF9\u624B\u5F3A\u5EA6\u2212\u4FB5\u7565\u6027\u6536\u76CA\u3002\u6EDA\u52A8\u6838\u7B97\u3002"
