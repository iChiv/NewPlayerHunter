        chineseSimplified: "\u7591\u95EE\u540C\u6837\u5177\u4F53\uFF1A\u7EDD\u5BF9\u901F\u5EA6\u4E00\u822C\uFF0C\u88AB\u903C\u62A2\u65F6\u5411\u524D\u7684\u610F\u613F\u9700\u8981\u66F4\u591A\u6837\u672C\uFF1B\u8282\u594F\u578B\u7403\u5458\u6362\u4E00\u4E2A\u8054\u8D5B\uFF0C\u6700\u5148\u4E22\u7684\u5F80\u5F80\u4E0D\u662F\u6280\u672F\u800C\u662F\u719F\u6089\u7684\u62CD\u70B9\u3002\u5EFA\u8BAE\u8BD5\u8BAD\u5B89\u6392\u4E00\u573A\u9AD8\u5F3A\u5EA6\u5BF9\u6297\uFF0C\u4E13\u95E8\u89C2\u5BDF\u4ED6\u88AB\u8D34\u8EAB\u4E4B\u540E\u7684\u7B2C\u4E00\u811A\u3002"
