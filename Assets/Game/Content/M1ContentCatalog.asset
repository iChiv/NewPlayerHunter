      headline:
        chineseSimplified: "\u5C0F\u573A\u5230\u5927\u573A\uFF0C\u9694\u7740\u591A\u5C11\u7C73"
        english: 
      deck:
        chineseSimplified: "\u4E94\u4EBA\u5236\u51FA\u54C1\u7684\u7403\u5458\u8D8A\u6765\u8D8A\u591A\uFF0C\u8F6C\u4F1A\u5E02\u573A\u9700\u8981\u4E00\u5F20\u6362\u7B97\u8868\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u4E94\u4EBA\u5236\u662F\u6280\u672F\u7684\u9AD8\u538B\u9505\uFF1A\u573A\u5730\u5C0F\u3001\u8282\u594F\u5FEB\u3001\u89E6\u7403\u6B21\u6570\u591A\uFF0C\u4ECE\u90A3\u91CC\u51FA\u6765\u7684\u7403\u5458\uFF0C\u811A\u4E0B\u9891\u7387\u548C\u5C0F\u7A7A\u95F4\u5904\u7406\u662F\u7CFB\u7EDF\u81EA\u5E26\u7684\u3002\u4F46\u6362\u7B97\u4ECE\u6765\u4E0D\u662F\u514D\u8D39\u7684\uFF1A\u5341\u4E00\u4EBA\u5236\u610F\u5473\u7740\u66F4\u957F\u7684\u51B2\u523A\u8DDD\u79BB\u3001\u66F4\u5C11\u7684\u89E6\u7403\u673A\u4F1A\u3001\u66F4\u9AD8\u7684\u4F53\u80FD\u95E8\u69DB\u3002\u201C\u6280\u672F\u7EC6\u817B\u201D\u5728\u5C0F\u573A\u662F\u5929\u8D4B\uFF0C\u5728\u5927\u573A\u53EA\u662F\u5165\u573A\u5238\u3002\u8BC4\u4F30\u4E94\u4EBA\u5236\u7403\u5458\uFF0C\u672C\u520A\u7684\u6E05\u5355\u6709\u4E09\u884C\uFF1A\u65E0\u7403\u65F6\u5E72\u4EC0\u4E48\uFF1F\u88AB\u8EAB\u4F53\u78BE\u538B\u65F6\u600E\u4E48\u529E\uFF1F\u4E03\u5341\u5206\u949F\u540E\u8FD8\u5269\u4EC0\u4E48\uFF1F\u4E09\u4E2A\u95EE\u9898\u90FD\u7B54\u5F97\u4E0A\uFF0C\u9B54\u6CD5\u624D\u503C\u94B1\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u4F4E\u6210\u672C\u5C04\u624B\u662F\u53E6\u4E00\u79CD\u6362\u7B97\u9898\uFF1A\u8FDE\u7EED\u4E94\u4E2A\u8D5B\u5B63\u8FDB\u7403\u4E0A\u53CC\uFF0C\u8FD9\u79CD\u7A33\u5B9A\u6027\u6BD4\u4EFB\u4F55\u5355\u5B63\u7206\u53D1\u90FD\u7A00\u6709\u3002\u95EE\u9898\u540C\u6837\u6765\u81EA\u7EA7\u522B\u2014\u2014\u897F3\u7684\u540E\u536B\u4E0E\u66F4\u9AD8\u7EA7\u522B\u7684\u540E\u536B\uFF0C\u9632\u5B88\u7684\u63D0\u524D\u91CF\u5B8C\u5168\u4E0D\u540C\u3002\u201C\u7A33\u5B9A\u201D\u80FD\u4E0D\u80FD\u8DE8\u7EA7\u522B\u8FC1\u79FB\uFF0C\u5386\u53F2\u7B54\u6848\u662F\uFF1A\u4E00\u90E8\u5206\u80FD\uFF0C\u770B\u7C7B\u578B\u3002\u9760\u901F\u5EA6\u7684\u96BE\u8FC1\u79FB\uFF0C\u9760\u9884\u5224\u548C\u5C04\u672F\u7684\u8FC1\u79FB\u7387\u9AD8\u5F97\u591A\u3002\u5BCC\u6069\u7279\u65AF\u5C5E\u4E8E\u540E\u4E00\u7C7B\uFF0C\u8FD9\u662F\u4ED6\u7684\u597D\u6D88\u606F\u3002\u574F\u6D88\u606F\u662F\uFF1A\u68C0\u9A8C\u8FC1\u79FB\u7387\u7684\u552F\u4E00\u65B9\u6CD5\uFF0C\u8FD8\u662F\u4E70\u56DE\u53BB\u8E22\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u7EA7\u522B\u4E4B\u95F4\u7684\u6C47\u7387\uFF0C\u53EA\u6709\u4E0A\u573A\u624D\u7ED3\u7B97\u3002"
