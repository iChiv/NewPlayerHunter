        chineseSimplified: "\u4ECE\u4FDD\u6E29\u676F\u5230\u5766\u514B\uFF1A\u6211\u4EEC\u5BF9\u201C\u80FD\u8DD1\u201D\u8FD9\u4E2A\u8BCD\u505A\u4E86\u4E00\u6B21\u5168\u9762\u4F53\u68C0\u3002"
        english: 
      bodyLeft:
        chineseSimplified: "\u672C\u520A\u6863\u6848\u67DC\u91CC\uFF0C\u4F53\u80FD\u795E\u8BDD\u5206\u4E09\u4E2A\u7B49\u7EA7\u3002\u5165\u95E8\u7EA7\u7684\u4EE3\u8868\u662F\u8001\u5C06\u7EF4\u514B\u548C\u4ED6\u7684\u4FDD\u6E29\u676F\u2014\u2014\u5F53\u5E74\u6240\u6709\u4EBA\u7B11\u4ED6\u676F\u91CC\u6CE1\u67B8\u675E\uFF0C\u540E\u6765\u4ED6\u7B11\u5230\u4E86\u5168\u52E4\u5956\u7684\u9886\u5956\u53F0\u4E0A\u3002\u4E2D\u7EA7\u795E\u8BDD\u9760\u6570\u636E\u8BF4\u8BDD\uFF1A\u8DD1\u52A8\u8DDD\u79BB\u3001\u51B2\u523A\u6B21\u6570\u3001\u9AD8\u5F3A\u5EA6\u8DD1\u5360\u6BD4\uFF0C\u4E09\u6837\u9F50\u5168\u624D\u7B97\u6570\u3002\u9AD8\u7EA7\u795E\u8BDD\u9760\u8BC1\u4EBA\uFF1A\u201C\u4ED6\u4E00\u542F\u52A8\u6211\u4EEC\u5168\u8BA9\u8DEF\u201D\uFF0C\u542C\u7740\u552C\u4EBA\uFF0C\u4F46\u672C\u520A\u63D0\u9192\uFF0C\u8BA9\u8DEF\u4E5F\u53EF\u80FD\u662F\u793C\u8BA9\u3002\u4F53\u80FD\u662F\u8DB3\u7403\u91CC\u6700\u4E0D\u5BB9\u6613\u9020\u5047\u7684\u6307\u6807\uFF0C\u56E0\u4E3A\u5B83\u6BCF\u573A\u90FD\u5728\u88AB\u5F53\u573A\u590D\u6D4B\u3002"
        english: 
