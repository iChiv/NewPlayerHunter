        english: 
      bodyLeft:
        chineseSimplified: "\u6BCF\u5E74\u4E00\u6708\uFF0C\u81EA\u7531\u7403\u5458\u540D\u5355\u90FD\u4F1A\u53D8\u539A\u3002\u6709\u4EBA\u56E0\u4E3A\u5E74\u9F84\uFF0C\u6709\u4EBA\u56E0\u4E3A\u4F53\u7CFB\uFF0C\u8FD8\u6709\u4EBA\u56E0\u4E3A\u65B0\u6559\u7EC3\u559C\u6B22\u53E6\u4E00\u79CD\u8DB3\u7403\u3002\u540D\u5355\u672C\u8EAB\u4E0D\u56DE\u7B54\u95EE\u9898\uFF0C\u5B83\u53EA\u662F\u95EE\u9898\u7684\u76EE\u5F55\u3002"
        english: 
      bodyRight:
        chineseSimplified: "\u6DD8\u91D1\u8005\u7684\u539F\u5219\u662F\u628A\u201C\u88AB\u653E\u5F03\u201D\u62C6\u6210\u4E09\u79CD\uFF1A\u80FD\u529B\u3001\u4F24\u75C5\u3001\u4E0D\u5339\u914D\u3002\u53EA\u6709\u524D\u4E24\u79CD\u4F1A\u5199\u8FDB\u7403\u63A2\u62A5\u544A\uFF0C\u7B2C\u4E09\u79CD\u5E38\u5E38\u5199\u7740\u5199\u7740\u5C31\u6210\u4E86\u6361\u6F0F\u3002"
        english: 
      pullQuote:
        chineseSimplified: "\u201C\u522B\u4EBA\u653E\u5F03\u7684\u539F\u56E0\uFF0C\u51B3\u5B9A\u4F60\u6361\u5230\u7684\u4EF7\u683C\u3002\u201D"
        english: 
      sidebarTitle:
        chineseSimplified: "\u6DD8\u91D1\u4E09\u95EE"
        english: 
      sidebarBody:
        chineseSimplified: "\u4E3A\u4EC0\u4E48\u8D70\uFF1F\u8C01\u7684\u5224\u65AD\uFF1F\u6709\u6CA1\u6709\u7B2C\u4E8C\u5BB6\u4FF1\u4E50\u90E8\u72AF\u4E86\u540C\u6837\u7684\u9519\uFF1F"
